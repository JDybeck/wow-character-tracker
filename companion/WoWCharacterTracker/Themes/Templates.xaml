<!-- Templates and styles shared by the window's pages: coins, icon chips, list rows, tabs, column widths. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml"/>
    <ResourceDictionary Source="Converters.xaml"/>
    <ResourceDictionary Source="Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- A coin: a small colored dot (gold, silver, copper) after the amount, like the game. -->
  <DataTemplate x:Key="CoinTemplate" DataType="{x:Type vm:Coin}">
    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
      <TextBlock Text="{Binding Amount}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
      <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="3,1,0,0" VerticalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="Row">
    <StackPanel Orientation="Horizontal"/>
  </ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="Wrap">
    <WrapPanel/>
  </ItemsPanelTemplate>
  <!-- An icon with text (crest + count, profession + skill), tooltip from Wowhead. -->
  <DataTemplate x:Key="IconChipTemplate" DataType="{x:Type vm:IconChip}">
    <Border Background="#4D1E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="5" Padding="3,2,8,2" Margin="0,0,6,6"
            ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
      <StackPanel Orientation="Horizontal">
        <Image Source="{Binding IconUrl}" Width="18" Height="18" Margin="0,0,6,0" Visibility="{Binding IconUrl, Converter={StaticResource VisibleIfSet}}"/>
        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </DataTemplate>
  <!-- An item slot (bags, bank, gear, the Items page): the icon in a border of its quality color,
       the stack size in the corner, Wowhead's tooltip on hover. Empty slots are a dim square. -->
  <DataTemplate x:Key="ItemCellTemplate" DataType="{x:Type vm:ItemCell}">
    <Border x:Name="Slot" Width="34" Height="34" Margin="0,0,3,3" CornerRadius="4" BorderThickness="1"
            Background="#33000000" BorderBrush="#26FFFFFF"
            ToolTip="{Binding Item.Tooltip}" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="60000">
      <Grid>
        <Image Source="{Binding Item.IconUrl}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Clip>
            <RectangleGeometry Rect="0,0,30,30" RadiusX="3" RadiusY="3"/>
          </Image.Clip>
        </Image>
        <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1"
                   FontSize="11" FontWeight="Bold" Foreground="White">
          <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1" Color="Black"/>
          </TextBlock.Effect>
        </TextBlock>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsEmpty}" Value="False">
        <Setter TargetName="Slot" Property="BorderBrush" Value="{Binding Item.Brush}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Tabs inside the character details: Overview, Gear and bags, Leveling. -->
  <Style x:Key="DetailTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,8,2,6" Margin="0,0,20,0">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same column widths for the header row and every character row. -->
  <GridLength x:Key="ColClass">130</GridLength>
  <GridLength x:Key="ColLevel">70</GridLength>
  <GridLength x:Key="ColIlvl">80</GridLength>
  <GridLength x:Key="ColGold">95</GridLength>
  <GridLength x:Key="ColSeen">85</GridLength>

  <Style x:Key="CharacterItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Game version tabs (Retail / Forever) as pills in the header. -->
  <Style x:Key="FlavorTab" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="10,2,16,2" CornerRadius="7" Margin="3" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <!-- The game's logo (loaded at runtime), dimmed until the tab is picked. -->
              <Image x:Name="Logo" Source="{Binding Logo}" Height="40" Margin="0,0,8,0" Opacity="0.55"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}"/>
              <TextBlock x:Name="Txt" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="Logo" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blue}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="White"/>
              <Setter TargetName="Logo" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Realm / ruleset filter chips. -->
  <Style x:Key="GroupChipItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="10,3" CornerRadius="12" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#334155" Background="Transparent">
            <TextBlock x:Name="Txt" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BlueTextBright}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Page tabs (Characters / What gets posted) with an underline. -->
  <Style x:Key="PageTab" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8" Margin="0,0,22,0">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="active">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FactLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,10,0,2"/>
  </Style>
  <Style x:Key="FactValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Width" Value="56"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    <Setter Property="Margin" Value="6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- What gets posted: a small number box in the settings grids, lined up in one column. -->
  <Style x:Key="GridNumberBox" TargetType="TextBox" BasedOn="{StaticResource NumberBox}">
    <Setter Property="Width" Value="52"/>
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="Margin" Value="0,3,8,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- A small button shaped like the screenshot chips ("Test", "Test max level"). -->
  <Style x:Key="ChipButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Post a sample of this to Discord now"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="12" Padding="10,3" Margin="0,0,6,6" BorderThickness="1" BorderBrush="#334155" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Ico" Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ContentPresenter x:Name="Txt" TextElement.Foreground="#94A3B8" TextElement.FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter TargetName="Txt" Property="TextElement.Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One option on the What gets posted page: spacing between options. -->
  <Style x:Key="PostOption" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,20"/>
  </Style>
</ResourceDictionary>
