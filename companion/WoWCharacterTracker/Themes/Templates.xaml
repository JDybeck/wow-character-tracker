<!-- Templates and styles shared by the window's pages: coins, icon chips, list rows, tabs, column widths. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml"/>
    <ResourceDictionary Source="Converters.xaml"/>
    <ResourceDictionary Source="Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- A coin: a small colored dot (gold, silver, copper) after the amount, like the game. -->
  <DataTemplate x:Key="CoinTemplate" DataType="{x:Type vm:Coin}">
    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
      <TextBlock Text="{Binding Amount}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
      <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="3,1,0,0" VerticalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="Row">
    <StackPanel Orientation="Horizontal"/>
  </ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="Wrap">
    <WrapPanel/>
  </ItemsPanelTemplate>

  <!-- A gold bag (total gold): a stylized burlap sack, open with coins showing, tied with a rope whose
       ends hang down, and a coin next to it. Drawn in a 32x32 box. -->
  <LinearGradientBrush x:Key="CoinGold" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FEF3C7" Offset="0"/>
    <GradientStop Color="#FBBF24" Offset="0.45"/>
    <GradientStop Color="#B45309" Offset="1"/>
  </LinearGradientBrush>
  <DrawingImage x:Key="GoldBag">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- sack body -->
        <GeometryDrawing Geometry="M8.5,14.5 C5.2,19 4.8,26.5 9,29.2 C12.5,31.2 19.5,31.2 23,29.2 C27.2,26.5 26.8,19 23.5,14.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#D9B37C" Offset="0"/>
              <GradientStop Color="#A97A45" Offset="0.55"/>
              <GradientStop Color="#6E4724" Offset="1"/>
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Brush="#3F2611" Thickness="0.9"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- burlap seams -->
        <GeometryDrawing Geometry="M9.5,21 C13,22.3 19,22.3 22.5,21 M10.5,26 C14,27.2 18,27.2 21.5,26">
          <GeometryDrawing.Pen><Pen Brush="#33000000" Thickness="0.7"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- gathered neck -->
        <GeometryDrawing Brush="#B98B54" Geometry="M10.3,9.6 C11.4,12 11.4,13.2 9.8,15 L22.2,15 C20.6,13.2 20.6,12 21.7,9.6 Z">
          <GeometryDrawing.Pen><Pen Brush="#3F2611" Thickness="0.8"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M13,10.5 L13.4,14.6 M16,10.5 L16,14.8 M19,10.5 L18.6,14.6">
          <GeometryDrawing.Pen><Pen Brush="#40000000" Thickness="0.6"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- folded rim and the dark opening -->
        <GeometryDrawing Brush="#DDBB86" Geometry="M5.6,7.6 C5.6,5.2 26.4,5.2 26.4,7.6 C26.4,11 5.6,11 5.6,7.6 Z">
          <GeometryDrawing.Pen><Pen Brush="#3F2611" Thickness="0.9"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#3B2410">
          <GeometryDrawing.Geometry><EllipseGeometry Center="16,7.5" RadiusX="8.6" RadiusY="1.9"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <!-- coins poking out -->
        <GeometryDrawing Brush="{StaticResource CoinGold}">
          <GeometryDrawing.Geometry><EllipseGeometry Center="11.8,6.4" RadiusX="2.5" RadiusY="2.1"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#92400E" Thickness="0.6"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource CoinGold}">
          <GeometryDrawing.Geometry><EllipseGeometry Center="20.2,6.4" RadiusX="2.5" RadiusY="2.1"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#92400E" Thickness="0.6"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource CoinGold}">
          <GeometryDrawing.Geometry><EllipseGeometry Center="16,5.5" RadiusX="2.8" RadiusY="2.3"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#92400E" Thickness="0.6"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- rope around the neck, knot and hanging ends -->
        <GeometryDrawing Geometry="M9.6,14.4 C13,16.1 19,16.1 22.4,14.4 M16,16 C15.3,18.6 14.6,20.6 13.9,23 M16,16 C16.8,18.8 17.6,21 18.3,23.6">
          <GeometryDrawing.Pen><Pen Brush="#5A2E12" Thickness="1.4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#5A2E12">
          <GeometryDrawing.Geometry><EllipseGeometry Center="16,15.8" RadiusX="1.3" RadiusY="1.1"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#7C4A22" Geometry="M13.1,22.6 L14.7,22.6 L14.3,25 L13.5,25 Z M17.5,23.2 L19.1,23.2 L18.7,25.6 L17.9,25.6 Z"/>
        <!-- a coin beside the sack -->
        <GeometryDrawing Brush="{StaticResource CoinGold}">
          <GeometryDrawing.Geometry><EllipseGeometry Center="27,28.6" RadiusX="2.7" RadiusY="1.6"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#92400E" Thickness="0.6"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- shine on the sack -->
        <GeometryDrawing Brush="#40FFFFFF" Geometry="M9,19 C8.6,22 9,25 10.4,27 C9.6,24.4 9.6,21.6 10.6,18.6 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- An icon with text (crest + count, profession + skill). Crests and talents show Wowhead's tooltip
       like items do (ui:ItemTip), the others their plain tooltip text. -->
  <DataTemplate x:Key="IconChipTemplate" DataType="{x:Type vm:IconChip}">
    <Border Background="#4D1E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="5" Padding="3,2,8,2" Margin="0,0,6,6"
            ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150" ui:ItemTip.Info="{Binding Info}">
      <StackPanel Orientation="Horizontal">
        <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="18" Height="18" Margin="0,0,6,0" Visibility="{Binding IconUrl, Converter={StaticResource VisibleIfSet}}"/>
        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </DataTemplate>
  <!-- An item slot (bags, bank, gear): the icon in a border of its quality color, the stack size in
       the corner, Wowhead's tooltip on hover and its page on click (ui:ItemTip). Empty slots are a dim square. -->
  <DataTemplate x:Key="ItemCellTemplate" DataType="{x:Type vm:ItemCell}">
    <Border x:Name="Slot" Width="34" Height="34" Margin="0,0,3,3" CornerRadius="4" BorderThickness="1"
            Background="#33000000" BorderBrush="#26FFFFFF" ui:ItemTip.Info="{Binding Item}">
      <Grid>
        <Image Source="{Binding Item.IconUrl, Converter={StaticResource WebImage}}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Clip>
            <RectangleGeometry Rect="0,0,30,30" RadiusX="3" RadiusY="3"/>
          </Image.Clip>
        </Image>
        <!-- The stack size, white over a black copy of itself a pixel down and right (a shadow effect
             per slot was costly to draw with hundreds of slots). Collapsed without a stack. -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" Visibility="{Binding CountText, Converter={StaticResource VisibleIfSet}}">
          <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold" Foreground="Black" Margin="1,1,0,0"/>
          <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,1,1"/>
        </Grid>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsEmpty}" Value="False">
        <Setter TargetName="Slot" Property="BorderBrush" Value="{Binding Item.Brush}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Tabs inside the character details: Overview, Gear and bags, Leveling. -->
  <Style x:Key="DetailTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <!-- Same look as the page tabs, a size smaller. -->
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="7" Padding="12,5" Margin="0,8,6,8">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IndigoLineSoft}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IndigoSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IndigoLine}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same column widths for the header row and every character row. -->
  <GridLength x:Key="ColClass">130</GridLength>
  <GridLength x:Key="ColLevel">70</GridLength>
  <GridLength x:Key="ColIlvl">80</GridLength>
  <GridLength x:Key="ColGold">95</GridLength>
  <GridLength x:Key="ColSeen">85</GridLength>

  <Style x:Key="CharacterItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <!-- Each character in its own frame: an accent edge (stronger on hover and when open) over
               a soft shade of the card colors. The inner border is the hover/open tint. -->
          <Border x:Name="Frame" Margin="10,4" CornerRadius="9" BorderThickness="1" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource Frame}">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter/>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FrameStrong}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FrameStrong}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Game version tabs (Retail / Forever) as pills in the header. -->
  <Style x:Key="FlavorTab" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="10,2,16,2" CornerRadius="7" Margin="3" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <!-- The game's logo (loaded at runtime), dimmed until the tab is picked. -->
              <Image x:Name="Logo" Source="{Binding Logo}" Height="40" Margin="0,0,8,0" Opacity="0.55"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}"/>
              <TextBlock x:Name="Txt" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="Logo" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blue}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="White"/>
              <Setter TargetName="Logo" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Realm / ruleset filter chips (Views/ChipBar), item kinds. The margin spaces wrapped rows too. -->
  <Style x:Key="GroupChipItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="10,3" CornerRadius="12" Margin="0,2,6,2" BorderThickness="1" BorderBrush="#334155" Background="Transparent">
            <TextBlock x:Name="Txt" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BlueTextBright}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A place chip on the Items page (PlaceChip): plain, "only" (filled, a check), or "out" (red,
       crossed out, an X) so it's clear whether a place is focused on or left out. -->
  <Style x:Key="PlaceChipButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Padding="10,3" CornerRadius="12" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#334155" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Ico" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" FontSize="9" Margin="0,0,6,0" Visibility="Collapsed"/>
              <TextBlock x:Name="Txt" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsOnly}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BlueTextBright}"/>
              <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
              <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource BlueTextBright}"/>
              <Setter TargetName="Ico" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOut}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#33EF4444"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#B91C1C"/>
              <Setter TargetName="Txt" Property="Foreground" Value="#FCA5A5"/>
              <Setter TargetName="Txt" Property="TextDecorations" Value="Strikethrough"/>
              <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
              <Setter TargetName="Ico" Property="Foreground" Value="#FCA5A5"/>
              <Setter TargetName="Ico" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Page tabs (Characters / What gets posted) with an underline. -->
  <Style x:Key="PageTab" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <!-- A box with the page's icon and name; the open page (Tag "active") is filled in the tab's theme. -->
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="9" Padding="14,8" Margin="0,0,8,0">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="13.5" TextElement.FontWeight="SemiBold"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IndigoLineSoft}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="active">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IndigoSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IndigoLine}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FactLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,10,0,2"/>
  </Style>
  <Style x:Key="FactValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Width" Value="56"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    <Setter Property="Margin" Value="6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- What gets posted: a small number box in the settings grids, lined up in one column. -->
  <Style x:Key="GridNumberBox" TargetType="TextBox" BasedOn="{StaticResource NumberBox}">
    <Setter Property="Width" Value="52"/>
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="Margin" Value="0,3,8,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- A small button shaped like the screenshot chips ("Test", "Test max level"). -->
  <Style x:Key="ChipButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Post a sample of this to Discord now"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="12" Padding="10,3" Margin="0,0,6,6" BorderThickness="1" BorderBrush="#334155" Background="Transparent">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Ico" Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ContentPresenter x:Name="Txt" TextElement.Foreground="#94A3B8" TextElement.FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
              <Setter TargetName="Txt" Property="TextElement.Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One option on the What gets posted page: spacing between options. -->
  <Style x:Key="PostOption" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,20"/>
  </Style>
</ResourceDictionary>
