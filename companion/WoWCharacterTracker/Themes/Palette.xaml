<!-- Colors and fonts. Theme.cs recolors the themed brushes per game tab, so use those with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">

  <!-- Palette (slate dark, like the mockup) -->
  <SolidColorBrush x:Key="Bg" Color="#020617"/>
  <SolidColorBrush x:Key="Card" Color="#0A1121"/>
  <SolidColorBrush x:Key="CardHeader" Color="#0F172A"/>
  <SolidColorBrush x:Key="Line" Color="#1E293B"/>
  <SolidColorBrush x:Key="LineSoft" Color="#801E293B"/>
  <SolidColorBrush x:Key="Hover" Color="#4D1E293B"/>
  <SolidColorBrush x:Key="Selected" Color="#991E293B"/>
  <SolidColorBrush x:Key="Text" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="TextSoft" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
  <SolidColorBrush x:Key="Dim" Color="#64748B"/>
  <SolidColorBrush x:Key="Faint" Color="#475569"/>
  <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
  <SolidColorBrush x:Key="BlueHover" Color="#3B82F6"/>
  <SolidColorBrush x:Key="Indigo" Color="#818CF8"/>
  <SolidColorBrush x:Key="IndigoSoft" Color="#331E1B4B"/>
  <SolidColorBrush x:Key="IndigoLine" Color="#806366F1"/>
  <SolidColorBrush x:Key="Green" Color="#4ADE80"/>
  <SolidColorBrush x:Key="GreenSoft" Color="#2622C55E"/>
  <SolidColorBrush x:Key="Amber" Color="#FBBF24"/>
  <SolidColorBrush x:Key="AmberSoft" Color="#26F59E0B"/>
  <SolidColorBrush x:Key="Red" Color="#F87171"/>
  <SolidColorBrush x:Key="InfoText" Color="#60A5FA"/>
  <!-- Accent shades. Theme.cs recolors these (and the backgrounds above) per game tab. -->
  <SolidColorBrush x:Key="BlueSoft" Color="#332563EB"/>
  <SolidColorBrush x:Key="BlueLine" Color="#803B82F6"/>
  <SolidColorBrush x:Key="BlueText" Color="#93C5FD"/>
  <SolidColorBrush x:Key="BlueTextBright" Color="#DBEAFE"/>
  <SolidColorBrush x:Key="IndigoStrong" Color="#4F46E5"/>
  <SolidColorBrush x:Key="IndigoMid" Color="#6366F1"/>
  <SolidColorBrush x:Key="IndigoChip" Color="#336366F1"/>
  <SolidColorBrush x:Key="IndigoText" Color="#A5B4FC"/>
  <SolidColorBrush x:Key="IndigoTextBright" Color="#E0E7FF"/>
  <SolidColorBrush x:Key="IndigoPanel" Color="#33312E81"/>
  <SolidColorBrush x:Key="IndigoLineSoft" Color="#4D6366F1"/>
  <!-- Character row frames (Theme.cs sets these from the tab's accent). -->
  <SolidColorBrush x:Key="Frame" Color="#592563EB"/>
  <SolidColorBrush x:Key="FrameStrong" Color="#B33B82F6"/>
  <SolidColorBrush x:Key="RowBg" Color="#0F172A"/>

  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
