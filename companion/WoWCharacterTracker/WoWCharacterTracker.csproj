<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WoWCharacterTracker</AssemblyName>
    <RootNamespace>WoWCharacterTracker</RootNamespace>
    <Version>0.3.0</Version>
    <!-- dotnet publish -c Release gives one WoWCharacterTracker.exe that runs without .NET installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <!-- WPF projects leave these out of the implicit usings. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <!-- The addon ships inside the exe so the companion can install and update it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\addon\WoWCharacterTracker\*.*" LogicalName="Addon/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
