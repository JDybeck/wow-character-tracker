<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The app is English only; without this the exe carries WPF's translations for 13 languages (~17 MB). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WoWCharacterTracker</AssemblyName>
    <RootNamespace>WoWCharacterTracker</RootNamespace>
    <Version>0.26.1</Version>
    <!-- dotnet publish -c Release gives one WoWCharacterTracker.exe that runs without .NET installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <!-- The app's classes are internal; the tests (companion/WoWCharacterTracker.Tests) may see them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WoWCharacterTracker.Tests" />
  </ItemGroup>

  <!-- WPF projects leave these out of the implicit usings. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <!-- The logo: the wordmark in the header, the framed icon for the window/taskbar. logo.png (square)
       stays in the repo for Discord's sender picture (DiscordWebhook.LogoUrl), it isn't built in. -->
  <ItemGroup>
    <Resource Include="Assets\wordmark.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- The stream overlay page (Services/Streaming/OverlayServer serves it). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\overlay.html" LogicalName="Stream/overlay.html" />
    <EmbeddedResource Include="Assets\enchant-spells.json" LogicalName="Data/enchant-spells.json" />
  </ItemGroup>

  <!-- Runtime parts the app never loads, left out of the published exe (~7 MB). Trimming isn't
       supported for WPF, so this is a fixed list: debugger and dump helpers, other GCs, features
       we don't use (VB, DataSet, LDAP, mail, HTTP/3, PLINQ, Dataflow, tar) and the XP themes plus
       Fluent (Windows 10/11 use Aero2; Aero, AeroLite and Classic stay for older or high contrast
       setups). Ribbon looks unused but WPF loads it at startup: without it the window never shows.
       A missing one only fails when its code is reached, so render every page (screenshot mode)
       after a .NET upgrade. -->
  <PropertyGroup>
    <UnusedRuntimeFiles>;Microsoft.DiaSymReader.Native.amd64.dll;mscordaccore.dll;mscordbi.dll;createdump.exe;clrgc.dll;clrgcexp.dll;Microsoft.VisualBasic.Core.dll;System.Data.Common.dll;PresentationFramework-SystemData.dll;System.Transactions.Local.dll;System.DirectoryServices.dll;System.Diagnostics.PerformanceCounter.dll;System.Net.Mail.dll;msquic.dll;System.Linq.Parallel.dll;System.Threading.Tasks.Dataflow.dll;System.Formats.Tar.dll;PresentationFramework.Luna.dll;PresentationFramework.Royale.dll;PresentationFramework.Fluent.dll;</UnusedRuntimeFiles>
  </PropertyGroup>
  <Target Name="LeaveOutUnusedRuntime" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$(UnusedRuntimeFiles.Contains(';%(Filename)%(Extension);')) or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore_'))" />
    </ItemGroup>
  </Target>

  <!-- The addon ships inside the exe so the companion can install and update it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\addon\WoWCharacterTracker\*.*" LogicalName="Addon/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
