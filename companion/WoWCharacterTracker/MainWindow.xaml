<Window x:Class="WoWCharacterTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure"
        Title="Character Tracker" Icon="Assets/app.ico" Width="1320" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        xmlns:views="clr-namespace:WoWCharacterTracker.Views">

  <Grid x:Name="Page" Margin="28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <views:Header/>
    <!-- The setup checks sit where Settings says (Config.SetupPlacement): here, under the window
         (last row) or in the right column above Discord (the default). -->
    <Border Grid.Row="1" Visibility="{Binding SetupTop, Converter={StaticResource Visible}}">
      <views:SetupBar Wide="True" Margin="0,0,0,14" Visibility="{Binding SelectedFlavor.IsOn, Converter={StaticResource Visible}}"/>
    </Border>
    <Border Grid.Row="3" Visibility="{Binding SetupBottom, Converter={StaticResource Visible}}">
      <views:SetupBar Wide="True" Margin="0,14,0,0" Visibility="{Binding SelectedFlavor.IsOn, Converter={StaticResource Visible}}"/>
    </Border>

    <!-- Main area: the page tabs on top (left), then the page and the right column side by side,
         so their top edges line up. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*" MinWidth="300"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="2,0,0,10">
        <!-- The pages, as boxed tabs: icon and name, the open one filled. -->
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=characters}"
                  Command="{Binding ShowPageCommand}" CommandParameter="characters">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Characters"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=items}"
                  Command="{Binding ShowPageCommand}" CommandParameter="items">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Items"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=posting}"
                  Command="{Binding ShowPageCommand}" CommandParameter="posting">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="What gets posted"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=ingame}"
                  Command="{Binding ShowPageCommand}" CommandParameter="ingame">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="In game"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- No game folder or no addon: the app can't track anything yet, so that check sits big over the
           pages, wherever the setup checks are placed. -->
      <views:SetupCard Grid.Row="1"/>

      <!-- Characters and Items, once per game tab (their DataContext is the tab): the hidden tab's
           pages stay built, so switching tabs only swaps which one shows. -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding FlavorTabs}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource Visible}}"/>
            <!-- slides in from the side of its tab (Retail left, Forever right) -->
            <Setter Property="ui:Motion.SlideIndex" Value="{Binding Order}"/>
            <Setter Property="ui:Motion.SlideGroup" Value="game"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:FlavorViewModel}">
            <Grid>
              <views:CharactersPage/>
              <views:ItemsPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="1" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=items}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:PostingPage Grid.Row="2"/>
      <views:InGamePage Grid.Row="2"/>
      <views:UninstallPage Grid.Row="2"/>
      <!-- A turned-off game: covers the page tabs and pages (opaque card) with a way back on. -->
      <views:GameOffPage Grid.Row="0" Grid.RowSpan="3"/>

      <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- The right column scrolls as one (the scrollbar only shows when it doesn't all fit). The console
             fills what's left and keeps a readable height when there isn't room (MainWindow.FitRightColumn). -->
        <ScrollViewer x:Name="RightScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,-14,0" Padding="0,0,14,0" Focusable="False">
        <StackPanel x:Name="RightColumn">
          <Border x:Name="SetupRightView" Visibility="{Binding SetupRight, Converter={StaticResource Visible}}">
            <views:SetupBar Margin="0,0,0,16" Visibility="{Binding SelectedFlavor.IsOn, Converter={StaticResource Visible}}"/>
          </Border>
          <views:DiscordPanel x:Name="DiscordView" DataContext="{Binding Discord}"/>
          <views:StreamPanel x:Name="StreamView" Margin="0,16,0,0" DataContext="{Binding Stream}"/>
          <views:ConsolePanel x:Name="ConsoleView" Margin="0,16,0,0"/>
        </StackPanel>
        </ScrollViewer>
        <!-- The maker and a tip link, quietly in the corner, always in view (outside the scrolling). -->
        <StackPanel x:Name="CreditRow" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,2,0">
          <Button Cursor="Hand" ToolTip="twitch.tv/zebdryg" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.twitch.tv/zebdryg">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <TextBlock x:Name="Credit" Text="made by ZebDryg @ twitch" FontSize="10" Foreground="{StaticResource Faint}" Opacity="0.6"/>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Credit" Property="Opacity" Value="1"/>
                    <Setter TargetName="Credit" Property="Foreground" Value="#9146FF"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock Text="·" FontSize="10" Foreground="{StaticResource Faint}" Opacity="0.6" Margin="6,0"/>
          <Button Cursor="Hand" ToolTip="Like the app? Tips are welcome (streamlabs.com/zebdryg/tip)" Command="{Binding OpenUrlCommand}" CommandParameter="https://streamlabs.com/zebdryg/tip">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <TextBlock x:Name="Tip" Text="tip ♥" FontSize="10" Foreground="{StaticResource Faint}" Opacity="0.6"/>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tip" Property="Opacity" Value="1"/>
                    <Setter TargetName="Tip" Property="Foreground" Value="#F87171"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>