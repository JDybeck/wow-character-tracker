<Window x:Class="WoWCharacterTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure"
        Title="Character Tracker" Icon="Assets/app.ico" Width="1320" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        xmlns:views="clr-namespace:WoWCharacterTracker.Views">

  <Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <Grid x:Name="Page" Margin="28,22,24,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <views:Header x:Name="HeaderView"/>
    <!-- Notices across the top: an update, a /reload reminder, the old beta folder and setup that needs
         doing. Nothing shows when all is fine. -->
    <views:SetupBar x:Name="SetupStrip" Grid.Row="1" Wide="True" Margin="0,0,0,14" Visibility="{Binding SelectedFlavor.IsOn, Converter={StaticResource Visible}}"/>

    <!-- Main area: the page tabs on top, then the page, full width. -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="2,0,0,10">
        <!-- The pages, as boxed tabs: icon and name, the open one filled. -->
        <StackPanel x:Name="PageTabs" Orientation="Horizontal">
          <Button x:Name="CharacterTabs" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=characters|items|professions|followed}"
                  Command="{Binding ShowPageCommand}" CommandParameter="characters">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Characters"/></StackPanel>
          </Button>
          <Button x:Name="FriendsTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=friends}"
                  Command="{Binding ShowPageCommand}" CommandParameter="friends">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Friends"/></StackPanel>
          </Button>
          <Button x:Name="SharingTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=sharing}"
                  Command="{Binding ShowPageCommand}" CommandParameter="sharing">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Sharing"/></StackPanel>
          </Button>
        </StackPanel>
        <!-- The Characters tab's views: the list, everything they carry, who crafts what, the wish list. -->
        <Border x:Name="CharacterViews" Style="{StaticResource SegmentBox}" HorizontalAlignment="Right" VerticalAlignment="Center"
                Visibility="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=characters|items|professions|followed}">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SegmentButton}" Content="List" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=characters}"
                    Command="{Binding ShowPageCommand}" CommandParameter="characters" ToolTip="Your characters, click one for its details"/>
            <Button Style="{StaticResource SegmentButton}" Content="Items" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=items}"
                    Command="{Binding ShowPageCommand}" CommandParameter="items" ToolTip="Everything your characters carry, wear and keep in the bank"/>
            <Button Style="{StaticResource SegmentButton}" Content="Professions" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=professions}"
                    Command="{Binding ShowPageCommand}" CommandParameter="professions" ToolTip="Who can craft what"/>
            <Button x:Name="FollowedTab" Style="{StaticResource SegmentButton}" Content="Followed" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=followed}"
                    Command="{Binding ShowPageCommand}" CommandParameter="followed" ToolTip="Your wish list: items to watch for"/>
          </StackPanel>
        </Border>
      </DockPanel>

      <!-- No game folder or no addon: the app can't track anything yet, so that check sits big over the
           pages, wherever the setup checks are placed. -->
      <views:SetupCard Grid.Row="1"/>

      <!-- Characters and Items, once per game tab (their DataContext is the tab): the hidden tab's
           pages stay built, so switching tabs only swaps which one shows. -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding FlavorTabs}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource Visible}}"/>
            <!-- slides in from the side of its tab (Retail left, Forever right) -->
            <Setter Property="ui:Motion.SlideIndex" Value="{Binding Order}"/>
            <Setter Property="ui:Motion.SlideGroup" Value="game"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:FlavorViewModel}">
            <Grid>
              <views:CharactersPage/>
              <views:ItemsPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="1" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=items}"/>
              <views:ProfessionsPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="2" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=professions}"/>
              <views:FollowedItemsPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="5" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=followed}"/>
              <views:FriendsPage/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:SharingPage x:Name="SharingView" Grid.Row="2"/>
      <views:SettingsPage Grid.Row="2"/>
      <views:UninstallPage Grid.Row="2"/>
      <!-- A turned-off game: covers the page tabs and pages (opaque card) with a way back on. -->
      <views:GameOffPage Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
  </Grid>

  <!-- The console slides out from the rail over the page (MainWindow: hover, click or pinned). -->
  <Border x:Name="ConsoleFlyout" Width="460" HorizontalAlignment="Right" Margin="0,112,0,22" Padding="0,0,10,0"
          Visibility="{Binding ConsoleOpen, Converter={StaticResource Visible}}">
    <views:ConsolePanel x:Name="ConsoleView"/>
  </Border>
  <views:Rail x:Name="RailView" Grid.Column="1"/>
  <!-- The first-run tour, over everything (MainWindow.TourTarget says where each step points). -->
  <views:IntroTour x:Name="Tour" Grid.ColumnSpan="2" DataContext="{Binding Intro}"/>
  </Grid>
</Window>