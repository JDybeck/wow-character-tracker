<Window x:Class="WoWCharacterTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure"
        Title="Character Tracker" Icon="Assets/app.ico" Width="1320" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        xmlns:views="clr-namespace:WoWCharacterTracker.Views">

  <Grid Margin="28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <views:Header/>
    <views:SetupBar Grid.Row="1"/>

    <!-- Main area: the page tabs on top (left), then the page and the right column side by side,
         so their top edges line up. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*" MinWidth="300"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="2,0,0,10">
        <!-- Filter by realm (Retail) or ruleset (Forever), on the Characters page -->
        <Grid DockPanel.Dock="Right" Visibility="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=characters}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding SelectedFlavor}"
                    Visibility="{Binding HasGroups, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding GroupLabel}" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ItemContainerStyle="{StaticResource GroupChipItem}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </StackPanel>
        </Grid>
        <!-- The pages, as boxed tabs: icon and name, the open one filled. -->
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=characters}"
                  Command="{Binding ShowPageCommand}" CommandParameter="characters">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Characters"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=items}"
                  Command="{Binding ShowPageCommand}" CommandParameter="items">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Items"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=posting}"
                  Command="{Binding ShowPageCommand}" CommandParameter="posting">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="What gets posted"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=ingame}"
                  Command="{Binding ShowPageCommand}" CommandParameter="ingame">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="In game"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- Characters and Items, once per game tab (their DataContext is the tab): the hidden tab's
           pages stay built, so switching tabs only swaps which one shows. -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding FlavorTabs}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource Visible}}"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:FlavorViewModel}">
            <Grid>
              <views:CharactersPage/>
              <views:ItemsPage Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=items}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:PostingPage Grid.Row="1"/>
      <views:InGamePage Grid.Row="1"/>
      <views:UninstallPage Grid.Row="1"/>

      <Grid Grid.Row="1" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <views:DiscordPanel DataContext="{Binding Discord}"/>
        <views:ConsolePanel Grid.Row="2"/>
        <!-- The maker, quietly in the corner. -->
        <Button Grid.Row="3" HorizontalAlignment="Right" Margin="0,6,2,-14" Cursor="Hand" ToolTip="twitch.tv/zebdryg"
                Command="{Binding OpenUrlCommand}" CommandParameter="https://www.twitch.tv/zebdryg">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <TextBlock x:Name="Credit" Text="made by ZebDryg @ twitch" FontSize="10" Foreground="{StaticResource Faint}" Opacity="0.6"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Credit" Property="Opacity" Value="1"/>
                  <Setter TargetName="Credit" Property="Foreground" Value="#9146FF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>