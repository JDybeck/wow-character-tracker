<Window x:Class="WoWCharacterTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WoWCharacterTracker"
        Title="Character Tracker" Icon="Assets/app.ico" Width="1320" Height="900" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Window.Resources>
    <!-- A coin: a small colored dot (gold, silver, copper) after the amount, like the game. -->
    <DataTemplate x:Key="CoinTemplate" DataType="{x:Type local:Coin}">
      <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
        <TextBlock Text="{Binding Amount}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
        <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="3,1,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Row">
      <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Wrap">
      <WrapPanel/>
    </ItemsPanelTemplate>
    <!-- An icon with text (crest + count, profession + skill), tooltip from Wowhead. -->
    <DataTemplate x:Key="IconChipTemplate" DataType="{x:Type local:IconChip}">
      <Border Background="#4D1E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="5" Padding="3,2,8,2" Margin="0,0,6,6"
              ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding IconUrl}" Width="18" Height="18" Margin="0,0,6,0"/>
          <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- Same column widths for the header row and every character row. -->
    <GridLength x:Key="ColClass">180</GridLength>
    <GridLength x:Key="ColLevel">90</GridLength>
    <GridLength x:Key="ColIlvl">100</GridLength>
    <GridLength x:Key="ColGold">110</GridLength>
    <GridLength x:Key="ColSeen">110</GridLength>

    <Style x:Key="CharacterItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game version tabs (Retail / Forever) as pills in the header. -->
    <Style x:Key="FlavorTab" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Padding="18,7" CornerRadius="7" Margin="3" Background="Transparent">
              <TextBlock x:Name="Txt" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blue}"/>
                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Realm / ruleset filter chips. -->
    <Style x:Key="GroupChipItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Padding="10,3" CornerRadius="12" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#334155" Background="Transparent">
              <TextBlock x:Name="Txt" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BlueTextBright}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Page tabs (Characters / What gets posted) with an underline. -->
    <Style x:Key="PageTab" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="4,8" Margin="0,0,22,0">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueHover}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FactLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>
    <Style x:Key="FactValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="56"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: title, game tabs, sync -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/logo.png" Width="56" Height="56" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Character Tracker" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding SelectedFlavor.StatusText}" Foreground="{StaticResource Muted}" FontSize="13"/>
            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource GhostButton}" Padding="6,0" Margin="4,0,0,0" Command="{Binding CheckUpdatesCommand}"
                    ToolTip="Look for a new version on GitHub" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Foreground="{DynamicResource BlueText}" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding UpdateButtonText}" FontSize="12" Foreground="{DynamicResource BlueText}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="10" VerticalAlignment="Center">
        <ListBox ItemsSource="{Binding FlavorTabs}" SelectedItem="{Binding SelectedFlavor}" ItemContainerStyle="{StaticResource FlavorTab}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Width="26" Height="26" Background="Transparent" Margin="0,0,16,0" Cursor="Help"
                ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="60000">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border.ToolTip>
            <StackPanel>
              <TextBlock Text="In-game commands" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="20">
                /wct          your last 10 level times<LineBreak/>
                /wct test     check that instant posting works<LineBreak/>
                /wct live     instant posting on or off<LineBreak/>
                /wct popup    reload popup after a ding on or off<LineBreak/>
                /wct help     this list, in game
              </TextBlock>
            </StackPanel>
          </Border.ToolTip>
        </Border>
        <CheckBox IsChecked="{Binding ShowTestCharacters}" VerticalAlignment="Center" Margin="0,0,16,0"
                  ToolTip="Show made-up Forever characters (Zeb, Fågelmannen, Goggo) to try the app without playing. They're never posted on their own.">
          <TextBlock Text="Test characters" FontSize="12" Foreground="{StaticResource Muted}"/>
        </CheckBox>        <CheckBox IsChecked="{Binding OpenWithWow}" VerticalAlignment="Center" Margin="0,0,18,0"
                  ToolTip="Waits in the tray and opens when you start World of Warcraft, like Archon. Closing the window keeps it tracking in the tray.">
          <TextBlock Text="Open with World of Warcraft" FontSize="12" Foreground="{StaticResource Muted}"/>
        </CheckBox>
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SyncCommand}"
                ToolTip="Read the game's data again and post anything new">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Foreground="White" FontSize="15" Margin="0,0,8,0"/>
            <TextBlock Text="Sync now" Foreground="White"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Setup checks for the selected game -->
    <StackPanel Grid.Row="1">
    <Border Visibility="{Binding ShowBanner, Converter={StaticResource Visible}}" Margin="0,0,0,14" Padding="16,12" CornerRadius="10"
            Background="{DynamicResource IndigoPanel}" BorderBrush="{DynamicResource IndigoLine}" BorderThickness="1">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="What's new" Command="{Binding ToggleNotesCommand}" Margin="0,0,6,0" Padding="10,4"
                    Visibility="{Binding BannerNotes, Converter={StaticResource VisibleIfSet}}"/>
            <Button Style="{StaticResource IndigoButton}" Content="Update now" Command="{Binding InstallUpdateCommand}" Margin="0,0,6,0" Padding="12,5"
                    Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}"/>
            <Button Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding CloseBannerCommand}" ToolTip="Close">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{StaticResource Muted}"/>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Indigo}" FontSize="15" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding BannerTitle}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="25,8,0,0"
                      Visibility="{Binding ShowNotes, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding BannerNotes}" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" LineHeight="19"/>
        </ScrollViewer>
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding SelectedFlavor.Steps}" Margin="0,0,0,18">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:SetupItem}">
          <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Dot" Width="30" Height="30" CornerRadius="15" Background="{StaticResource GreenSoft}" Margin="0,0,12,0">
                <TextBlock x:Name="DotIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Green}"
                           FontSize="14" HorizontalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Detail}"/>
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource ButtonBase}" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                      Visibility="{Binding ActionText, Converter={StaticResource VisibleIfSet}}" Margin="10,0,0,0" Padding="10,4"/>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Ok}" Value="False">
              <Setter TargetName="Dot" Property="Background" Value="{StaticResource AmberSoft}"/>
              <Setter TargetName="DotIcon" Property="Text" Value="&#xE7BA;"/>
              <Setter TargetName="DotIcon" Property="Foreground" Value="{StaticResource Amber}"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>

    <!-- Main area -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Left: page tabs and the page -->
      <Grid Grid.RowSpan="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,0,10">
          <!-- Filter by realm (Retail) or ruleset (Forever), on the Characters page -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding SelectedFlavor}"
                      Visibility="{Binding HasGroups, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding GroupLabel}" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ItemContainerStyle="{StaticResource GroupChipItem}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
          <Button Content="Characters" Command="{Binding ShowPageCommand}" CommandParameter="characters">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource PageTab}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Page}" Value="characters">
                    <Setter Property="Tag" Value="active"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="What gets posted" Command="{Binding ShowPageCommand}" CommandParameter="posting">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource PageTab}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Page}" Value="posting">
                    <Setter Property="Tag" Value="active"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          </StackPanel>
        </DockPanel>

        <!-- Characters page -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" ClipToBounds="True" DataContext="{Binding SelectedFlavor}"
                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=characters}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="2" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12"
                    Padding="24,10" Visibility="{Binding HasCharacters, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Foreground="#FBBF24" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TotalGoldText}" Foreground="{StaticResource TextSoft}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding TotalCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Row}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
              <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="{StaticResource ColClass}"/>
                  <ColumnDefinition Width="{StaticResource ColLevel}"/>
                  <ColumnDefinition Width="{StaticResource ColIlvl}"/>
                  <ColumnDefinition Width="{StaticResource ColGold}"/>
                  <ColumnDefinition Width="{StaticResource ColSeen}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColumnHeader}" Text="CHARACTER"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="CLASS"/>
                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="LEVEL"/>
                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="ITEM LEVEL"/>
                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="GOLD"/>
                <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="LAST SEEN"/>
              </Grid>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CharacterItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:CharacterRow}">
                  <StackPanel>
                    <Grid Margin="24,12" Background="Transparent" PreviewMouseLeftButtonDown="CharacterHeader_MouseDown">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ColClass}"/>
                        <ColumnDefinition Width="{StaticResource ColLevel}"/>
                        <ColumnDefinition Width="{StaticResource ColIlvl}"/>
                        <ColumnDefinition Width="{StaticResource ColGold}"/>
                        <ColumnDefinition Width="{StaticResource ColSeen}"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Orientation="Horizontal">
                        <Grid Width="42" Height="42" Margin="0,0,12,0">
                          <Ellipse Fill="{Binding ClassSoftBrush}" Stroke="#1AFFFFFF"/>
                          <TextBlock Text="{Binding Initial}" Foreground="{Binding ClassBrush}" FontSize="17" FontWeight="Bold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding PictureUrl}" Stretch="UniformToFill">
                            <Image.Clip>
                              <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21"/>
                            </Image.Clip>
                          </Image>
                          <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="1.5" Opacity="0.7"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{Binding ClassBrush}" FontSize="15" FontWeight="SemiBold"/>
                            <Border x:Name="TagBox" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                    Background="#33F87171" Visibility="{Binding Tag, Converter={StaticResource VisibleIfSet}}">
                              <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Red}"/>
                            </Border>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Realm}" Foreground="{StaticResource Dim}" FontSize="12"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding RoleGlyph}" Foreground="{Binding RoleBrush}" FontSize="13" Margin="0,0,8,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding ClassName}" Foreground="{Binding ClassBrush}" FontWeight="Medium" FontSize="13"/>
                          <TextBlock Text="{Binding Spec}" Foreground="{StaticResource Dim}" FontSize="11"
                                     Visibility="{Binding Spec, Converter={StaticResource VisibleIfSet}}"/>
                        </StackPanel>
                      </StackPanel>

                      <Border Grid.Column="2" Style="{StaticResource Pill}">
                        <TextBlock Text="{Binding Level}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource TextSoft}"/>
                      </Border>

                      <Border Grid.Column="3" Style="{StaticResource Pill}" Background="#4D1E3A8A" BorderBrush="#801D4ED8">
                        <TextBlock Text="{Binding ItemLevelText}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{DynamicResource BlueText}"/>
                      </Border>

                      <Grid Grid.Column="4" VerticalAlignment="Center" ToolTip="{Binding MoneyText}">
                        <ItemsControl ItemsSource="{Binding ShortCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Row}"
                                      Visibility="{Binding HasMoney, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="-" Foreground="{StaticResource Dim}" Visibility="{Binding HasMoney, Converter={StaticResource Hidden}}"/>
                      </Grid>
                      <TextBlock Grid.Column="5" Text="{Binding LastSeenText}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Details, shown for the selected character -->
                    <Border Margin="24,0,24,16" Padding="18,6,18,16" CornerRadius="10" Background="#660F172A" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolVis}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                          <TextBlock Style="{StaticResource FactLabel}" Text="CHARACTER"/>
                          <TextBlock Style="{StaticResource FactValue}" Text="{Binding Description}"/>
                          <StackPanel Visibility="{Binding HasGuild, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="GUILD"/>
                            <TextBlock Style="{StaticResource FactValue}" Text="{Binding Guild, StringFormat='&lt;{0}&gt;'}"/>
                          </StackPanel>
                          <TextBlock Style="{StaticResource FactLabel}" Text="TOTAL PLAYED"/>
                          <TextBlock Style="{StaticResource FactValue}" Text="{Binding PlayedText}"/>
                          <TextBlock Style="{StaticResource FactLabel}" Text="GOLD"/>
                          <ItemsControl ItemsSource="{Binding MoneyCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Row}"/>
                          <StackPanel Visibility="{Binding HasCrests, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="CRESTS"/>
                            <ItemsControl ItemsSource="{Binding CrestList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
                          </StackPanel>
                          <TextBlock Style="{StaticResource FactLabel}" Text="PROFESSIONS"/>
                          <ItemsControl ItemsSource="{Binding ProfessionList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"
                                        Visibility="{Binding HasProfessions, Converter={StaticResource Visible}}"/>
                          <TextBlock Style="{StaticResource FactValue}" Text="None yet" Visibility="{Binding HasProfessions, Converter={StaticResource Hidden}}"/>
                          <TextBlock Style="{StaticResource FactLabel}" Text="TALENTS"/>
                          <TextBlock Style="{StaticResource FactValue}" Text="{Binding TalentsText}"/>
                          <TextBlock Style="{StaticResource FactLabel}" Text="LAST ZONE"/>
                          <TextBlock Style="{StaticResource FactValue}" Text="{Binding ZoneText}"/>
                          <TextBlock Style="{StaticResource FactLabel}" Text="TAGS"/>
                          <ItemsControl ItemsSource="{Binding TagOptions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type local:ToggleOption}">
                                <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid Width="220" HorizontalAlignment="Left">
                            <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" FontSize="12">
                              <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                              </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="New tag, then Enter (e.g. Main)" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding NewTag, Converter={StaticResource HiddenIfSet}}"/>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource ButtonBase}" Padding="12,6"
                                    ToolTip="Send a card with this character's info to Discord"
                                    Command="{Binding DataContext.PostCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,7,0"/>
                                <TextBlock Text="Post to Discord" FontSize="12" Foreground="{StaticResource TextSoft}"/>
                              </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ButtonBase}" Padding="8,6" Margin="6,0,0,0" ToolTip="Choose what the card shows"
                                    Command="{Binding DataContext.ToggleCardOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                              <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="12" Foreground="{StaticResource TextSoft}"/>
                            </Button>
                          </StackPanel>
                          <Border Margin="0,10,0,0" Padding="12,10,6,6" CornerRadius="8" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                  Visibility="{Binding DataContext.ShowCardOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                              <TextBlock Text="The card shows:" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                              <ItemsControl ItemsSource="{Binding DataContext.CardOptions, RelativeSource={RelativeSource AncestorType=Window}}" ItemsPanel="{StaticResource Wrap}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type local:ToggleOption}">
                                    <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                          <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,6,0,0" Padding="12,5"
                                  ToolTip="Hide this character. Playing it again brings it back."
                                  Command="{Binding DataContext.RemoveCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource Red}" Margin="0,0,7,0"/>
                              <TextBlock Text="Remove from list" FontSize="12" Foreground="{StaticResource Red}"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                          <StackPanel Visibility="{Binding HasHighlights, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource FactLabel}" Text="HIGHLIGHTS"/>
                            <ItemsControl ItemsSource="{Binding Highlights}" MaxHeight="150">
                              <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                  </ScrollViewer>
                                </ControlTemplate>
                              </ItemsControl.Template>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HighlightRow}">
                                  <Grid Margin="0,3,8,3">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="22"/>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="12"
                                               Visibility="{Binding HasIcon, Converter={StaticResource Hidden}}"/>
                                    <Image Source="{Binding IconUrl}" Width="16" Height="16" HorizontalAlignment="Left"
                                           Visibility="{Binding HasIcon, Converter={StaticResource Visible}}"/>
                                    <TextBlock Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}">
                                      <Run Text="{Binding Verb, Mode=OneWay}" Foreground="{StaticResource Text}"/><Run Text="{Binding Subject, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Foreground="{StaticResource Dim}" Margin="8,0,0,0"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <TextBlock Style="{StaticResource FactLabel}" Text="LEVEL HISTORY"/>
                          <TextBlock Text="No level-ups recorded yet. Ding once and it shows up here." Foreground="{StaticResource Dim}" FontSize="13"
                                     Visibility="{Binding HasLevels, Converter={StaticResource Hidden}}" TextWrapping="Wrap"/>
                          <ItemsControl ItemsSource="{Binding Levels}" MaxHeight="230">
                            <ItemsControl.Template>
                              <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                  <ItemsPresenter/>
                                </ScrollViewer>
                              </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type local:LevelRow}">
                                <Grid Margin="0,3,8,3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding LevelText}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource TextSoft}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Took}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Green}"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Zone}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Grid.Column="3" Text="{Binding When}" FontSize="12" Foreground="{StaticResource Dim}" Margin="8,0,0,0"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasCharacters, Converter={StaticResource Hidden}}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
              <TextBlock Text="No characters yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                         Text="Log in to a character in this game version and type /reload (or log out). Your characters show up here after that."/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- What gets posted page -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" DataContext="{Binding SelectedFlavor}"
                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=posting}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22">
              <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset to defaults"
                        Command="{Binding DataContext.ResetPostingCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White">
                  <Run Text="What gets posted for"/>
                  <Run Text="{Binding Name, Mode=OneWay}"/>
                </TextBlock>
              </DockPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                         Text="Changes apply right away. Things that are switched off are skipped, and they won't be posted later if you switch them on. Screenshot means the addon takes one in game a moment after it happens (saved in your Screenshots folder). Screenshot settings reach the game on your next /reload or login."/>
              <CheckBox IsChecked="{Binding HideChatInShots}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Hide chat in screenshots" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="The chat windows are hidden for the moment the screenshot is taken, then come right back."/>
                </StackPanel>
              </CheckBox>

              <!-- Level-ups -->
              <Border Padding="18,16" CornerRadius="10" Background="#4D1E293B" BorderBrush="#80334155" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="level"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[level].Take}"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[level].Post}" IsEnabled="{Binding Shots[level].Take}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding PostLevels}">
                      <TextBlock Style="{StaticResource SectionTitle}" Text="Level-ups"/>
                    </CheckBox>
                  </DockPanel>
                  <StackPanel Margin="30,10,0,0" IsEnabled="{Binding PostLevels}">
                    <WrapPanel>
                      <TextBlock Text="Up to level" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                      <TextBox Style="{StaticResource NumberBox}" Text="{Binding LevelSplit, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBlock Text=", post every" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                      <TextBox Style="{StaticResource NumberBox}" Text="{Binding LevelEveryBefore, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBlock Text="levels. After that, every" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                      <TextBox Style="{StaticResource NumberBox}" Text="{Binding LevelEveryAfter, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBlock Text="level(s)." VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding LevelPreview}" Foreground="{StaticResource Green}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,6,0,0">
                      <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test max level" Padding="8,2" FontSize="11"
                              ToolTip="Post a sample max level post to Discord now"
                              Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="max"/>
                      <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="&#x1F3C6; Reaching max level is always posted, with extra flair and the time it took."/>
                    </DockPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Loot -->
              <Border Padding="18,16" CornerRadius="10" Background="#4D1E293B" BorderBrush="#80334155" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                  <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[loot].Take}"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[loot].Post}" IsEnabled="{Binding Shots[loot].Take}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Loot"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" VerticalAlignment="Top" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="rare"/>
                  <CheckBox IsChecked="{Binding PostRare}">
                    <StackPanel>
                      <TextBlock Text="Rare items" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="13"/>
                      <TextBlock Style="{StaticResource Hint}" Text="Blue items you loot. Plenty of these while leveling."/>
                    </StackPanel>
                  </CheckBox>
                  </DockPanel>
                  <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" VerticalAlignment="Top" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="epic"/>
                  <CheckBox IsChecked="{Binding PostEpic}">
                    <StackPanel>
                      <TextBlock Text="Epic items" Foreground="#C084FC" FontWeight="SemiBold" FontSize="13"/>
                      <TextBlock Style="{StaticResource Hint}" Text="Purple items you loot."/>
                    </StackPanel>
                  </CheckBox>
                  </DockPanel>
                  <DockPanel Margin="30,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11"
                            ToolTip="Post a sample legendary post to Discord now"
                            Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="legendary"/>
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Foreground="#FB923C" Text="Legendary (orange) items are always posted, with extra flair."/>
                  </DockPanel>
                </StackPanel>
              </Border>

              <!-- Milestones -->
              <Border Padding="18,16" CornerRadius="10" Background="#4D1E293B" BorderBrush="#80334155" BorderThickness="1">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="Milestones" Margin="0,0,0,10"/>
                  <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mount"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[mount].Take}"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[mount].Post}" IsEnabled="{Binding Shots[mount].Take}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding PostMounts}">
                      <StackPanel>
                        <TextBlock Text="New mounts" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Bought from a vendor or learned. Says &quot;bought&quot; when a vendor was open."/>
                      </StackPanel>
                    </CheckBox>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="boss"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[boss].Take}"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[boss].Post}" IsEnabled="{Binding Shots[boss].Take}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding PostBosses}">
                      <StackPanel>
                        <TextBlock Text="End boss kills" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="The last boss of a dungeon or raid, like Edwin VanCleef or Ragnaros. The post lists the group."/>
                      </StackPanel>
                    </CheckBox>
                  </DockPanel>
                  <StackPanel Margin="30,0,0,12" IsEnabled="{Binding PostBosses}">
                    <TextBlock Text="Don't post when someone in the group matches (regex):" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Width="320" HorizontalAlignment="Left">
                      <TextBox Text="{Binding SkipBossGroupRegex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
                      <TextBlock Text="e.g. ^(Grimtusk|Pellia)$" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" FontFamily="{StaticResource Mono}"
                                 VerticalAlignment="Center" IsHitTestVisible="False"
                                 Visibility="{Binding SkipBossGroupRegex, Converter={StaticResource HiddenIfSet}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="For friends who run the tracker too, so the same kill isn't posted several times. Matches their name or Name-Realm, not case sensitive."/>
                    <TextBlock Text="{Binding SkipRegexProblem}" Foreground="{StaticResource Red}" FontSize="12"
                               Visibility="{Binding SkipRegexProblem, Converter={StaticResource VisibleIfSet}}"/>
                  </StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="death"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[death].Take}"/>
                      <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[death].Post}" IsEnabled="{Binding Shots[death].Take}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding PostDeaths}">
                      <StackPanel>
                        <TextBlock Text="Hardcore deaths" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Only hardcore characters. Shows what killed them, total played and the gold they had on them."/>
                      </StackPanel>
                    </CheckBox>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Discord webhooks -->
      <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource ButtonBase}" Command="{Binding TestWebhookCommand}" Margin="0,0,8,0"
                      Visibility="{Binding HasWebhooks, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSoft}"/>
                  <TextBlock Text="Send test" Foreground="{StaticResource TextSoft}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ButtonBase}" Command="{Binding ToggleAddWebhookCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSoft}"/>
                  <TextBlock Text="Add" Foreground="{StaticResource TextSoft}"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Foreground="{DynamicResource Indigo}" FontSize="17" Margin="0,0,10,0"/>
              <TextBlock Text="Discord" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Visibility="{Binding HasWebhooks, Converter={StaticResource Visible}}">
            <Run Text="Click a webhook to turn it on or off for"/>
            <Run Text="{Binding SelectedFlavor.Name, Mode=OneWay}"/><Run Text=". Posts go to every one that's on."/>
          </TextBlock>

          <ItemsControl ItemsSource="{Binding Webhooks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WebhookRow}">
                <Border x:Name="Row" Margin="0,0,0,8" Padding="14,10" CornerRadius="8" BorderThickness="1"
                        Background="#4D1E293B" BorderBrush="#80334155" ToolTip="{Binding Masked}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <!-- Name and summary (click to turn on/off for this tab), or the rename box -->
                      <StackPanel Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                  Visibility="{Binding IsEditing, Converter={StaticResource Hidden}}">
                        <StackPanel.InputBindings>
                          <MouseBinding MouseAction="LeftClick"
                                        Command="{Binding DataContext.SelectWebhookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                        </StackPanel.InputBindings>
                        <DockPanel LastChildFill="True">
                          <Border x:Name="ActiveTag" DockPanel.Dock="Right" Visibility="Collapsed" Margin="8,0,4,0" Padding="7,1" CornerRadius="9"
                                  Background="{DynamicResource IndigoSoft}" BorderBrush="{DynamicResource IndigoLineSoft}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="ON" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource IndigoText}"/>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" Margin="0,0,8,0"
                               local:FocusWhenVisible.Enabled="True"
                               Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                        <TextBox.InputBindings>
                          <KeyBinding Key="Enter" Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                          <KeyBinding Key="Escape" Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                      </TextBox>

                      <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="8,4" ToolTip="Options: which games and rulesets"
                              Command="{Binding DataContext.ToggleWebhookOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <TextBlock x:Name="Gear" Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" Foreground="{StaticResource Dim}"/>
                      </Button>
                      <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,4" ToolTip="Rename"
                              Visibility="{Binding IsEditing, Converter={StaticResource Hidden}}"
                              Command="{Binding DataContext.RenameWebhookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Foreground="{StaticResource Dim}"/>
                      </Button>
                      <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,4" ToolTip="Save name (Enter)"
                              Visibility="{Binding IsEditing, Converter={StaticResource Visible}}"
                              Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{StaticResource Green}"/>
                      </Button>
                      <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="8,4" Margin="0,0,8,0" ToolTip="Remove this webhook"
                              Command="{Binding DataContext.RemoveWebhookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{StaticResource Dim}"/>
                      </Button>
                      <Border x:Name="Radio" Grid.Column="4" Width="20" Height="20" CornerRadius="5" BorderThickness="1" BorderBrush="#475569"
                              Background="Transparent" Cursor="Hand" VerticalAlignment="Center" ToolTip="On or off for this tab">
                        <Border.InputBindings>
                          <MouseBinding MouseAction="LeftClick"
                                        Command="{Binding DataContext.SelectWebhookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <TextBlock x:Name="RadioCheck" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{DynamicResource Indigo}"
                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                      </Border>
                    </Grid>

                    <!-- Options: games and Forever rulesets, changed by clicking the chips -->
                    <StackPanel Margin="0,10,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                      <TextBlock Text="POSTS FOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,0,0,5"/>
                      <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:ToggleOption}">
                            <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Visibility="{Binding HasTags, Converter={StaticResource Visible}}">
                        <TextBlock Text="CHARACTERS (NONE PICKED = ALL)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,6,0,5"/>
                        <ItemsControl ItemsSource="{Binding Tags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ToggleOption}">
                              <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"
                                        ToolTip="Right-click to delete this tag everywhere">
                                <CheckBox.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Header="Delete this tag everywhere"
                                              Command="{Binding PlacementTarget.Tag.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Name}"/>
                                  </ContextMenu>
                                </CheckBox.ContextMenu>
                                <CheckBox.Tag>
                                  <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </CheckBox.Tag>
                              </CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Text="FOREVER RULESETS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,6,0,5"/>
                      <ItemsControl ItemsSource="{Binding Rulesets}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:ToggleOption}">
                            <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource IndigoSoft}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource IndigoLine}"/>
                    <Setter TargetName="ActiveTag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Radio" Property="BorderBrush" Value="{DynamicResource Indigo}"/>
                    <Setter TargetName="Radio" Property="Background" Value="{DynamicResource IndigoSoft}"/>
                    <Setter TargetName="RadioCheck" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Gear" Property="Foreground" Value="{DynamicResource Indigo}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- How to get a webhook, shown until there is one -->
          <StackPanel Visibility="{Binding HasWebhooks, Converter={StaticResource Hidden}}" Margin="0,8,0,4">
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="A webhook is the link the app posts through. To make one:"/>
            <TextBlock Foreground="{StaticResource TextSoft}" FontSize="13" TextWrapping="Wrap" LineHeight="21">
              1. In Discord, hover the channel you want posts in and click the gear (Edit Channel).<LineBreak/>
              2. Go to Integrations, then Webhooks, then New Webhook. Give it a name and picture if you like.<LineBreak/>
              3. Click Copy Webhook URL and paste it below. You need the Manage Webhooks permission on that server.
            </TextBlock>
          </StackPanel>

          <!-- Add form -->
          <Border Visibility="{Binding ShowAddWebhook, Converter={StaticResource Visible}}" Margin="0,8,0,0" Padding="16"
                  CornerRadius="8" Background="#801E293B" BorderBrush="#80334155" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Add New Webhook" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextSoft}" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,8">
                <TextBox Text="{Binding NewWebhookUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="https://discord.com/api/webhooks/..." Foreground="{StaticResource Faint}" FontSize="13" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding NewWebhookUrl, Converter={StaticResource HiddenIfSet}}"/>
              </Grid>
              <Grid>
                <TextBox Text="{Binding NewWebhookName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Name, e.g. #leveling / My Guild (optional)" Foreground="{StaticResource Faint}" FontSize="13" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding NewWebhookName, Converter={StaticResource HiddenIfSet}}"/>
              </Grid>
              <TextBlock Text="{Binding AddWebhookError}" Foreground="{StaticResource Red}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding AddWebhookError, Converter={StaticResource VisibleIfSet}}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding ToggleAddWebhookCommand}" Margin="0,0,8,0"
                        Visibility="{Binding HasWebhooks, Converter={StaticResource Visible}}"/>
                <Button Style="{StaticResource IndigoButton}" Content="Save Webhook" Command="{Binding SaveWebhookCommand}" IsDefault="True"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Console -->
      <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource CardBorder}" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                  CornerRadius="12,12,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
              <TextBlock Style="{StaticResource ColumnHeader}" Text="CONSOLE"/>
            </StackPanel>
          </Border>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,8,0,8">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:LogLine}">
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,0,8,0"/>
                  <TextBlock x:Name="Msg" Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="11"
                             Foreground="{StaticResource InfoText}" TextWrapping="Wrap"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="Success">
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Green}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Amber}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Red}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
