<Window x:Class="WoWCharacterTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure"
        Title="Character Tracker" Icon="Assets/app.ico" Width="1320" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        xmlns:views="clr-namespace:WoWCharacterTracker.Views">

  <Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <Grid x:Name="Page" Margin="28,22,24,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <views:Header x:Name="HeaderView" Panel.ZIndex="1"/> <!-- on top: the search list hangs over the page -->
    <!-- Notices across the top: an update, a /reload reminder, the old beta folder and setup that needs
         doing. Nothing shows when all is fine. -->
    <views:SetupBar x:Name="SetupStrip" Grid.Row="1" Wide="True" Margin="0,0,0,14" Visibility="{Binding SelectedFlavor.IsOn, Converter={StaticResource Visible}}"/>

    <!-- Main area: the page tabs on top, then the page, full width. -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="2,0,0,4">
        <!-- The Items tab's views: everything they carry, or the wish list. -->
        <Border x:Name="ItemViews" DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                Visibility="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=items|followed}">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SegmentButton}" Content="All items" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=items}"
                    Command="{Binding ShowPageCommand}" CommandParameter="items" ToolTip="Everything your characters carry, wear and keep in the bank"/>
            <Button x:Name="FollowedTab" Style="{StaticResource SegmentButton}" Content="Followed" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=followed}"
                    Command="{Binding ShowPageCommand}" CommandParameter="followed" ToolTip="Your wish list: items to watch for"/>
          </StackPanel>
        </Border>
        <!-- The Professions tab's views: everyone's, yours or your friends' (when there are both). -->
        <Grid x:Name="ProfessionViews" DockPanel.Dock="Right" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
              Visibility="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=professions}">
        <Border Style="{StaticResource SegmentBox}" DataContext="{Binding SelectedFlavor.Professions}"
                Visibility="{Binding HasBoth, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SegmentButton}" Content="Everyone" Tag="{Binding Who, Converter={StaticResource ActiveIf}, ConverterParameter=all}"
                    Command="{Binding ShowWhoCommand}" CommandParameter="all" ToolTip="Your characters' professions and your friends'"/>
            <Button Style="{StaticResource SegmentButton}" Content="Yours" Tag="{Binding Who, Converter={StaticResource ActiveIf}, ConverterParameter=you}"
                    Command="{Binding ShowWhoCommand}" CommandParameter="you" ToolTip="Only your characters"/>
            <Button Style="{StaticResource SegmentButton}" Content="Friends" Tag="{Binding Who, Converter={StaticResource ActiveIf}, ConverterParameter=friends}"
                    Command="{Binding ShowWhoCommand}" CommandParameter="friends" ToolTip="Only what friends share with you"/>
          </StackPanel>
        </Border>
        </Grid>
        <!-- The Friends tab's views: their characters, or their professions and recipes. Before them,
             where the game has an armory, its picture models for all friends' characters. -->
        <StackPanel x:Name="FriendViews" DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                    DataContext="{Binding SelectedFlavor.Friends}"
                    Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=friends}">
          <Border Style="{StaticResource SegmentBox}" Margin="0,0,8,0" Visibility="{Binding HasArmory, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource SegmentButton}" Content="HD" Tag="{Binding ArmoryModel, Converter={StaticResource ActiveIf}, ConverterParameter=hd}"
                      Command="{Binding ShowArmoryModelCommand}" CommandParameter="hd" ToolTip="Friends' armory pictures with the new character models. A character's own choice under Portrait wins"/>
              <Button Style="{StaticResource SegmentButton}" Content="SD" Tag="{Binding ArmoryModel, Converter={StaticResource ActiveIf}, ConverterParameter=sd}"
                      Command="{Binding ShowArmoryModelCommand}" CommandParameter="sd" ToolTip="Friends' armory pictures with the old character models. A character's own choice under Portrait wins"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SegmentBox}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource SegmentButton}" Content="Friends" Tag="{Binding View, Converter={StaticResource ActiveIf}, ConverterParameter=list}"
                      Command="{Binding ShowViewCommand}" CommandParameter="list" ToolTip="Your friends and their characters"/>
              <Button Style="{StaticResource SegmentButton}" Content="Professions" Tag="{Binding View, Converter={StaticResource ActiveIf}, ConverterParameter=professions}"
                      Command="{Binding ShowViewCommand}" CommandParameter="professions" ToolTip="Friends' professions and recipes, and who can craft what"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- The pages, as boxed tabs: icon and name, the open one filled. Last, so it gets the room the
             switches at the right leave, and wraps to a second row in a narrow window instead of
             running under them. -->
        <WrapPanel x:Name="PageTabs">
          <Button x:Name="HomeTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=home}"
                  Command="{Binding ShowPageCommand}" CommandParameter="home">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Home"/></StackPanel>
          </Button>
          <Button x:Name="CharacterTabs" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=characters}"
                  Command="{Binding ShowPageCommand}" CommandParameter="characters" ToolTip="Your characters, click one for its details">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Characters"/></StackPanel>
          </Button>
          <Button x:Name="ItemsTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=items|followed}"
                  Command="{Binding ShowPageCommand}" CommandParameter="items" ToolTip="Everything your characters carry, wear and keep in the bank, and your wish list">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Items"/></StackPanel>
          </Button>
          <Button x:Name="FriendsTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=friends}"
                  Command="{Binding ShowPageCommand}" CommandParameter="friends">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Friends"/></StackPanel>
          </Button>
          <Button x:Name="ProfessionsTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=professions}"
                  Command="{Binding ShowPageCommand}" CommandParameter="professions" ToolTip="Who can craft what">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Professions"/></StackPanel>
          </Button>
          <Button x:Name="StatsTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=stats}"
                  Command="{Binding ShowPageCommand}" CommandParameter="stats">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Stats"/></StackPanel>
          </Button>
          <Button x:Name="SharingTab" Style="{StaticResource PageTab}" Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=sharing}"
                  Command="{Binding ShowPageCommand}" CommandParameter="sharing">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Sharing"/></StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>

      <!-- No game folder or no addon: the app can't track anything yet, so that check sits big over the
           pages, wherever the setup checks are placed. -->
      <views:SetupCard Grid.Row="1"/>

      <!-- Characters and Items, once per game tab (their DataContext is the tab): the hidden tab's
           pages stay built, so switching tabs only swaps which one shows. -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding FlavorTabs}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource Visible}}"/>
            <!-- slides in from the side of its tab (Retail left, Forever right) -->
            <Setter Property="ui:Motion.SlideIndex" Value="{Binding Order}"/>
            <Setter Property="ui:Motion.SlideGroup" Value="game"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:FlavorViewModel}">
            <!-- Each page is built the first time it's shown (ui:LazyPage), so startup only builds the one you see. -->
            <Grid>
              <ui:LazyPage Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=home}">
                <ui:LazyPage.Page><DataTemplate><views:HomePage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
              <ui:LazyPage Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=characters}">
                <ui:LazyPage.Page><DataTemplate><views:CharactersPage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
              <ui:LazyPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="1" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=items}">
                <ui:LazyPage.Page><DataTemplate><views:ItemsPage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
              <ui:LazyPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="7" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=professions}">
                <ui:LazyPage.Page><DataTemplate><views:ProfessionsPage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
              <ui:LazyPage ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="2" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=followed}">
                <ui:LazyPage.Page><DataTemplate><views:FollowedItemsPage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
              <ui:LazyPage Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=friends}">
                <ui:LazyPage.Page><DataTemplate><views:FriendsPage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
              <ui:LazyPage Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=stats}">
                <ui:LazyPage.Page><DataTemplate><views:StatsPage/></DataTemplate></ui:LazyPage.Page>
              </ui:LazyPage>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <views:SharingPage x:Name="SharingView" Grid.Row="2"/>
      <views:SettingsPage Grid.Row="2"/>
      <views:UninstallPage Grid.Row="2"/>
      <views:DataPage Grid.Row="2"/>
      <!-- A turned-off game: covers the page tabs and pages (opaque card) with a way back on. -->
      <views:GameOffPage Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
  </Grid>

  <!-- The maker and a tip link, faint in the page's bottom margin so it never covers a page. -->
  <StackPanel x:Name="Credit" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,4">
    <Button Cursor="Hand" ToolTip="twitch.tv/zebdryg" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.twitch.tv/zebdryg">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Maker" Text="made by JDybeck · twitch" FontSize="11" Foreground="{StaticResource Dim}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Maker" Property="Foreground" Value="#9146FF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
    <TextBlock Text="·" FontSize="11" Foreground="{StaticResource Dim}" Margin="6,0"/>
    <Button Cursor="Hand" ToolTip="Like the app? Tips are welcome on Ko-fi (ko-fi.com/jdybeck)" Command="{Binding OpenUrlCommand}" CommandParameter="https://ko-fi.com/jdybeck">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Tip" Text="tip ♥" FontSize="11" Foreground="{StaticResource Dim}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Tip" Property="Foreground" Value="#F87171"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </StackPanel>

  <!-- The console slides out from the rail over the page (MainWindow: hover, click or pinned). -->
  <Border x:Name="ConsoleFlyout" Width="460" HorizontalAlignment="Right" Margin="0,112,0,22" Padding="0,0,10,0"
          Visibility="{Binding ConsoleOpen, Converter={StaticResource Visible}}">
    <views:ConsolePanel x:Name="ConsoleView"/>
  </Border>
  <views:Rail x:Name="RailView" Grid.Column="1"/>
  <!-- The first-run tour, over everything (MainWindow.TourTarget says where each step points). -->
  <views:SetupHelper Grid.ColumnSpan="2" DataContext="{Binding Intro}"/>
  </Grid>
</Window>