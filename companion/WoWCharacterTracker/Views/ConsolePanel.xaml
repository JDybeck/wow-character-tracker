<!-- What the app is doing, newest first. -->
<UserControl x:Class="WoWCharacterTracker.Views.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">
  <Border Style="{StaticResource CardBorder}" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
              CornerRadius="12,12,0,0" Padding="16,12">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource ColumnHeader}" Text="CONSOLE"/>
        </StackPanel>
      </Border>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs}" Margin="0,8,0,8">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type infra:LogLine}">
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,0,8,0"/>
              <TextBlock x:Name="Msg" Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="11"
                         Foreground="{StaticResource InfoText}" TextWrapping="Wrap"/>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Level}" Value="Success">
                <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Green}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Amber}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Red}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
