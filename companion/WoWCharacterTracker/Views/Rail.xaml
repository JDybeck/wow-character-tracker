<!-- The rail on the right edge: quick switches for the places moments go (the selected game's Discord,
     guild and group chat, and the stream overlay), each with its name and its state under it (on,
     off, or "set up" when something's missing), then the console, which slides out over the page
     (MainWindow), and its pin. Their settings live on the Sharing page. DataContext: MainViewModel. -->
<UserControl x:Class="WoWCharacterTracker.Views.Rail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RailButton" TargetType="ButtonBase">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="ToolTipService.Placement" Value="Left"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Bd" Width="62" CornerRadius="10" Padding="0,7,0,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <StackPanel HorizontalAlignment="Center">
                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <!-- Tag says the state: "on", "off" or "warn" (needs setting up). None: no state line. -->
                <TextBlock x:Name="State" FontSize="9.5" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{StaticResource Faint}" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="Tag" Value="off">
                <Setter TargetName="State" Property="Visibility" Value="Visible"/>
                <Setter TargetName="State" Property="Text" Value="off"/>
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="State" Property="Visibility" Value="Visible"/>
                <Setter TargetName="State" Property="Text" Value="on"/>
                <Setter TargetName="State" Property="Foreground" Value="{StaticResource Green}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlueSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueLine}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <!-- The console: a warning or error came in since it was last open. -->
              <Trigger Property="Tag" Value="new">
                <Setter TargetName="State" Property="Visibility" Value="Visible"/>
                <Setter TargetName="State" Property="Text" Value="new"/>
                <Setter TargetName="State" Property="Foreground" Value="{StaticResource Amber}"/>
                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
              </Trigger>
              <Trigger Property="Tag" Value="warn">
                <Setter TargetName="State" Property="Visibility" Value="Visible"/>
                <Setter TargetName="State" Property="Text" Value="set up"/>
                <Setter TargetName="State" Property="Foreground" Value="{StaticResource Amber}"/>
                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Name" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
  </UserControl.Resources>

  <Border Width="72" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
    <DockPanel Margin="0,112,0,14">
      <!-- The console and its pin, at the bottom. -->
      <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
        <Button x:Name="ConsoleButton" AutomationProperties.Name="Console" Command="{Binding ToggleConsoleCommand}"
                ToolTip="The console: what the app is doing. Hover or click to open.">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ConsoleAlert}" Value="True"><Setter Property="Tag" Value="new"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE756;"/><TextBlock Style="{StaticResource Name}" Text="Console"/></StackPanel>
        </Button>
        <ToggleButton IsChecked="{Binding ConsolePinned}" Style="{StaticResource RailButton}" Margin="0" AutomationProperties.Name="Keep the console open"
                      ToolTip="Keep the console open next to the rail">
          <TextBlock FontSize="13">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Text" Value="&#xE718;"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ConsolePinned}" Value="True"><Setter Property="Text" Value="&#xE77A;"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </ToggleButton>
      </StackPanel>

      <StackPanel HorizontalAlignment="Center" DataContext="{Binding SelectedFlavor}">
        <TextBlock Text="SHARE TO" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,0,0,8"
                   ToolTip="Where your moments go. Click to turn one on or off; set them up on Sharing."/>
        <ToggleButton IsChecked="{Binding DiscordOn}" AutomationProperties.Name="Discord posts">
          <ToggleButton.ToolTip>
            <TextBlock><Run Text="Discord posts for"/> <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=". Off pauses them, your webhooks stay. Set up on Sharing."/></TextBlock>
          </ToggleButton.ToolTip>
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DiscordOn}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
                <DataTrigger Binding="{Binding DiscordStep.Ok}" Value="False"><Setter Property="Tag" Value="warn"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;"/><TextBlock Style="{StaticResource Name}" Text="Discord"/></StackPanel>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding AnnounceGuild}" AutomationProperties.Name="Guild chat" Visibility="{Binding ShowGuildChat, Converter={StaticResource Visible}}"
                      ToolTip="Guild chat: a line as you when something happens. Reaches the game on /reload.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AnnounceGuild}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;"/><TextBlock Style="{StaticResource Name}" Text="Guild chat"/></StackPanel>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding AnnounceParty}" AutomationProperties.Name="Party and raid chat"
                      ToolTip="Party and raid chat: a line to your group. Reaches the game on /reload.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AnnounceParty}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE716;"/><TextBlock Style="{StaticResource Name}" Text="Group chat"/></StackPanel>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding Stream.Enabled}" AutomationProperties.Name="Stream overlay"
                      ToolTip="The stream overlay for OBS or Streamlabs (both games). Its address and looks are on Sharing.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Stream.Enabled}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE714;"/><TextBlock Style="{StaticResource Name}" Text="Stream"/></StackPanel>
        </ToggleButton>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
