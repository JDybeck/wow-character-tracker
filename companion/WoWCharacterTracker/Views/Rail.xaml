<!-- The rail on the right edge: quick switches for the places moments go (the selected game's Discord,
     guild and group chat, and the stream overlay), each with a dot (green on, grey off, amber needs
     something), then the console, which slides out over the page (MainWindow), and its pin.
     Their settings live on the Sharing page. DataContext: MainViewModel. -->
<UserControl x:Class="WoWCharacterTracker.Views.Rail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RailButton" TargetType="ButtonBase">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="ToolTipService.Placement" Value="Left"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Grid Width="40" Height="40">
              <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <Ellipse x:Name="Dot" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                       Fill="{StaticResource Faint}" Stroke="{DynamicResource CardHeader}" StrokeThickness="2" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <!-- Tag says what the dot shows: "off", "on" or "warn". -->
              <Trigger Property="Tag" Value="off">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Green}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="Tag" Value="warn">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="17"/>
    </Style>
  </UserControl.Resources>

  <Border Width="60" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
    <DockPanel Margin="0,124,0,18">
      <!-- The console and its pin, at the bottom. -->
      <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
        <Button x:Name="ConsoleButton" AutomationProperties.Name="Console" Command="{Binding ToggleConsoleCommand}"
                ToolTip="The console: what the app is doing. Hover or click to open.">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource RailButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ConsoleAlert}" Value="True"><Setter Property="Tag" Value="warn"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;"/>
        </Button>
        <ToggleButton IsChecked="{Binding ConsolePinned}" Style="{StaticResource RailButton}" Margin="0" AutomationProperties.Name="Keep the console open"
                      ToolTip="Keep the console open next to the rail">
          <TextBlock FontSize="13">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Text" Value="&#xE718;"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ConsolePinned}" Value="True"><Setter Property="Text" Value="&#xE77A;"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </ToggleButton>
      </StackPanel>

      <StackPanel HorizontalAlignment="Center" DataContext="{Binding SelectedFlavor}">
        <ToggleButton IsChecked="{Binding DiscordOn}" AutomationProperties.Name="Discord posts">
          <ToggleButton.ToolTip>
            <TextBlock><Run Text="Discord posts for"/> <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=". Off pauses them, your webhooks stay. Set up on Sharing."/></TextBlock>
          </ToggleButton.ToolTip>
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DiscordOn}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
                <DataTrigger Binding="{Binding DiscordStep.Ok}" Value="False"><Setter Property="Tag" Value="warn"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;"/>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding AnnounceGuild}" AutomationProperties.Name="Guild chat"
                      ToolTip="Guild chat: a line as you when something happens. Reaches the game on /reload.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AnnounceGuild}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;"/>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding AnnounceParty}" AutomationProperties.Name="Party and raid chat"
                      ToolTip="Party and raid chat: a line to your group. Reaches the game on /reload.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding AnnounceParty}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE716;"/>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding Stream.Enabled}" AutomationProperties.Name="Stream overlay"
                      ToolTip="The stream overlay for OBS or Streamlabs (both games). Its address and looks are on Sharing.">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RailButton}">
              <Setter Property="Tag" Value="off"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Stream.Enabled}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;"/>
        </ToggleButton>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
