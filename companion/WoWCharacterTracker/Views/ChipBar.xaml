<!-- A ChipFilter's chips (realms, rulesets) under a page's header, wrapping onto more lines when
     there are many, so they never push anything else away. Hidden with fewer than two choices. -->
<UserControl x:Class="WoWCharacterTracker.Views.ChipBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding HasChoices, Converter={StaticResource Visible}}">
  <DockPanel>
    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Top" Margin="0,6,10,0"/>
    <ListBox ItemsSource="{Binding Chips}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource GroupChipItem}"
             Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>
  </DockPanel>
</UserControl>
