<!-- The Overview tab of the character details: who the character is, tags, posting, highlights. -->
<UserControl x:Class="WoWCharacterTracker.Views.CharacterOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="28"/>
      <ColumnDefinition Width="1.3*"/>
    </Grid.ColumnDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource FactLabel}" Text="CHARACTER"/>
      <TextBlock Style="{StaticResource FactValue}" Text="{Binding Description}"/>
      <!-- Forever: the in-game portrait from the login check-in, or the standard one. -->
      <StackPanel Visibility="{Binding HasGamePortrait, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="PORTRAIT"/>
        <StackPanel Orientation="Horizontal">
          <CheckBox Style="{StaticResource OptionChip}" Content="In-game" IsChecked="{Binding UseGamePortrait}" Margin="0,0,6,0"
                    ToolTip="The portrait your character has in game, captured when you log in"/>
          <CheckBox Style="{StaticResource OptionChip}" Content="Standard" IsChecked="{Binding UseStandardPortrait}"
                    ToolTip="The standard portrait for your race"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding HasGuild, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="GUILD"/>
        <TextBlock Style="{StaticResource FactValue}" Text="{Binding Guild, StringFormat='&lt;{0}&gt;'}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource FactLabel}" Text="TOTAL PLAYED"/>
      <TextBlock Style="{StaticResource FactValue}" Text="{Binding PlayedText}"/>
      <TextBlock Style="{StaticResource FactLabel}" Text="GOLD"/>
      <ItemsControl ItemsSource="{Binding MoneyCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Row}"/>
      <StackPanel Visibility="{Binding HasCrests, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="CRESTS"/>
        <ItemsControl ItemsSource="{Binding CrestList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasKeystone, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="KEYSTONE"/>
        <TextBlock Style="{StaticResource FactValue}" Text="{Binding KeystoneText}" ToolTip="The Mythic Keystone in your bags, as of the last save or check-in"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasRatings, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="RATINGS"/>
        <ItemsControl ItemsSource="{Binding RatingChips}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource FactLabel}" Text="PROFESSIONS"/>
      <ItemsControl ItemsSource="{Binding ProfessionList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"
                    Visibility="{Binding HasProfessions, Converter={StaticResource Visible}}"/>
      <TextBlock Style="{StaticResource FactValue}" Text="None yet" Visibility="{Binding HasProfessions, Converter={StaticResource Hidden}}"/>
      <TextBlock Style="{StaticResource FactLabel}" Text="TALENTS"/>
      <TextBlock Style="{StaticResource FactValue}" Text="{Binding TalentsText}"/>
      <ItemsControl ItemsSource="{Binding TalentPickList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"
                    Margin="0,6,0,0" Visibility="{Binding HasTalentPicks, Converter={StaticResource Visible}}"/>
      <WrapPanel Margin="-12,2,0,0">
        <Button Style="{StaticResource GhostButton}" Padding="12,4"
                ToolTip="Open this build in Wowhead's talent calculator"
                Visibility="{Binding HasTalentLink, Converter={StaticResource Visible}}"
                Command="{Binding DataContext.OpenTalentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
            <TextBlock Text="Open in Wowhead talent calculator" FontSize="12" Foreground="{DynamicResource BlueText}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Padding="12,4"
                ToolTip="Post this character's talents to Discord: level, race and class, the points per tree, the talents picked and the Wowhead calculator link"
                Command="{Binding DataContext.PostTalentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
            <TextBlock Text="Post talents to Discord" FontSize="12" Foreground="{DynamicResource BlueText}"/>
          </StackPanel>
        </Button>
      </WrapPanel>
      <StackPanel Visibility="{Binding HasStats, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="STATS"/>
        <ItemsControl ItemsSource="{Binding StatChips}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource FactLabel}" Text="LAST ZONE"/>
      <StackPanel Orientation="Horizontal">
        <Image Source="{Binding ZoneIconUrl, Converter={StaticResource WebImage}}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
               ToolTip="{Binding ZoneKindName}" Visibility="{Binding ZoneIconUrl, Converter={StaticResource VisibleIfSet}}"/>
        <TextBlock Style="{StaticResource FactValue}" Text="{Binding ZoneText}"/>
      </StackPanel>
      <TextBlock Style="{StaticResource FactLabel}" Text="TAGS"/>
      <ItemsControl ItemsSource="{Binding TagOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ToggleOption}">
            <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Width="220" HorizontalAlignment="Left">
        <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" FontSize="12">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="New tag, then Enter (e.g. Main)" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding NewTag, Converter={StaticResource HiddenIfSet}}"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Style="{StaticResource ButtonBase}" Padding="12,6"
                ToolTip="Send a card with this character's info to Discord"
                Command="{Binding DataContext.PostCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,7,0"/>
            <TextBlock Text="Post to Discord" FontSize="12" Foreground="{StaticResource TextSoft}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ButtonBase}" Padding="8,6" Margin="6,0,0,0" ToolTip="Choose what the card shows"
                Command="{Binding DataContext.ToggleCardOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="12" Foreground="{StaticResource TextSoft}"/>
        </Button>
      </StackPanel>
      <Border Margin="0,10,0,0" Padding="12,10,6,6" CornerRadius="8" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Visibility="{Binding DataContext.ShowCardOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <TextBlock Text="The card shows:" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding DataContext.CardOptions, RelativeSource={RelativeSource AncestorType=Window}}" ItemsPanel="{StaticResource Wrap}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ToggleOption}">
                <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,6,0,0" Padding="12,5"
              ToolTip="Hide this character. Playing it again brings it back."
              Visibility="{Binding ConfirmRemove, Converter={StaticResource Hidden}}"
              Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource Red}" Margin="0,0,7,0"/>
          <TextBlock Text="Remove from list" FontSize="12" Foreground="{StaticResource Red}"/>
        </StackPanel>
      </Button>
      <!-- Asks right here instead of a Windows dialog. -->
      <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Hover}" BorderBrush="#80F87171" BorderThickness="1"
              Visibility="{Binding ConfirmRemove, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap">
            <Run Text="Remove"/> <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/><Run Text=" from the list? Playing it again brings it back."/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource ButtonBase}" Padding="12,5" Background="#7F1D1D" BorderBrush="#B91C1C" Margin="0,0,8,0"
                    Command="{Binding DataContext.RemoveCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <TextBlock Text="Yes, remove" FontSize="12" Foreground="White"/>
            </Button>
            <Button Style="{StaticResource ButtonBase}" Padding="12,5"
                    Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <TextBlock Text="Cancel" FontSize="12"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="2">
      <StackPanel Visibility="{Binding HasHighlights, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="HIGHLIGHTS"/>
        <ItemsControl ItemsSource="{Binding Highlights}" MaxHeight="420">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HighlightRow}">
              <Grid Margin="0,3,8,3" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="12"
                           Visibility="{Binding HasIcon, Converter={StaticResource Hidden}}"/>
                <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="16" Height="16" HorizontalAlignment="Left"
                       Visibility="{Binding HasIcon, Converter={StaticResource Visible}}"/>
                <StackPanel Grid.Column="1">
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Verb, Mode=OneWay}" Foreground="{StaticResource Text}"/><Run Text="{Binding Subject, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/>
                  </TextBlock>
                  <!-- Who was at the boss kill, what the death cost. -->
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,1,0,0"
                             Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Foreground="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Top"/>
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="6,0" Margin="4,0,0,0" ToolTip="Post this to Discord" VerticalAlignment="Top"
                        Command="{Binding DataContext.PostHighlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="11" Foreground="{StaticResource Dim}"/>
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>