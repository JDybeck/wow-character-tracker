<!-- The Overview tab of the character details. Left: who the character is (facts, professions, stats),
     then tags and posting. Right: what it has been doing and how it is built (highlights, talents,
     reputations), so neither column runs long while the other sits empty. -->
<UserControl x:Class="WoWCharacterTracker.Views.CharacterOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="28"/>
      <ColumnDefinition Width="1.3*"/>
    </Grid.ColumnDefinitions>

    <!-- Who the character is, then what is yours to do with it. -->
    <StackPanel>
      <TextBlock Style="{StaticResource FactLabel}" Text="CHARACTER"/>
      <TextBlock Style="{StaticResource FactValue}" Text="{Binding Description}"/>
      <Button Style="{StaticResource GhostButton}" Padding="12,4" Margin="-12,0,0,0" HorizontalAlignment="Left"
              ToolTip="{Binding ArmoryUrl}" Visibility="{Binding HasArmoryLink, Converter={StaticResource Visible}}"
              Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ArmoryUrl}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
          <TextBlock Text="Open in the armory" FontSize="12" Foreground="{DynamicResource BlueText}"/>
        </StackPanel>
      </Button>
      <!-- A friend's character (Friends page): who shared it. What's yours to change is left out below. -->
      <StackPanel Visibility="{Binding IsFriend, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="SHARED BY"/>
        <TextBlock Style="{StaticResource FactValue}" Text="{Binding FriendName}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasGuild, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="GUILD"/>
        <TextBlock Style="{StaticResource FactValue}" Text="{Binding Guild, StringFormat='&lt;{0}&gt;'}"/>
      </StackPanel>
      <!-- The short facts side by side instead of one per line. -->
      <WrapPanel>
        <StackPanel Margin="0,0,32,0" MinWidth="110" Visibility="{Binding IsOwn, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource FactLabel}" Text="TOTAL PLAYED"/>
          <TextBlock Style="{StaticResource FactValue}" Text="{Binding PlayedText}"/>
        </StackPanel>
        <StackPanel Margin="0,0,32,0" MinWidth="110" Visibility="{Binding ShowsGold, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource FactLabel}" Text="GOLD"/>
          <ItemsControl ItemsSource="{Binding MoneyCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Wrap}"/>
        </StackPanel>
        <StackPanel Margin="0,0,32,0" MinWidth="110" MaxWidth="260">
          <TextBlock Style="{StaticResource FactLabel}" Text="LAST ZONE"/>
          <DockPanel>
            <Image Source="{Binding ZoneIconUrl, Converter={StaticResource WebImage}}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Top"
                   ToolTip="{Binding ZoneKindName}" Visibility="{Binding ZoneIconUrl, Converter={StaticResource VisibleIfSet}}"/>
            <TextBlock Style="{StaticResource FactValue}" Text="{Binding ZoneText}"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Margin="0,0,32,0" MinWidth="110" Visibility="{Binding HasKeystone, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource FactLabel}" Text="KEYSTONE"/>
          <TextBlock Style="{StaticResource FactValue}" Text="{Binding KeystoneText}" ToolTip="The Mythic Keystone in your bags, as of the last save or check-in"/>
        </StackPanel>
      </WrapPanel>
      <!-- Forever: the in-game portrait from the login check-in (a friend's: the armory picture), or the standard one. -->
      <StackPanel Visibility="{Binding HasGamePortrait, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="PORTRAIT"/>
        <WrapPanel>
          <CheckBox Style="{StaticResource OptionChip}" Content="In-game" IsChecked="{Binding UseGamePortrait}" Margin="0,0,6,0"
                    ToolTip="The portrait your character has in game, captured when you log in" Visibility="{Binding IsOwn, Converter={StaticResource Visible}}"/>
          <CheckBox Style="{StaticResource OptionChip}" Content="HD" IsChecked="{Binding UseArmoryHd}" Margin="0,0,6,0"
                    ToolTip="The armory picture with the new character models, for this character only. The HD/SD switch at the top sets it for all"
                    Visibility="{Binding IsFriend, Converter={StaticResource Visible}}"/>
          <CheckBox Style="{StaticResource OptionChip}" Content="SD" IsChecked="{Binding UseArmorySd}" Margin="0,0,6,0"
                    ToolTip="The armory picture with the old character models, for this character only. The HD/SD switch at the top sets it for all"
                    Visibility="{Binding IsFriend, Converter={StaticResource Visible}}"/>
          <CheckBox Style="{StaticResource OptionChip}" Content="Standard" IsChecked="{Binding UseStandardPortrait}"
                    ToolTip="The standard portrait for the race"/>
        </WrapPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding ShowsProfessions, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="PROFESSIONS"/>
        <ItemsControl ItemsSource="{Binding RecipeProfessions}" ItemTemplate="{StaticResource ProfessionChipTemplate}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                      Visibility="{Binding HasProfessions, Converter={StaticResource Visible}}"/>
        <TextBlock Style="{StaticResource FactValue}" Text="None yet" Visibility="{Binding HasProfessions, Converter={StaticResource Hidden}}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasCrests, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="CRESTS"/>
        <ItemsControl ItemsSource="{Binding CrestList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasRatings, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="RATINGS"/>
        <ItemsControl ItemsSource="{Binding RatingChips}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding HasStats, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="STATS"/>
        <ItemsControl ItemsSource="{Binding StatChips}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"/>
      </StackPanel>
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,4"/>
      <!-- Yours only: tags, posting, removing and exporting. -->
      <StackPanel Visibility="{Binding IsOwn, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource FactLabel}" Text="TAGS"/>
      <ItemsControl ItemsSource="{Binding TagOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ToggleOption}">
            <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"
                      ToolTip="Put this tag on the character, or take it off. Discord webhooks can filter on tags."/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Width="220" HorizontalAlignment="Left">
        <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" FontSize="12"
                 ToolTip="Type a new tag and press Enter to add it to this character">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Text="New tag, then Enter (e.g. Main)" Foreground="{StaticResource Dim}" FontSize="12" Margin="10,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding NewTag, Converter={StaticResource HiddenIfSet}}"/>
      </Grid>
      <WrapPanel Margin="0,16,0,0">
        <Button Style="{StaticResource ButtonBase}" Padding="12,6"
                ToolTip="Send a card with this character's info to Discord"
                Command="{Binding DataContext.PostCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,7,0"/>
            <TextBlock Text="Post to Discord" FontSize="12" Foreground="{StaticResource TextSoft}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ButtonBase}" Padding="8,6" Margin="6,0,0,0" ToolTip="Choose what the card shows"
                Command="{Binding DataContext.ToggleCardOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="12" Foreground="{StaticResource TextSoft}"/>
        </Button>
      </WrapPanel>
      <Border Margin="0,10,0,0" Padding="12,10,6,6" CornerRadius="8" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Visibility="{Binding DataContext.ShowCardOptions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <TextBlock Text="The card shows:" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding DataContext.CardOptions, RelativeSource={RelativeSource AncestorType=Window}}" ItemsPanel="{StaticResource Wrap}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ToggleOption}">
                <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"
                          ToolTip="Show or hide this on the Discord card"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <WrapPanel Margin="-12,6,0,0" Visibility="{Binding ConfirmRemove, Converter={StaticResource Hidden}}">
        <Button Style="{StaticResource GhostButton}" Padding="12,5"
                ToolTip="Hide this character. Playing it again brings it back."
                Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource Red}" Margin="0,0,7,0"/>
            <TextBlock Text="Remove from list" FontSize="12" Foreground="{StaticResource Red}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Padding="12,5"
                ToolTip="Stop tracking this character: nothing is posted, announced or shared with friends for it, and it leaves the list. Ignored, under the list, tracks it again."
                Command="{Binding DataContext.IgnoreCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F8;" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,7,0"/>
            <TextBlock Text="Ignore tracking" FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
        </Button>
        <!-- Armory proof of concept (ArmoryExport), kept quiet on purpose. -->
        <Button Style="{StaticResource GhostButton}" Padding="12,5"
                ToolTip="Preview: save this character as a JSON file to share on an armory site. Gold, last zone, notes, tags, bags and bank are left out."
                Command="{Binding DataContext.ExportCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,7,0"/>
            <TextBlock Text="Export as JSON" FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
        </Button>
      </WrapPanel>
      <!-- Asks right here instead of a Windows dialog. -->
      <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Hover}" BorderBrush="#80F87171" BorderThickness="1"
              Visibility="{Binding ConfirmRemove, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap">
            <Run Text="Remove"/> <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/><Run Text=" from the list? Playing it again brings it back."/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource ButtonBase}" Padding="12,5" Background="#7F1D1D" BorderBrush="#B91C1C" Margin="0,0,8,0"
                    ToolTip="Hide this character from the list"
                    Command="{Binding DataContext.RemoveCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <TextBlock Text="Yes, remove" FontSize="12" Foreground="White"/>
            </Button>
            <Button Style="{StaticResource ButtonBase}" Padding="12,5" ToolTip="Keep the character"
                    Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <TextBlock Text="Cancel" FontSize="12"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      </StackPanel>
      <!-- A friend's character: their main (leads their card and list) or hidden from the Friends page. Only here, nothing is sent. -->
      <WrapPanel Margin="-12,12,0,0" Visibility="{Binding IsFriend, Converter={StaticResource Visible}}">
        <Button Style="{StaticResource GhostButton}" Padding="12,5" ToolTip="Show this character on their card at the top and first in their list. Only for you, nothing is sent."
                Visibility="{Binding IsFriendMain, Converter={StaticResource Hidden}}"
                Command="{Binding DataContext.SelectedFlavor.Friends.MainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,7,0"/>
            <TextBlock Text="Set as their main" FontSize="12" Foreground="{DynamicResource BlueText}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Padding="12,5" ToolTip="Their card and list go back to the character they played last"
                Visibility="{Binding IsFriendMain, Converter={StaticResource Visible}}"
                Command="{Binding DataContext.SelectedFlavor.Friends.NotMainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="12" Foreground="#FACC15" Margin="0,0,7,0"/>
            <TextBlock Text="Their main, click to unset" FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Padding="12,5" ToolTip="Hide this character on the Friends page. Nothing is sent to your friend."
                Visibility="{Binding IsHiddenFriend, Converter={StaticResource Hidden}}"
                Command="{Binding DataContext.SelectedFlavor.Friends.HideCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xED1A;" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,7,0"/>
            <TextBlock Text="Hide" FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Padding="12,5" ToolTip="Show this character on the Friends page again"
                Visibility="{Binding IsHiddenFriend, Converter={StaticResource Visible}}"
                Command="{Binding DataContext.SelectedFlavor.Friends.UnhideCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,7,0"/>
            <TextBlock Text="Show again" FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>

    <!-- What the character has been doing and how it is built. -->
    <StackPanel Grid.Column="2">
      <StackPanel Margin="0,0,0,10" Visibility="{Binding HasHighlights, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="HIGHLIGHTS"/>
        <ItemsControl ItemsSource="{Binding RecentHighlights}" ItemTemplate="{StaticResource HighlightRowTemplate}"/>
        <!-- The rest are on the Highlights tab. -->
        <Button Style="{StaticResource GhostButton}" Padding="12,4" Margin="-12,4,0,0" HorizontalAlignment="Left"
                ToolTip="Every highlight this character has, on the Highlights tab"
                Visibility="{Binding HasMoreHighlights, Converter={StaticResource Visible}}" Command="{Binding ShowHighlightsCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding AllHighlightsText}" FontSize="12" Foreground="{DynamicResource BlueText}"/>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource BlueText}" Margin="6,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <!-- Forever dual spec: the switch shows the other build in place of the active one. -->
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource FactLabel}" Text="{Binding TalentsLabel}"/>
        <Button Style="{StaticResource GhostButton}" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Bottom"
                ToolTip="Switch between your two dual spec builds"
                Visibility="{Binding HasOtherSpec, Converter={StaticResource Visible}}" Command="{Binding SwitchSpecCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="11" Foreground="{DynamicResource BlueText}" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding SwitchSpecText}" FontSize="11" Foreground="{DynamicResource BlueText}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Visibility="{Binding ShowsActiveTalents, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource FactValue}" Text="{Binding TalentsText}"/>
      <ItemsControl ItemsSource="{Binding TalentPickList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"
                    Margin="0,6,0,0" Visibility="{Binding HasTalentPicks, Converter={StaticResource Visible}}"/>
      <WrapPanel Margin="-12,2,0,0">
        <Button Style="{StaticResource GhostButton}" Padding="12,4"
                ToolTip="Open this build in Wowhead's talent calculator"
                Visibility="{Binding HasTalentLink, Converter={StaticResource Visible}}"
                Command="{Binding DataContext.OpenTalentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
            <TextBlock Text="Open in Wowhead talent calculator" FontSize="12" Foreground="{DynamicResource BlueText}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Padding="12,4" Visibility="{Binding IsOwn, Converter={StaticResource Visible}}"
                ToolTip="Post this character's talents to Discord: level, race and class, the points per tree, the talents picked and the Wowhead calculator link"
                Command="{Binding DataContext.PostTalentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
            <TextBlock Text="Post talents to Discord" FontSize="12" Foreground="{DynamicResource BlueText}"/>
          </StackPanel>
        </Button>
      </WrapPanel>
      </StackPanel>
      <!-- The build that isn't active, as read from the saved file. -->
      <StackPanel DataContext="{Binding OtherSpec}" Visibility="{Binding DataContext.ShowOtherSpec, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactValue}" Text="{Binding Talents}"/>
        <ItemsControl ItemsSource="{Binding TalentPickList}" ItemTemplate="{StaticResource IconChipTemplate}" ItemsPanel="{StaticResource Wrap}"
                      Margin="0,6,0,0" Visibility="{Binding HasTalentPicks, Converter={StaticResource Visible}}"/>
        <WrapPanel Margin="-12,2,0,0">
          <Button Style="{StaticResource GhostButton}" Padding="12,4"
                  ToolTip="Open this build in Wowhead's talent calculator"
                  Visibility="{Binding HasTalentLink, Converter={StaticResource Visible}}"
                  Command="{Binding DataContext.OpenTalentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
              <TextBlock Text="Open in Wowhead talent calculator" FontSize="12" Foreground="{DynamicResource BlueText}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource GhostButton}" Padding="12,4" Visibility="{Binding Owner.IsOwn, Converter={StaticResource Visible}}"
                  ToolTip="Post this build to Discord: level, race and class, the points per tree, the talents picked and the Wowhead calculator link"
                  Command="{Binding DataContext.PostTalentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,6,0"/>
              <TextBlock Text="Post talents to Discord" FontSize="12" Foreground="{DynamicResource BlueText}"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
      <!-- Factions and standings, renown first, then the highest (the addon's Reputation.lua). -->
      <StackPanel Margin="0,10,0,0" Visibility="{Binding HasReputations, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource FactLabel}" Text="REPUTATIONS"/>
        <ItemsControl ItemsSource="{Binding ReputationsShown}" Focusable="False" MaxWidth="420" HorizontalAlignment="Left">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ReputationRow}">
              <Grid Margin="0,0,0,4" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding StandingText}" FontSize="11" Foreground="{Binding Brush}"/>
                  <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding Brush}"
                               Background="#26FFFFFF" BorderThickness="0" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource GhostButton}" Padding="12,4" Margin="-12,0,0,0" HorizontalAlignment="Left"
                Visibility="{Binding HasMoreReputations, Converter={StaticResource Visible}}" Command="{Binding ShowAllReputationsCommand}">
          <TextBlock Text="{Binding MoreReputationsText}" FontSize="12" Foreground="{DynamicResource BlueText}"/>
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>