<!-- The Friends page: what Battle.net friends shared (FriendsViewModel), a chip per friend, and the
     sharing settings. DataContext: the game tab (FlavorViewModel); MainWindow has one per tab. -->
<UserControl x:Class="WoWCharacterTracker.Views.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:views="clr-namespace:WoWCharacterTracker.Views">
  <UserControl.Resources>
    <!-- A friend's open character: Overview (read-only) and Gear, like your own. -->
    <DataTemplate x:Key="FriendDetails" DataType="{x:Type vm:CharacterRow}">
      <Border Margin="24,0,24,16" Padding="18,2,18,16" CornerRadius="10" Background="#660F172A" BorderBrush="{DynamicResource Line}" BorderThickness="1" ui:Motion.Reveal="True">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
            <RadioButton Style="{StaticResource DetailTab}" Content="Overview" ToolTip="Who the character is and what your friend shares" IsChecked="{Binding IsOverviewTab}" GroupName="{Binding Guid}"/>
            <RadioButton Style="{StaticResource DetailTab}" Content="Gear" ToolTip="What they wear, when they share gear" IsChecked="{Binding IsGearTab}" GroupName="{Binding Guid}"/>
            <RadioButton Style="{StaticResource DetailTab}" Content="Leveling" ToolTip="Their level times, when they share them" IsChecked="{Binding IsLevelingTab}" GroupName="{Binding Guid}"/>
          </StackPanel>
          <ContentControl Content="{Binding}" Focusable="False">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate">
                  <Setter.Value>
                    <DataTemplate><views:CharacterOverview ui:Motion.FadeIn="True"/></DataTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DetailTab}" Value="gear">
                    <Setter Property="ContentTemplate">
                      <Setter.Value>
                        <DataTemplate><views:CharacterGear ui:Motion.FadeIn="True"/></DataTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DetailTab}" Value="leveling">
                    <Setter Property="ContentTemplate">
                      <Setter.Value>
                        <DataTemplate><views:CharacterLeveling ui:Motion.FadeIn="True"/></DataTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorder}" ClipToBounds="True" ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="6"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=friends}">
    <Grid DataContext="{Binding Friends}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="35,12,35,12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Padding="12,6" VerticalAlignment="Top" Command="{Binding ToggleSettingsCommand}"
                  ToolTip="Who you share with, what they get, and which of your characters">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,7,0"/>
              <TextBlock FontSize="12" Foreground="{StaticResource TextSoft}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Sharing settings"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowSettings}" Value="True"><Setter Property="Text" Value="Back to friends"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Top" Command="{Binding ToggleProfessionsCommand}"
                  ToolTip="Friends' professions by friend, server and faction">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,7,0"/>
              <TextBlock FontSize="12" Foreground="{StaticResource TextSoft}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Professions"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowProfessions}" Value="True"><Setter Property="Text" Value="Back to friends"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
          <StackPanel Margin="0,0,16,0">
            <views:ChipBar DataContext="{Binding Contacts}"/>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="What friends share reaches the app on your next /reload or logout. To get it fresh, type /wct friends ask &lt;BattleTag&gt; in game."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Friends' characters -->
      <Grid Grid.Row="1" Visibility="{Binding ShowCharacters, Converter={StaticResource Visible}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="CharacterList" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CharacterItem}" Padding="0,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
          <!-- A header per friend (FriendsPage groups by FriendName): their name and when their newest
               character was seen (the rows come newest first). -->
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate DataType="{x:Type CollectionViewGroup}">
                  <Border Margin="23,12,23,4" Padding="0,0,0,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <TextBlock FontSize="13">
                      <Run Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                      <Run Text="   "/>
                      <Run Text="last seen" Foreground="{StaticResource Dim}"/>
                      <Run Text="{Binding Items[0].LastSeenText, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CharacterRow}">
              <StackPanel>
                <views:CharacterRowView/>
                <ContentControl Focusable="False">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Content" Value="{x:Null}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter Property="Content" Value="{Binding}"/>
                          <Setter Property="ContentTemplate" Value="{StaticResource FriendDetails}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="1" Style="{StaticResource GhostButton}" Padding="12,6" Margin="23,0,0,10" HorizontalAlignment="Left"
                Command="{Binding ToggleHiddenCommand}" Visibility="{Binding HasHidden, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding HiddenText}" FontSize="12" Foreground="{StaticResource Dim}"/>
        </Button>
        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Visibility="{Binding HasFriends, Converter={StaticResource Hidden}}">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
          <TextBlock Text="Nothing from friends yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
          <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Battle.net friends who have the addon can share their characters with you. Type /wct friends ask &lt;BattleTag&gt; in game while they're online: they get a popup, and once they allow it their characters show up here."/>
        </StackPanel>
      </Grid>

      <!-- Friends' professions, by friend -->
      <Border Grid.Row="1" Padding="0,4,0,0" Visibility="{Binding ShowProfessions, Converter={StaticResource Visible}}">
        <views:ProfessionsView DataContext="{Binding Professions}"/>
      </Border>

      <!-- Sharing settings -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSettings, Converter={StaticResource Visible}}">
        <StackPanel Margin="35,10,35,20">
          <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="These are the same settings as in game. Changes here reach the game on your next /reload. If you also change something in game before that, the newest change wins as a whole."/>
          <TextBlock Style="{StaticResource FactLabel}" Text="SHARING"/>
          <WrapPanel>
            <CheckBox Style="{StaticResource OptionChip}" Content="Share with friends" IsChecked="{Binding Enabled}" Margin="0,0,6,6"
                      ToolTip="On: friends can ask, and only what you allow is shared. Off: no requests, nothing sent or kept."/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Share new characters" IsChecked="{Binding NewChars}" Margin="0,0,6,6"
                      ToolTip="Characters you haven't shared or hidden yet"/>
          </WrapPanel>

          <TextBlock Style="{StaticResource FactLabel}" Text="WHAT FRIENDS GET"/>
          <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="Name, level, class, spec and item level always. The rest for all friends, unless you set it for one of them below."/>
          <WrapPanel>
            <CheckBox Style="{StaticResource OptionChip}" Content="Gear" IsChecked="{Binding ShareGear}" Margin="0,0,6,6"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Talents" IsChecked="{Binding ShareTalents}" Margin="0,0,6,6"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Location" IsChecked="{Binding ShareLocation}" Margin="0,0,6,6" ToolTip="The zone you're in"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Professions" IsChecked="{Binding ShareProfessions}" Margin="0,0,6,6" ToolTip="Each profession with its skill"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Highlights" IsChecked="{Binding ShareHighlights}" Margin="0,0,6,6"
                      ToolTip="Each character's newest 10 boss kills, rare loot, mounts, duels, milestones and deaths. Who was in your group stays with you"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Level times" IsChecked="{Binding ShareLeveling}" Margin="0,0,6,6"
                      ToolTip="How long each level took, played time and the XP bar, so they can follow your leveling"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Gold" IsChecked="{Binding ShareGold}" Margin="0,0,6,6" ToolTip="Off until you turn it on"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Map position" IsChecked="{Binding ShareMap}" Margin="0,0,6,6"
                      ToolTip="Your spot on their world map, while they have it open. Off until you turn it on"/>
          </WrapPanel>

          <TextBlock Style="{StaticResource FactLabel}" Text="MAP POSITION"/>
          <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="Only for friends who get Map position. It goes out only while a friend has their world map open, and never from a dungeon, raid or battleground."/>
          <WrapPanel>
            <CheckBox Style="{StaticResource OptionChip}" Content="Show to the other faction" IsChecked="{Binding ShareOtherFaction}" Margin="0,0,6,6"
                      ToolTip="Off: a friend playing the other faction doesn't see you on the map"/>
          </WrapPanel>
          <!-- No GroupName: both game tabs have this page, and radio buttons group by their panel without one. -->
          <WrapPanel>
            <RadioButton Style="{StaticResource ChoiceChip}" Margin="0,0,6,6" Content="Live" IsChecked="{Binding IsMapLive, Mode=OneWay}"
                         Command="{Binding MapRateCommand}" CommandParameter="5" ToolTip="Every few seconds while they look"/>
            <RadioButton Style="{StaticResource ChoiceChip}" Margin="0,0,6,6" Content="Every minute" IsChecked="{Binding IsMapMinute, Mode=OneWay}"
                         Command="{Binding MapRateCommand}" CommandParameter="60"/>
            <RadioButton Style="{StaticResource ChoiceChip}" Margin="0,0,6,6" Content="Every 5 minutes" IsChecked="{Binding IsMapFiveMinutes, Mode=OneWay}"
                         Command="{Binding MapRateCommand}" CommandParameter="300"/>
          </WrapPanel>

          <TextBlock Style="{StaticResource FactLabel}" Text="FRIENDS"/>
          <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                     Text="Each friend gets what all friends get, unless you click a chip to set it just for them. Add friends in game: /wct friends share or ask &lt;BattleTag&gt;."/>
          <ItemsControl ItemsSource="{Binding ContactRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:FriendContactRow}">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8" Padding="12,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="230"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock Text="{Binding SeenText}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding VersionText}" FontSize="11" Margin="0,1,0,0" Visibility="{Binding VersionText, Converter={StaticResource VisibleIfSet}}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsUpdate}" Value="True"><Setter Property="Foreground" Value="{StaticResource Red}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Grid Width="200" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBox x:Name="NicknameBox" Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}" Padding="8,3" FontSize="12" ToolTip="A name of your own for this friend, shown here and in game"/>
                        <TextBlock Text="Nickname" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=NicknameBox, Converter={StaticResource HiddenIfSet}}"/> <!-- follows what is typed, not the saved name (saved when you leave the box) -->
                      </Grid>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                      <CheckBox Style="{StaticResource OptionChip}" Content="You share" IsChecked="{Binding YouShare}" Margin="0,0,6,6" ToolTip="They get your shared characters"/>
                      <CheckBox Style="{StaticResource OptionChip}" Content="Keep theirs" IsChecked="{Binding Receive}" Margin="0,0,18,6" ToolTip="What they share shows up here"/>
                      <ItemsControl ItemsSource="{Binding Categories}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:CategoryChip}">
                            <Button Margin="0,0,6,6" Content="{Binding Text}" ToolTip="Click to switch: like all friends, on, off"
                                    Command="{Binding DataContext.CycleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                  <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="on"><Setter Property="Foreground" Value="{DynamicResource BlueText}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="off"><Setter Property="Foreground" Value="{StaticResource Red}"/></DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource FactLabel}" Text="YOUR CHARACTERS"/>
          <ItemsControl ItemsSource="{Binding OwnCharacters}" ItemsPanel="{StaticResource Wrap}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:OwnCharacterShare}">
                <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsShared}" Margin="0,0,6,6"
                          ToolTip="Ticked: friends get this character"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Visibility="{Binding HasBlocked, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource FactLabel}" Text="BLOCKED"/>
            <ItemsControl ItemsSource="{Binding Blocked}" ItemsPanel="{StaticResource Wrap}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,6" ToolTip="Let them ask again"
                          Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,8,0"/>
                      <TextBlock Text="Unblock" FontSize="12" Foreground="{DynamicResource BlueText}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
