<!-- The Items page: everything the tab's characters carry, searchable, per server. -->
<UserControl x:Class="WoWCharacterTracker.Views.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <UserControl.Resources>
    <!-- A server header between the items. -->
    <DataTemplate DataType="{x:Type vm:ItemHeader}">
      <StackPanel Orientation="Horizontal" Margin="24,14,24,6">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,0,7,0"/>
        <TextBlock Text="{Binding Realm}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <!-- An item: icon in its quality color, name, total, and who has it where. -->
    <DataTemplate DataType="{x:Type vm:ItemRow}">
      <Grid Margin="24,3" Background="Transparent" ToolTip="{Binding Info.Tooltip}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Info.Brush}" Background="#33000000" Margin="0,0,10,0">
          <Image Source="{Binding Info.IconUrl}" Margin="1"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontSize="13">
            <Run Text="{Binding Info.Name, Mode=OneWay}" Foreground="{Binding Info.Brush, Mode=OneWay}"/>
            <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Places}" Margin="0,1,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ItemPlace}">
                <TextBlock FontSize="11" Margin="0,0,14,0">
                  <Run Text="{Binding Character, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/><Run Text=": " Foreground="{StaticResource Dim}"/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorder}" ClipToBounds="True" DataContext="{Binding SelectedFlavor.Items}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="24,12">
        <DockPanel>
          <ListBox DockPanel.Dock="Right" ItemsSource="{Binding Realms}" SelectedItem="{Binding SelectedRealm}" ItemContainerStyle="{StaticResource GroupChipItem}"
                   Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="12,0,0,0"
                   Visibility="{Binding HasRealms, Converter={StaticResource Visible}}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <Grid>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="17,7,10,7"/>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Dim}" FontSize="13" Margin="12,0,0,0" IsHitTestVisible="False"/>
            <TextBlock Text="Search items on all your characters" Foreground="{StaticResource Faint}" FontSize="13" Margin="34,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource HiddenIfSet}}"/>
          </Grid>
        </DockPanel>
      </Border>

      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" Padding="0,0,0,12">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                  Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
