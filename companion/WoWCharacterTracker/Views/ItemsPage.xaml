<!-- The Items page: everything the tab's characters carry, searchable, per server. -->
<UserControl x:Class="WoWCharacterTracker.Views.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <UserControl.Resources>
    <!-- A server's header. -->
    <DataTemplate DataType="{x:Type vm:ItemHeader}">
      <StackPanel Margin="0,14,0,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,0,7,0"/>
          <TextBlock Text="{Binding Realm}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <!-- When each character's bags were last saved, and where. -->
        <ItemsControl ItemsSource="{Binding Saved}" Margin="19,3,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ItemPlace}">
              <TextBlock FontSize="11" Margin="0,0,14,0">
                <Run Text="{Binding Character, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/><Run Text=": " Foreground="{StaticResource Dim}"/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <!-- An item: icon in its quality color, name, total, and who has it where. -->
    <DataTemplate DataType="{x:Type vm:ItemRow}">
      <Grid Width="330" Margin="0,3,14,3" Background="Transparent" Cursor="Hand" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
        <Grid.ToolTip>
          <ToolTip Style="{DynamicResource BareToolTip}">
            <ui:WowTooltip Html="{Binding Info.Html}" Text="{Binding Info.Tooltip}"/>
          </ToolTip>
        </Grid.ToolTip>
        <Grid.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Info.Url}"/>
        </Grid.InputBindings>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Info.Brush}" Background="#33000000" Margin="0,0,10,0">
          <Image Source="{Binding Info.IconUrl, Converter={StaticResource WebImage}}" Margin="1"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Info.Name, Mode=OneWay}" Foreground="{Binding Info.Brush, Mode=OneWay}"/>
            <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Places}" Margin="0,1,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ItemPlace}">
                <TextBlock FontSize="11" Margin="0,0,14,0">
                  <Run Text="{Binding Character, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/><Run Text=": " Foreground="{StaticResource Dim}"/><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorder}" ClipToBounds="True" DataContext="{Binding Items}"> <!-- the page's DataContext is its game tab -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="24,12">
        <DockPanel>
          <ListBox DockPanel.Dock="Right" ItemsSource="{Binding Realms}" SelectedItem="{Binding SelectedRealm}" ItemContainerStyle="{StaticResource GroupChipItem}"
                   Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="12,0,0,0"
                   Visibility="{Binding HasRealms, Converter={StaticResource Visible}}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <Grid>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="17,7,10,7"/>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Dim}" FontSize="13" Margin="12,0,0,0" IsHitTestVisible="False"/>
            <TextBlock Text="Search items on all your characters" Foreground="{StaticResource Faint}" FontSize="13" Margin="34,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource HiddenIfSet}}"/>
          </Grid>
        </DockPanel>
      </Border>
      <!-- Where to look, and when this list changes. -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
            <ListBox ItemsSource="{Binding PlaceChips}" SelectedItem="{Binding SelectedPlace}" ItemContainerStyle="{StaticResource GroupChipItem}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
            <!-- What kind of item (from the game's item class, saved by the addon). -->
            <ListBox ItemsSource="{Binding KindChips}" SelectedItem="{Binding SelectedKind}" ItemContainerStyle="{StaticResource GroupChipItem}"
                     Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </StackPanel>
          <TextBlock Text="Items may not be up to date: they update when you /reload or log out (the game only saves then), and the bank when you open it. Each server shows when every character was last saved."
                     Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Right" Margin="16,0,0,0"/>
        </DockPanel>
      </Border>

      <!-- Each server: its header, then its items in as many columns as the window has room for. -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,10,12">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ItemGroup}">
              <StackPanel>
                <ContentPresenter Content="{Binding Header}"/>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                  Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
