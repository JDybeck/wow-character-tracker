<!-- Professions by server and faction, each with its characters (ProfessionsViewModel). Used by the
     Professions page for your characters and by the Friends page for friends' (with a heading per friend).
     A character with recipes opens them in a window like the game's (RecipeBookView); the search on top
     finds who knows a recipe. -->
<UserControl x:Class="WoWCharacterTracker.Views.ProfessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:views="clr-namespace:WoWCharacterTracker.Views"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <UserControl.Resources>
    <!-- A character: name in its class color, level, how many recipes, skill/max and a bar to the max.
         With recipes known, a click opens them. -->
    <DataTemplate x:Key="CharacterLine" DataType="{x:Type vm:ProfessionCharacter}">
      <Border x:Name="Line" Margin="-6,0,-6,0" Padding="6,3" CornerRadius="4" Background="Transparent">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="64"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding ClassBrush, Mode=OneWay}"/>
              <Run Text="{Binding Level, Mode=OneWay}" Foreground="{StaticResource Dim}" FontSize="11"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HasRecipes, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,5,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="Count" Text="{Binding RecipeCountText}" FontSize="11" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding SkillText}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="10,0,8,0" VerticalAlignment="Center"/>
          <Border Grid.Column="2" Height="5" CornerRadius="2.5" Background="#26FFFFFF" VerticalAlignment="Center"
                  Visibility="{Binding HasMax, Converter={StaticResource Visible}}">
            <Border CornerRadius="2.5" Background="{DynamicResource Indigo}" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding Fraction}"/>
              </Border.RenderTransform>
            </Border>
          </Border>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasRecipes}" Value="True">
          <Setter TargetName="Line" Property="Cursor" Value="Hand"/>
          <Setter TargetName="Line" Property="ToolTip" Value="Show the recipes"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasRecipes}" Value="True"/>
            <Condition Binding="{Binding IsMouseOver, ElementName=Line}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Line" Property="Background" Value="{DynamicResource Hover}"/>
          <Setter TargetName="Count" Property="Foreground" Value="{StaticResource Text}"/>
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A profession: its icon and name, then its characters. -->
    <DataTemplate x:Key="ProfessionCard" DataType="{x:Type vm:ProfessionGroup}">
      <Border Style="{StaticResource PanelBorder}" Width="280" Padding="12,10" Margin="0,0,10,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="18" Height="18" Margin="0,0,7,0"
                   Visibility="{Binding IconUrl, Converter={StaticResource VisibleIfSet}}"/>
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Characters}" ItemTemplate="{StaticResource CharacterLine}" Focusable="False"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A server and faction: its heading, then its professions side by side. -->
    <DataTemplate x:Key="RealmSection" DataType="{x:Type vm:ProfessionRealm}">
      <StackPanel Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Image Source="{Binding FactionCrestUrl, Converter={StaticResource WebImage}}" Width="16" Height="16" Margin="0,0,7,0"
                 Visibility="{Binding FactionCrestUrl, Converter={StaticResource VisibleIfSet}}"/>
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Professions}" ItemTemplate="{StaticResource ProfessionCard}" ItemsPanel="{StaticResource Wrap}" Focusable="False"/>
      </StackPanel>
    </DataTemplate>

    <!-- Someone who knows a searched recipe: name in class color, the friend, the profession's skill. A click opens their recipes on it. -->
    <DataTemplate x:Key="Knower" DataType="{x:Type vm:RecipeHitKnower}">
      <Button Style="{StaticResource SmallButton}" Margin="0,0,6,4" CommandParameter="{Binding}" ToolTip="Open their recipes"
              Command="{Binding DataContext.OpenHitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <TextBlock FontSize="12">
          <Run Text="{Binding Line.Name, Mode=OneWay}" Foreground="{Binding Line.ClassBrush, Mode=OneWay}"/>
          <Run Text="{Binding OwnerText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
          <Run Text="{Binding Line.SkillText, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
        </TextBlock>
      </Button>
    </DataTemplate>

    <!-- A searched recipe: icon and name (Wowhead's tooltip on hover), then who knows it. -->
    <DataTemplate x:Key="Hit" DataType="{x:Type vm:RecipeHit}">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="34" Height="34" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="#33000000" Margin="0,0,10,0"
                VerticalAlignment="Top" ui:ItemTip.Info="{Binding Recipe}">
          <Image Source="{Binding Recipe.IconUrl, Converter={StaticResource WebImage}}" Margin="1"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Recipe.Name}" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,4" HorizontalAlignment="Left"
                     Background="Transparent" ui:ItemTip.Info="{Binding Recipe}"/>
          <ItemsControl ItemsSource="{Binding Knowers}" ItemTemplate="{StaticResource Knower}" ItemsPanel="{StaticResource Wrap}" Focusable="False"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Find a recipe: who knows it. -->
    <Grid Margin="24,14,24,0" MaxWidth="520" HorizontalAlignment="Left" Visibility="{Binding HasRecipes, Converter={StaticResource Visible}}">
      <TextBox ToolTip="Find a recipe and who knows it" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="17,7,30,7" MinWidth="360"/>
      <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Dim}" FontSize="13" Margin="12,0,0,0" IsHitTestVisible="False"/>
      <TextBlock Text="Find a recipe and who knows it" Foreground="{StaticResource Faint}" FontSize="13" Margin="34,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Query, Converter={StaticResource HiddenIfSet}}"/>
      <Button Style="{StaticResource GhostButton}" Padding="6,2" Margin="0,0,4,0" HorizontalAlignment="Right" ToolTip="Clear"
              Command="{Binding ClearSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
      </Button>
    </Grid>

    <!-- The professions as cards. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,14,14" Focusable="False"
                  Visibility="{Binding ShowsCards, Converter={StaticResource Visible}}">
      <ItemsControl ItemsSource="{Binding Owners}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ProfessionOwner}">
            <StackPanel Margin="0,4,0,6">
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasName, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Realms}" ItemTemplate="{StaticResource RealmSection}" Focusable="False"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Search results. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,14,14,14" Focusable="False"
                  Visibility="{Binding ShowsHits, Converter={StaticResource Visible}}">
      <StackPanel>
        <TextBlock Text="{Binding HitsText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding Hits}" ItemTemplate="{StaticResource Hit}" Focusable="False"/>
      </StackPanel>
    </ScrollViewer>

    <!-- A character's recipes: the title bar, then the window. -->
    <Grid Grid.Row="1" Margin="24,14,24,18" Visibility="{Binding IsBookOpen, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12" DataContext="{Binding Book.Line}">
        <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Margin="0,0,14,0" VerticalAlignment="Center"
                Command="{Binding DataContext.CloseBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="All professions"/>
          </StackPanel>
        </Button>
        <Grid DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Visibility="{Binding HasMax, Converter={StaticResource Visible}}">
          <Border Height="18" CornerRadius="3" Background="#26FFFFFF">
            <Border CornerRadius="3" Background="{DynamicResource Indigo}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding Fraction}"/>
              </Border.RenderTransform>
            </Border>
          </Border>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" Foreground="White">
            <Run Text="{Binding Profession, Mode=OneWay}"/>
            <Run Text="{Binding SkillText, Mode=OneWay}"/>
          </TextBlock>
        </Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{Binding ProfessionIconUrl, Converter={StaticResource WebImage}}" Width="22" Height="22" Margin="0,0,9,0"
                 Visibility="{Binding ProfessionIconUrl, Converter={StaticResource VisibleIfSet}}"/>
          <TextBlock Text="{Binding Profession}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          <TextBlock FontSize="13" Margin="12,1,0,0" VerticalAlignment="Center">
            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding ClassBrush, Mode=OneWay}"/>
            <Run Text="{Binding Level, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
            <Run Text="{Binding Owner, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
            <Run Text="{Binding RecipeCountText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>
      <views:RecipeBookView Grid.Row="1" DataContext="{Binding Book}"/>
    </Grid>

    <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
  </Grid>
</UserControl>
