<!-- The Followed items page: search Wowhead and mark items, see and remove what's followed, and
     what happens when one comes in. DataContext: the game tab (FlavorViewModel). -->
<UserControl x:Class="WoWCharacterTracker.Views.FollowedItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <UserControl.Resources>
    <!-- An item: icon in its quality color and name (Wowhead's tooltip on hover, its page on click), and Follow or Remove. -->
    <DataTemplate DataType="{x:Type vm:FollowedRow}">
      <DockPanel Margin="0,3">
        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{Binding ActionText}" VerticalAlignment="Center" Margin="10,0,0,0"
                Command="{Binding DataContext.FollowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
        <Grid Background="Transparent" ui:ItemTip.Info="{Binding Info}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Info.Brush}" Background="#33000000" Margin="0,0,10,0">
            <Image Source="{Binding Info.IconUrl, Converter={StaticResource WebImage}}" Margin="1"/>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Info.Name}" Foreground="{Binding Info.Brush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorder}">
    <Grid Margin="26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,0,14">
        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White">
          <Run Text="Followed items for"/>
          <Run Text="{Binding Name, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,10"
                   Text="Your own wish list or BiS list: get one of these, however it comes and whatever its quality, and you hear about it once. Rare and better work right away, anything below reaches the game on your next /reload or login."/>
        <WrapPanel>
          <CheckBox Style="{StaticResource OptionChip}" Content="Discord post" IsChecked="{Binding PostFollowed}" Margin="0,0,6,6"
                    ToolTip="Post to Discord when a character gets a followed item, even when the other loot rules would skip it"/>
          <CheckBox Style="{StaticResource OptionChip}" Content="Stream overlay alert" IsChecked="{Binding Stream.FollowedAlert}" Margin="0,0,6,6"
                    ToolTip="ITEM FOUND! pops up on the stream overlay. The overlay itself is switched on in its own panel."/>
          <CheckBox Style="{StaticResource OptionChip}" Content="Guild and group chat" IsChecked="{Binding AnnounceFollowed}" Margin="0,0,6,6"
                    ToolTip="The addon tells your guild and/or group. Where it tells them is picked on the In game page."/>
          <Button Style="{StaticResource SmallButton}" Content="Test post" Margin="0,0,0,6" CommandParameter="followed"
                  Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTip="Send a sample post of this kind to Discord, to see how it looks"/>
        </WrapPanel>
      </StackPanel>

      <Grid Grid.Row="1" DataContext="{Binding FollowedItems}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Finding items -->
        <Border Style="{StaticResource PanelBorder}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Find on Wowhead" Margin="0,0,0,8"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Search" Command="{Binding SearchCommand}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Grid>
                  <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="An item's name, its Wowhead address or its id. Press Enter to search.">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                  </TextBox>
                  <TextBlock Text="Item name, Wowhead address or id" Foreground="{StaticResource Faint}" FontSize="13" Margin="13,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Query, Converter={StaticResource HiddenIfSet}}"/>
                </Grid>
              </DockPanel>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding Failed, Converter={StaticResource Hidden}}"/>
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource Red}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding Failed, Converter={StaticResource Visible}}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl ItemsSource="{Binding Results}" Focusable="False"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- The list -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Following" Margin="0,0,0,8"/>
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Followed}" Focusable="False"/>
              </ScrollViewer>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300"
                          Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nothing followed yet. Search for an item and click Follow." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
