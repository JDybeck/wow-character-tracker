<!-- Home: the character played last (Playing now while the game runs) with its leveling numbers and
     today's moments, next to a feed of the newest moments of every character, each with Share or
     Posted. DataContext: the game tab (HomeViewModel is its Home). -->
<UserControl x:Class="WoWCharacterTracker.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Hover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- A scrolling list of moments (MomentRow): the feed and the friends' one under it. -->
    <Style x:Key="MomentList" TargetType="ItemsControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate DataType="{x:Type vm:MomentRow}">
            <Border x:Name="Box" CornerRadius="10" Padding="10,8" Margin="0,0,6,4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
              <DockPanel>
                <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0">
                  <!-- A level-up: the character's portrait. -->
                  <Grid DataContext="{Binding Character}" Visibility="{Binding DataContext.IsLevel, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource Visible}}">
                    <Ellipse Fill="{Binding ClassSoftBrush}" Stroke="#1AFFFFFF"/>
                    <TextBlock Text="{Binding Initial}" Foreground="{Binding ClassBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding PictureUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/>
                      </Image.Clip>
                    </Image>
                    <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="1.5"/>
                  </Grid>
                  <!-- Anything else: the item's icon, else the kind's glyph. -->
                  <Grid DataContext="{Binding Row}" ui:ItemTip.Info="{Binding Info}"
                        Visibility="{Binding DataContext.IsLevel, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource Hidden}}">
                    <Border CornerRadius="8" Background="{DynamicResource CardHeader}"/>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="15" HorizontalAlignment="Center"
                               Visibility="{Binding HasIcon, Converter={StaticResource Hidden}}"/>
                    <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="30" Height="30"
                           Visibility="{Binding HasIcon, Converter={StaticResource Visible}}"/>
                  </Grid>
                </Grid>
                <!-- Posted, or a Share button (your own moments only). -->
                <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                      Visibility="{Binding Character.IsOwn, Converter={StaticResource Visible}}">
                  <TextBlock Text="&#x2713; Posted" FontSize="11" Foreground="{StaticResource Green}" VerticalAlignment="Center"
                             Visibility="{Binding Posted, Converter={StaticResource Visible}}"/>
                  <Button Style="{StaticResource ChipButton}" Content="Share" ToolTip="Post this moment to Discord"
                          Command="{Binding DataContext.PostHighlightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                          Visibility="{Binding Posted, Converter={StaticResource Hidden}}"/>
                </Grid>
                <StackPanel VerticalAlignment="Center" DataContext="{Binding Row}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Verb, Mode=OneWay}" Foreground="{StaticResource Text}"/><Run Text="{Binding Subject, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                             Text="{Binding DataContext.Who, RelativeSource={RelativeSource AncestorType=DockPanel}}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Big}" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BlueSoft}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BlueLine}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root" ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="-1" DataContext="{Binding Home}"
        Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=home}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.1*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Nobody yet: what will show up here. -->
    <Border Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Visibility="{Binding HasHero, Converter={StaticResource Hidden}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
        <TextBlock Text="Your adventures show up here" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,6"/>
        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Log in with a character and it appears with its level times, and your dings, kills, loot and mounts land here, ready to share."/>
      </StackPanel>
    </Border>

    <!-- The character -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasHero, Converter={StaticResource Visible}}">
    <StackPanel>
      <Border Style="{StaticResource CardBorder}" Padding="22,18" DataContext="{Binding Hero}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,7,0" VerticalAlignment="Center"
                     Visibility="{Binding DataContext.Playing, ElementName=Root, Converter={StaticResource Visible}}"/>
            <TextBlock Style="{StaticResource FactLabel}" Text="{Binding DataContext.HeroTitle, ElementName=Root}"/>
          </StackPanel>
          <Button Cursor="Hand" Margin="-6" ToolTip="Open on the Characters page"
                  Command="{Binding DataContext.OpenCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" CornerRadius="10" Padding="6" Background="Transparent">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          <DockPanel>
            <Grid DockPanel.Dock="Left" Width="76" Height="76" Margin="0,0,16,0">
              <Ellipse Fill="{Binding ClassSoftBrush}" Stroke="#1AFFFFFF"/>
              <TextBlock Text="{Binding Initial}" Foreground="{Binding ClassBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding PictureUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill">
                <Image.Clip>
                  <EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38"/>
                </Image.Clip>
              </Image>
              <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="2"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding FullName}" Foreground="{Binding ClassBrush}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock FontSize="13" Foreground="{StaticResource TextSoft}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="Level"/> <Run Text="{Binding Level, Mode=OneWay}"/> <Run Text="{Binding Race, Mode=OneWay}"/> <Run Text="{Binding ClassName, Mode=OneWay}"/>
              </TextBlock>
              <TextBlock Text="{Binding ZoneText}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
          </Button>

          <TextBlock Text="{Binding DataContext.PaceText, ElementName=Root}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,14,0,0"
                     Visibility="{Binding DataContext.PaceText, ElementName=Root, Converter={StaticResource VisibleIfSet}}"/>

          <UniformGrid Columns="4" Margin="0,14,-8,0" DataContext="{Binding DataContext.Card, ElementName=Root}">
            <Border Style="{StaticResource Tile}">
              <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding ItemLevel}"/><TextBlock Style="{StaticResource Hint}" Text="Item level"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding Gold}"/><TextBlock Style="{StaticResource Hint}" Text="Gold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding Played}"/><TextBlock Style="{StaticResource Hint}" Text="Played"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel><TextBlock Style="{StaticResource TileValue}" Text="{Binding DataContext.ThisLevelText, ElementName=Root}"/><TextBlock Style="{StaticResource Hint}" Text="This level"/></StackPanel>
            </Border>
          </UniformGrid>

          <TextBlock Text="{Binding Leveling.EstimateText}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                     Visibility="{Binding Leveling.HasEstimate, Converter={StaticResource Visible}}"/>
          <!-- A mini level times chart (the last 40 levels), the Leveling tab's at half height. -->
          <ItemsControl ItemsSource="{Binding Leveling.Bars}" Height="74" Margin="0,12,0,0" ItemTemplate="{StaticResource LevelBarTemplate}" Focusable="False"
                        HorizontalAlignment="Left" Visibility="{Binding Leveling.HasStats, Converter={StaticResource Visible}}">
            <ItemsControl.LayoutTransform>
              <ScaleTransform ScaleY="0.5"/>
            </ItemsControl.LayoutTransform>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,10,0,0" Padding="12,4" ToolTip="Post this character's card to Discord"
                  Command="{Binding DataContext.PostCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{DynamicResource BlueText}" Margin="0,0,7,0"/>
              <TextBlock Text="Share this character" FontSize="13" Foreground="{DynamicResource BlueText}"/>
            </StackPanel>
          </Button>

          <!-- Today, every character of the game, in the same card. -->
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
            <StackPanel>
          <TextBlock Style="{StaticResource FactLabel}" Text="TODAY" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{Binding DataContext.Today, ElementName=Root}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TodayCount}">
                <TextBlock FontSize="13">
                  <Run Text="{Binding Count, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                  <Run Text="{Binding What, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Friends who share with you, the one seen last first (only when there are some). Click one for the Friends page. -->
      <Border Style="{StaticResource CardBorder}" Padding="22,14" Margin="0,16,0,0" Visibility="{Binding HasFriends, Converter={StaticResource Visible}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FactLabel}" Text="LAST SEEN"
                       ToolTip="Friends' updates reach the app when you /reload or log out."/>
            <TextBlock Style="{StaticResource FactLabel}" Text="FRIENDS"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Friends}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CharacterRow}">
                <Button Cursor="Hand" Margin="0,0,0,4" ToolTip="Open on the Friends page"
                        Command="{Binding DataContext.OpenFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" CornerRadius="8" Padding="6,5" Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0">
                      <Ellipse Fill="{Binding ClassSoftBrush}" Stroke="#1AFFFFFF"/>
                      <TextBlock Text="{Binding Initial}" Foreground="{Binding ClassBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding PictureUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill">
                        <Image.Clip>
                          <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/>
                        </Image.Clip>
                      </Image>
                      <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="1.5"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                      <TextBlock Text="{Binding FriendName}" FontSize="12" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding LastSeenText}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding FullName}" Foreground="{Binding ClassBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis">
                        <Run Text="Level"/> <Run Text="{Binding Level, Mode=OneWay}"/> <Run Text="{Binding ClassName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ZoneText, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>

    <!-- The feed: your moments, and under them your friends' (when they share some). The friends' part
         grows from the bottom up to half the card, yours gets the rest. -->
    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,14" Visibility="{Binding HasHero, Converter={StaticResource Visible}}">
      <Grid x:Name="FeedSplit">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource FactLabel}" Text="RECENT MOMENTS" Margin="6,0,0,8"/>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="6,0,0,0" Text="Nothing yet. Dings, kills, loot and mounts show up here."
                     Visibility="{Binding HasFeed, Converter={StaticResource Hidden}}"/>
          <ItemsControl ItemsSource="{Binding Feed}" Style="{StaticResource MomentList}"/>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"
                MaxHeight="{Binding ActualHeight, ElementName=FeedSplit, Converter={StaticResource Times}, ConverterParameter=0.5}"
                Visibility="{Binding HasFriendFeed, Converter={StaticResource Visible}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource FactLabel}" Text="FRIENDS' MOMENTS" Margin="6,0,0,8"
                       ToolTip="Friends' updates reach the app when you /reload or log out."/>
            <ItemsControl ItemsSource="{Binding FriendFeed}" Style="{StaticResource MomentList}"/>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
