<!-- What gets posted for the selected game, in General / PvE / PvP columns. -->
<UserControl x:Class="WoWCharacterTracker.Views.PostingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">
  <Border Style="{StaticResource CardBorder}" DataContext="{Binding SelectedFlavor}"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=posting}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22">
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Reset to defaults"
                  Command="{Binding DataContext.ResetPostingCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White">
            <Run Text="What gets posted for"/>
            <Run Text="{Binding Name, Mode=OneWay}"/>
          </TextBlock>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                   Text="Changes apply right away. Things that are switched off are skipped, and they won't be posted later if you switch them on. Screenshot means the addon takes one in game a moment after it happens (saved in your Screenshots folder). Screenshot settings reach the game on your next /reload or login."/>
        <CheckBox IsChecked="{Binding HideChatInShots}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Hide chat in screenshots" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
            <TextBlock Style="{StaticResource Hint}" Text="The chat windows are hidden for the moment the screenshot is taken, then come right back."/>
          </StackPanel>
        </CheckBox>
        <StackPanel Margin="0,0,0,16" Visibility="{Binding HasSurnames, Converter={StaticResource Visible}}">
          <TextBlock Text="Name in posts" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
          <TextBlock Style="{StaticResource Hint}" Text="Forever characters have a surname. Pick what posts and character cards call them." Margin="0,2,0,8"/>
          <StackPanel Orientation="Horizontal">
            <CheckBox Style="{StaticResource OptionChip}" Content="Full name (Ronnie Raket)" IsChecked="{Binding NameFull}" Margin="0,0,6,0"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="First name (Ronnie)" IsChecked="{Binding NameFirst}" Margin="0,0,6,0"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Surname (Raket)" IsChecked="{Binding NameLast}"/>
          </StackPanel>
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- General -->
          <Border Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="General" Margin="0,0,0,14"/>
            <StackPanel Margin="0,0,0,16">
              <CheckBox IsChecked="{Binding PostLevels}">
                <StackPanel>
                  <TextBlock Text="Level-ups" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Dings, with how long the level took." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="level"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[level].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[level].Post}" IsEnabled="{Binding Shots[level].Take}"/>
              </WrapPanel>
              <StackPanel Margin="30,10,0,0" IsEnabled="{Binding PostLevels}">
                <WrapPanel>
                  <TextBlock Text="Up to level" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                  <TextBox Style="{StaticResource NumberBox}" Text="{Binding LevelSplit, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text=", every" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                  <TextBox Style="{StaticResource NumberBox}" Text="{Binding LevelEveryBefore, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="levels, then every" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}"/>
                  <TextBox Style="{StaticResource NumberBox}" Text="{Binding LevelEveryAfter, UpdateSourceTrigger=PropertyChanged}"/>
                </WrapPanel>
                <TextBlock Text="{Binding LevelPreview}" Foreground="{StaticResource Green}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="&#x1F3C6; Max level is always posted, with extra flair."/>
                <Button Style="{StaticResource GhostButton}" Content="Test max level" Padding="8,2" FontSize="11" ToolTip="Post a sample max level post to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="max" HorizontalAlignment="Left" Margin="-8,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Loot" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
              <CheckBox IsChecked="{Binding PostRare}" Margin="0,0,0,4"><TextBlock Text="Rare items" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="13"/></CheckBox>
              <CheckBox IsChecked="{Binding PostEpic}"><TextBlock Text="Epic items" Foreground="#C084FC" FontWeight="SemiBold" FontSize="13"/></CheckBox>
              <TextBlock Style="{StaticResource Hint}" Margin="30,6,0,0" Foreground="#FB923C" TextWrapping="Wrap" Text="Legendary items are always posted, with extra flair."/>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test rare" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="rare"/>
                <Button Style="{StaticResource GhostButton}" Content="Test epic" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="epic"/>
                <Button Style="{StaticResource GhostButton}" Content="Test legendary" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="legendary"/>
              </WrapPanel>
              <WrapPanel Margin="30,4,0,0">
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[loot].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[loot].Post}" IsEnabled="{Binding Shots[loot].Take}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,16">
              <CheckBox IsChecked="{Binding PostMounts}">
                <StackPanel>
                  <TextBlock Text="New mounts" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Bought or learned. Says &quot;bought&quot; when a vendor was open." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mount"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[mount].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[mount].Post}" IsEnabled="{Binding Shots[mount].Take}"/>
              </WrapPanel>

            </StackPanel>
            </StackPanel>
          </Border>

          <!-- PvE -->
          <Border Grid.Column="2" Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="PvE" Margin="0,0,0,14"/>
            <StackPanel Margin="0,0,0,16">
              <CheckBox IsChecked="{Binding PostBosses}">
                <StackPanel>
                  <TextBlock Text="End boss kills" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="The last boss of a dungeon or raid. The post lists the group." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="boss"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[boss].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[boss].Post}" IsEnabled="{Binding Shots[boss].Take}"/>
              </WrapPanel>
              <StackPanel Margin="30,8,0,0" IsEnabled="{Binding PostBosses}">
                <TextBlock Text="Skip when someone in the group matches (regex):" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <Grid>
                  <TextBox Text="{Binding SkipBossGroupRegex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
                  <TextBlock Text="e.g. ^(Grimtusk|Pellia)$" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" FontFamily="{StaticResource Mono}"
                             VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding SkipBossGroupRegex, Converter={StaticResource HiddenIfSet}}"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="For friends who run the tracker too, so a kill isn't posted twice."/>
                <TextBlock Text="{Binding SkipRegexProblem}" Foreground="{StaticResource Red}" FontSize="12" Visibility="{Binding SkipRegexProblem, Converter={StaticResource VisibleIfSet}}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,0,16">
              <CheckBox IsChecked="{Binding PostDeaths}">
                <StackPanel>
                  <TextBlock Text="Hardcore deaths" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="What killed them, total played and the gold they had." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="death"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[death].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[death].Post}" IsEnabled="{Binding Shots[death].Take}"/>
              </WrapPanel>

            </StackPanel>
            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRetail, Converter={StaticResource Visible}}">
              <CheckBox IsChecked="{Binding PostMPlus}">
                <StackPanel>
                  <TextBlock Text="Mythic+ rating" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="When your rating passes one of these steps." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mplus"/>

              </WrapPanel>
              <StackPanel Margin="30,8,0,0">
                <TextBlock Text="Steps:" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding MPlusStepsText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Border>

          <!-- PvP -->
          <Border Grid.Column="4" Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="PvP" Margin="0,0,0,14"/>
            <StackPanel Margin="0,0,0,16">
              <CheckBox IsChecked="{Binding PostDuels}">
                <StackPanel>
                  <TextBlock Text="Duels won" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Who you beat, or who ran away." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="duel"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[duel].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[duel].Post}" IsEnabled="{Binding Shots[duel].Take}"/>
              </WrapPanel>

            </StackPanel>
            <StackPanel Margin="0,0,0,16" Visibility="{Binding HasSurnames, Converter={StaticResource Visible}}">
              <CheckBox IsChecked="{Binding PostMakgora}">
                <StackPanel>
                  <TextBlock Text="Mak&apos;gora won" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="The hardcore duel to the death. The loser&apos;s character is gone for good." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="makgora"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[makgora].Take}"/>
                <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[makgora].Post}" IsEnabled="{Binding Shots[makgora].Take}"/>
              </WrapPanel>

            </StackPanel>
            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRetail, Converter={StaticResource Visible}}">
              <CheckBox IsChecked="{Binding PostPvp}">
                <StackPanel>
                  <TextBlock Text="PvP rating" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Hint}" Text="When a rated bracket passes one of these steps (2v2, 3v3, RBG, Solo Shuffle, Blitz)." TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
              <WrapPanel Margin="30,6,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Test" Padding="8,2" FontSize="11" Margin="0,0,6,0" ToolTip="Post a sample of this to Discord now" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="pvp"/>

              </WrapPanel>
              <StackPanel Margin="30,8,0,0">
                <TextBlock Text="Steps:" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PvpStepsText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
