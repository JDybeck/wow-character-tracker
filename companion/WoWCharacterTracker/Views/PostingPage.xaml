<!-- What gets posted for the selected game, in General / PvE / PvP columns. -->
<UserControl x:Class="WoWCharacterTracker.Views.PostingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">
  <Border Style="{StaticResource CardBorder}" DataContext="{Binding SelectedFlavor}"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=posting}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22">
        <DockPanel Margin="0,0,0,4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" ToolTip="Copy these settings as a code to share with friends"
                    Command="{Binding DataContext.CopyPostingCommand, RelativeSource={RelativeSource AncestorType=Window}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Copy settings" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" ToolTip="Use a settings code someone shared (copy it first)"
                    Command="{Binding DataContext.PastePostingCommand, RelativeSource={RelativeSource AncestorType=Window}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Paste settings" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Content="Reset to defaults"
                    Command="{Binding DataContext.ResetPostingCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
          </StackPanel>
          <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White">
            <Run Text="What gets posted for"/>
            <Run Text="{Binding Name, Mode=OneWay}"/>
          </TextBlock>
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                   Text="Changes apply right away. Things that are switched off are skipped, and they won't be posted later if you switch them on. Screenshot means the addon takes one in game a moment after it happens (saved in your Screenshots folder). Screenshot settings reach the game on your next /reload or login."/>
        <CheckBox IsChecked="{Binding HideChatInShots}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Hide chat in screenshots" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
            <TextBlock Style="{StaticResource Hint}" Text="The chat windows are hidden for the moment the screenshot is taken, then come right back."/>
          </StackPanel>
        </CheckBox>
        <CheckBox IsChecked="{Binding HideUiInShots}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Hide the whole interface in screenshots (like Alt+Z)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Just your character and the world in the picture: action bars, minimap, chat and frames are hidden for a split second, then come right back. Nameplates stay."/>
          </StackPanel>
        </CheckBox>
        <CheckBox IsChecked="{Binding AdvancedCombatLog}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Advanced combat logging" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Turns on the game's own Advanced Combat Logging setting (System, Network), the one Warcraft Logs asks for. More detail in the combat log file, for log tools and for features here later. The addon sets it at your next /reload or login, out of combat. Unticking turns it off again."/>
          </StackPanel>
        </CheckBox>
        <StackPanel Margin="0,0,0,16" Visibility="{Binding HasSurnames, Converter={StaticResource Visible}}">
          <TextBlock Text="Name in posts" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
          <TextBlock Style="{StaticResource Hint}" Text="Forever characters have a surname. Pick what posts and character cards call them." Margin="0,2,0,8"/>
          <StackPanel Orientation="Horizontal">
            <CheckBox Style="{StaticResource OptionChip}" Content="Full name (Ronnie Raket)" IsChecked="{Binding NameFull}" Margin="0,0,6,0"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="First name (Ronnie)" IsChecked="{Binding NameFirst}" Margin="0,0,6,0"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Surname (Raket)" IsChecked="{Binding NameLast}"/>
          </StackPanel>
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- General -->
          <Border Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="General" Margin="0,0,0,14"/>
              <StackPanel Style="{StaticResource PostOption}">
                <CheckBox IsChecked="{Binding PostLevels}">
                  <StackPanel>
                    <TextBlock Text="Level-ups" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Dings, with how long the level took."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="level"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[level].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[level].Post}" Visibility="{Binding Shots[level].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
                <!-- The level rule as a small form: labels left, boxes in one column, units right. -->
                <Grid Margin="30,10,0,0" IsEnabled="{Binding PostLevels}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="Up to level" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Column="1" Style="{StaticResource GridNumberBox}" Text="{Binding LevelSplit, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="1" Text="post every" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource GridNumberBox}" Text="{Binding LevelEveryBefore, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="levels" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Text="then every" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource GridNumberBox}" Text="{Binding LevelEveryAfter, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="level(s)" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding LevelPreview}" Foreground="{StaticResource Green}" FontSize="12" Margin="30,8,0,0" TextWrapping="Wrap"/>
                <Border Margin="30,10,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                  <StackPanel>
                    <CheckBox IsChecked="{Binding PostMaxLevel}">
                      <StackPanel>
                        <TextBlock Text="&#x1F3C6; Max level" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Posted with extra flair, even when the level rule skips that level."/>
                      </StackPanel>
                    </CheckBox>
                    <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="max" HorizontalAlignment="Left" Margin="30,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Style="{StaticResource PostOption}">
                <TextBlock Text="Loot" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
                <!-- One row per quality: the checkbox, and its Test button lined up on the right. -->
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <CheckBox IsChecked="{Binding PostRare}" VerticalAlignment="Center"><TextBlock Text="Rare items" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="13"/></CheckBox>
                  <Button Grid.Column="1" Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="rare"/>
                  <CheckBox Grid.Row="1" IsChecked="{Binding PostEpic}" VerticalAlignment="Center"><TextBlock Text="Epic items" Foreground="#C084FC" FontWeight="SemiBold" FontSize="13"/></CheckBox>
                  <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="epic"/>
                  <TextBlock Grid.Row="2" Margin="30,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}" Foreground="#FB923C" Text="Legendary: always posted"/>
                  <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="legendary"/>
                </Grid>
                <WrapPanel Margin="30,8,0,0">
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[loot].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[loot].Post}" Visibility="{Binding Shots[loot].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
              </StackPanel>
              <StackPanel Style="{StaticResource PostOption}">
                <CheckBox IsChecked="{Binding PostMounts}">
                  <StackPanel>
                    <TextBlock Text="New mounts" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Bought or learned. Says &quot;bought&quot; when a vendor was open."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mount"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[mount].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[mount].Post}" Visibility="{Binding Shots[mount].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- PvE -->
          <Border Grid.Column="2" Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="PvE" Margin="0,0,0,14"/>
              <StackPanel Style="{StaticResource PostOption}">
                <CheckBox IsChecked="{Binding PostBosses}">
                  <StackPanel>
                    <TextBlock Text="End boss kills" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="The last boss of a dungeon or raid. The post lists the group."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="boss"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[boss].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[boss].Post}" Visibility="{Binding Shots[boss].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
                <StackPanel Margin="30,6,0,0" IsEnabled="{Binding PostBosses}">
                  <TextBlock Text="Skip when someone in the group matches (regex)" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <Grid>
                    <TextBox Text="{Binding SkipBossGroupRegex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
                    <TextBlock Text="e.g. ^(Grimtusk|Pellia)$" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" FontFamily="{StaticResource Mono}"
                               VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding SkipBossGroupRegex, Converter={StaticResource HiddenIfSet}}"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="For friends who run the tracker too, so a kill isn't posted twice."/>
                  <TextBlock Text="{Binding SkipRegexProblem}" Foreground="{StaticResource Red}" FontSize="12" Visibility="{Binding SkipRegexProblem, Converter={StaticResource VisibleIfSet}}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Style="{StaticResource PostOption}">
                <CheckBox IsChecked="{Binding PostDeaths}">
                  <StackPanel>
                    <TextBlock Text="Hardcore deaths" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="What killed them, total played and the gold they had."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="death"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[death].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[death].Post}" Visibility="{Binding Shots[death].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
              </StackPanel>

              <StackPanel Style="{StaticResource PostOption}" Visibility="{Binding IsRetail, Converter={StaticResource Visible}}">
                <CheckBox IsChecked="{Binding PostMPlus}">
                  <StackPanel>
                    <TextBlock Text="Mythic+ rating" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="When your rating passes one of these steps."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="mplus"/>
                </WrapPanel>
                <Grid Margin="30,6,0,0" IsEnabled="{Binding PostMPlus}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Steps" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Column="1" Text="{Binding MPlusStepsText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- PvP -->
          <Border Grid.Column="4" Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="PvP" Margin="0,0,0,14"/>
              <StackPanel Style="{StaticResource PostOption}">
                <CheckBox IsChecked="{Binding PostDuels}">
                  <StackPanel>
                    <TextBlock Text="Duels won" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Who you beat, or who ran away."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="duel"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[duel].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[duel].Post}" Visibility="{Binding Shots[duel].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
              </StackPanel>

              <StackPanel Style="{StaticResource PostOption}" Visibility="{Binding HasSurnames, Converter={StaticResource Visible}}">
                <CheckBox IsChecked="{Binding PostMakgora}">
                  <StackPanel>
                    <TextBlock Text="Mak&apos;gora won" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="The hardcore duel to the death. The loser&apos;s character is gone for good."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="makgora"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Screenshot" IsChecked="{Binding Shots[makgora].Take}"/>
                  <CheckBox Style="{StaticResource ChipCheck}" Content="Post screenshot" IsChecked="{Binding Shots[makgora].Post}" Visibility="{Binding Shots[makgora].Take, Converter={StaticResource Visible}}"/>
                </WrapPanel>
              </StackPanel>

              <StackPanel Style="{StaticResource PostOption}" Visibility="{Binding IsRetail, Converter={StaticResource Visible}}">
                <CheckBox IsChecked="{Binding PostPvp}">
                  <StackPanel>
                    <TextBlock Text="PvP rating" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="When a rated bracket (2v2, 3v3, RBG, Solo Shuffle, Blitz) passes one of these steps."/>
                  </StackPanel>
                </CheckBox>
                <WrapPanel Margin="30,8,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="Test" Command="{Binding DataContext.TestKindCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="pvp"/>
                </WrapPanel>
                <Grid Margin="30,6,0,0" IsEnabled="{Binding PostPvp}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Steps" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Grid.Column="1" Text="{Binding PvpStepsText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Padding="8,4" FontSize="12"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
