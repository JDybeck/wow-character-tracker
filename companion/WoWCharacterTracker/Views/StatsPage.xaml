<!-- The Stats page: the week's MVP podium (second, first, third) and a leaderboard per stat, you against
     your friends (StatsViewModel). DataContext: the game tab (FlavorViewModel); MainWindow has one per tab. -->
<UserControl x:Class="WoWCharacterTracker.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <UserControl.Resources>
    <!-- A name: yours in the accent color. -->
    <Style x:Key="WhoText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsYou}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource BlueText}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One board: its title, the top three and you (set apart when further down), Show all. -->
    <DataTemplate x:Key="BoardTemplate" DataType="{x:Type vm:BoardView}">
      <Border Style="{StaticResource PanelBorder}" Margin="8" Padding="16,12">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{DynamicResource BlueText}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ScoreRow}">
                <Border x:Name="Row" BorderBrush="{DynamicResource Line}" BorderThickness="0" Padding="0,3">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="20" Text="{Binding RankText}" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Top"/>
                    <TextBlock x:Name="Value" DockPanel.Dock="Right" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}"
                               VerticalAlignment="Top" Margin="8,0,0,0"/>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource WhoText}"/>
                      <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                 Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Amber}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Gap}" Value="True">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0"/>
                    <Setter TargetName="Row" Property="Margin" Value="0,4,0,0"/>
                    <Setter TargetName="Row" Property="Padding" Value="0,7,0,3"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,2" Margin="0,6,0,0"
                  Command="{Binding ToggleCommand}" Visibility="{Binding HasMore, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ToggleText}" FontSize="12" Foreground="{DynamicResource BlueText}"/>
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource CardBorder}" ClipToBounds="True" ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="8"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=stats}">
    <ScrollViewer DataContext="{Binding Stats}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,20,28,24">
        <TextBlock Style="{StaticResource FactLabel}" Text="THIS WEEK"/>
        <TextBlock Text="The last 7 days, you against every friend who shares with you. A board won is 3 points, second 2, third 1."
                   FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>

        <TextBlock Text="Nothing yet this week. Level up, kill a boss or turn in a quest and the boards fill up, and so do your friends' once they share with you."
                   FontSize="13" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,24,0,0"
                   Visibility="{Binding HasBoards, Converter={StaticResource Hidden}}"/>

        <StackPanel Visibility="{Binding HasBoards, Converter={StaticResource Visible}}">
          <!-- MVP of the week: second, first (highest) and third, side by side. -->
          <ItemsControl ItemsSource="{Binding Podium}" Focusable="False" HorizontalAlignment="Center" Margin="0,18,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PodiumPlace}">
                <StackPanel Width="210" Margin="8,0" VerticalAlignment="Bottom">
                  <TextBlock x:Name="Crown" Text="MVP" Style="{StaticResource FactLabel}" HorizontalAlignment="Center" Foreground="{StaticResource Amber}" Visibility="Collapsed"/>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource WhoText}" FontSize="16" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding PointsText}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding WonText}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" Margin="0,2,0,6"/>
                  <Border x:Name="Step" Height="{Binding Height}" CornerRadius="8,8,0,0" Background="{DynamicResource IndigoMid}" Opacity="0.55">
                    <TextBlock Text="{Binding RankText}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Step" Property="Background" Value="{StaticResource Amber}"/>
                    <Setter TargetName="Step" Property="Opacity" Value="0.85"/>
                    <Setter TargetName="Crown" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"/>
          <TextBlock Text="{Binding YourPlace}" FontSize="12" Foreground="{DynamicResource BlueText}" HorizontalAlignment="Center" Margin="0,8,0,0"
                     Visibility="{Binding HasYourPlace, Converter={StaticResource Visible}}"/>

          <!-- A board per stat: three columns, each stacking on its own. -->
          <ItemsControl ItemsSource="{Binding Columns}" Focusable="False" Margin="-8,18,-8,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding}" Focusable="False" VerticalAlignment="Top" ItemTemplate="{StaticResource BoardTemplate}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
