<!-- One character's recipes in a profession, laid out like the game's profession window (RecipeBook):
     category headers and recipes on the left with a search, the picked recipe on the right with its
     tools, reagents and the item it makes. DataContext: RecipeBook. -->
<UserControl x:Class="WoWCharacterTracker.Views.RecipeBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <UserControl.Resources>
    <!-- A small gold heading, as the game writes "Reagents:". -->
    <Style x:Key="PartTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Amber}"/>
      <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <!-- A recipe in the list: its icon and name, highlighted when picked. -->
    <DataTemplate x:Key="RecipeRow" DataType="{x:Type vm:RecipeEntry}">
      <Border x:Name="Row" Padding="14,3,8,3" CornerRadius="4" Background="Transparent" Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Border.InputBindings>
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding Info.IconUrl, Converter={StaticResource WebImage}}" Width="16" Height="16" Margin="0,0,8,0"/>
          <TextBlock x:Name="Name" Text="{Binding Info.Name}" FontSize="12.5" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/>
          <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Text}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Info.Name}" Value="">
          <Setter TargetName="Name" Property="Text" Value="Looking up..."/>
          <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Dim}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A category: its gold header (a click folds it), then its recipes. -->
    <DataTemplate x:Key="CategoryBlock" DataType="{x:Type vm:RecipeCategory}">
      <StackPanel Margin="0,0,0,6" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
        <Border Background="{DynamicResource AmberSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4"
                Padding="8,3" Margin="0,0,0,2" Cursor="Hand">
          <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
          </Border.InputBindings>
          <DockPanel>
            <TextBlock x:Name="Fold" DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE738;" FontSize="10"
                       Foreground="{DynamicResource Amber}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Amber}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource RecipeRow}" Focusable="False"
                      Visibility="{Binding IsOpen, Converter={StaticResource Visible}}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsOpen}" Value="False">
          <Setter TargetName="Fold" Property="Text" Value="&#xE710;"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A reagent: its icon with the count in the corner, and its name. -->
    <DataTemplate x:Key="ReagentRow" DataType="{x:Type vm:ReagentLine}">
      <Grid Margin="0,0,0,6" Background="Transparent" ui:ItemTip.Info="{Binding Info}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Info.Brush}" Background="#33000000" Margin="0,0,10,0">
          <Grid>
            <Image Source="{Binding Info.IconUrl, Converter={StaticResource WebImage}}" Margin="1"/>
            <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="0,0,3,1"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{Binding Info.Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The list: search, then the categories. -->
    <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,12,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
          <TextBox ToolTip="Search these recipes by name" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="17,5,10,5"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Dim}" FontSize="12" Margin="10,0,0,0" IsHitTestVisible="False"/>
          <TextBlock Text="Search" Foreground="{StaticResource Faint}" FontSize="12.5" Margin="32,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource HiddenIfSet}}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryBlock}" Focusable="False"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- The picked recipe. -->
    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="20,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel DataContext="{Binding Selected}">
          <Grid Background="Transparent" ui:ItemTip.Info="{Binding Info}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="24" BorderThickness="2" BorderBrush="{DynamicResource Line}" Background="#33000000" Margin="0,0,14,0" ClipToBounds="True">
              <Image Source="{Binding Info.IconUrl, Converter={StaticResource WebImage}}">
                <Image.Clip>
                  <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                </Image.Clip>
              </Image>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Info.Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>

          <StackPanel Visibility="{Binding HasTools, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource PartTitle}" Text="Tools:"/>
            <TextBlock Text="{Binding ToolsText}" FontSize="13" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Visibility="{Binding HasReagents, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource PartTitle}" Text="Reagents:"/>
            <ItemsControl ItemsSource="{Binding Reagents}" ItemTemplate="{StaticResource ReagentRow}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <StackPanel Visibility="{Binding HasMade, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource PartTitle}" Text="Makes:"/>
            <ui:WowTooltip HorizontalAlignment="Left" Html="{Binding Made.Html}" Text="{Binding Made.Tooltip}"/>
          </StackPanel>

          <ui:WowTooltip HorizontalAlignment="Left" Margin="0,16,0,0" Html="{Binding Info.Html}" Text="{Binding Info.Tooltip}"
                         Visibility="{Binding ShowsTooltip, Converter={StaticResource Visible}}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
