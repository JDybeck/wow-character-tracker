<!-- What's new: the last versions from the built-in changelog, new features apart from fixes and tweaks. -->
<UserControl x:Class="WoWCharacterTracker.Views.ChangelogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WoWCharacterTracker.Services">
  <Border Width="480" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="16,12,10,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Command="{Binding OpenUrlCommand}"
                CommandParameter="{Binding Updates.ChangelogUrl}" ToolTip="Every version so far (opens GitHub)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Full changelog" FontSize="12" Foreground="{DynamicResource BlueText}" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Foreground="{DynamicResource BlueText}" Margin="6,0,0,0"/>
          </StackPanel>
        </Button>
        <TextBlock Text="What's new" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
      </DockPanel>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>
      <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Updates.RecentChanges}" Focusable="False" Margin="16,4,16,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type services:ChangelogVersion}">
              <StackPanel Margin="0,10,0,4">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Intro}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"
                           Visibility="{Binding Intro, Converter={StaticResource VisibleIfSet}}"/>
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:ChangelogGroup}">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="GroupTitle" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="Items" ItemsSource="{Binding Items}" Focusable="False" Foreground="{StaticResource Muted}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:ChangelogItem}">
                              <DockPanel x:Name="Row" Margin="0,2">
                                <TextBlock x:Name="Mark" Text="•" FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="18">
                                  <Run Text="{Binding Head, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Text, Mode=OneWay}"/>
                                </TextBlock>
                              </DockPanel>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSub}" Value="True">
                                  <Setter TargetName="Row" Property="Margin" Value="14,2,0,2"/>
                                  <Setter TargetName="Mark" Property="Text" Value="◦"/>
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <!-- New features stand out, fixes and tweaks stay quiet. -->
                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                          <Setter TargetName="GroupTitle" Property="Foreground" Value="{DynamicResource BlueText}"/>
                          <Setter TargetName="Items" Property="Foreground" Value="{StaticResource Text}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
