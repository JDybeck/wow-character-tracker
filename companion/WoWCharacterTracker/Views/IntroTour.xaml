<!-- The first-run tour (IntroViewModel): the window dimmed except the part a step is about, a ring
     around that part and a small card next to it. The lit part stays clickable (the shade has a hole). -->
<UserControl x:Class="WoWCharacterTracker.Views.IntroTour"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" Focusable="True" FocusVisualStyle="{x:Null}">
  <Canvas>
    <Path x:Name="Shade" Fill="#B3000000"/>
    <Border x:Name="Ring" BorderBrush="{DynamicResource BlueHover}" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False"/>
    <Border x:Name="Card" Style="{StaticResource CardBorder}" Width="340" Padding="18,14,18,16" BorderBrush="{DynamicResource BlueLine}">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3" Margin="0,-4,-10,0" Command="{Binding CloseCommand}" ToolTip="Close the tour (Esc)">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" Foreground="{StaticResource Muted}"/>
          </Button>
          <TextBlock Text="{Binding Counter}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding Step.Title}" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,6"/>
        <TextBlock Text="{Binding Step.Text}" FontSize="13" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" LineHeight="19"/>
        <DockPanel Margin="0,16,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="Back" Command="{Binding BackCommand}" Padding="10,6" Margin="0,0,4,0"
                    Visibility="{Binding IsFirst, Converter={StaticResource Hidden}}"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" Padding="16,6"/>
          </StackPanel>
          <CheckBox IsChecked="{Binding DontShowAgain}" VerticalAlignment="Center"
                    ToolTip="Ticked: closing the tour means it won't open by itself again. Settings, Show the tour brings it back.">
            <TextBlock Text="Don't show again" FontSize="12" Foreground="{StaticResource Muted}"/>
          </CheckBox>
        </DockPanel>
      </StackPanel>
    </Border>
  </Canvas>
</UserControl>
