<!-- The Gear and bags tab of the character details: equipped gear laid out like the character window
     (left and right columns, weapons below), then the bags, then the bank as of the last visit. -->
<UserControl x:Class="WoWCharacterTracker.Views.CharacterGear"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <UserControl.Resources>
    <!-- A gear slot: the item's icon, then its name in quality color (or the empty slot's name). -->
    <DataTemplate x:Key="GearSlot" DataType="{x:Type vm:ItemCell}">
      <DockPanel Margin="0,0,0,2" Background="Transparent">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ItemCellTemplate}" DockPanel.Dock="Left"/>
        <TextBlock x:Name="Name" Text="{Binding Item.Name}" Foreground="{Binding Item.Brush}" FontSize="12" Margin="6,0,0,3"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
          <Setter TargetName="Name" Property="Text" Value="{Binding SlotName}"/>
          <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Faint}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- A bag: its title, then its slots in rows. -->
    <DataTemplate x:Key="BagTemplate" DataType="{x:Type vm:BagView}">
      <StackPanel Margin="0,0,18,10">
        <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,4"/>
        <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource ItemCellTemplate}" Width="296" HorizontalAlignment="Left">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="Nothing yet. Log in with the updated addon and type /reload (or log out): gear and bags show up here." Foreground="{StaticResource Dim}"
               FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Gear.HasInventory, Converter={StaticResource Hidden}}"/>

    <StackPanel Visibility="{Binding Gear.HasInventory, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource FactLabel}" Text="EQUIPPED"/>
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding Gear.Left}" ItemTemplate="{StaticResource GearSlot}"/>
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Gear.Right}" ItemTemplate="{StaticResource GearSlot}"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding Gear.Bottom}" ItemTemplate="{StaticResource GearSlot}" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <TextBlock Style="{StaticResource FactLabel}" Text="BAGS" Margin="0,14,0,6"/>
      <ItemsControl ItemsSource="{Binding Gear.Bags}" ItemTemplate="{StaticResource BagTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <TextBlock Style="{StaticResource FactLabel}" Text="{Binding Gear.BankText}" Margin="0,8,0,6"/>
      <ItemsControl ItemsSource="{Binding Gear.Bank}" ItemTemplate="{StaticResource BagTemplate}" Visibility="{Binding Gear.HasBank, Converter={StaticResource Visible}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
