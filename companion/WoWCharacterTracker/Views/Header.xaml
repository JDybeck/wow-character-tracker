<!-- Top bar: logo, title, update check, game tabs, search, sync, the ? menu and settings. -->
<UserControl x:Class="WoWCharacterTracker.Views.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WoWCharacterTracker.Views">
  <UserControl.Resources>
    <!-- A plain icon button in the header (sync, ?, settings): the glyph lights up on hover or while
         its menu or page is open (Tag "active"). -->
    <Style x:Key="HeaderIcon" TargetType="ButtonBase">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Bd" Width="36" Height="36" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A line in the ? menu: icon and text. -->
    <Style x:Key="MenuLine" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Padding="10,7" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- The tabs stay in the middle of the window: both sides get the same share of what's left (*),
       whatever they hold, so a longer status line never moves them. The status line shortens
       ("...") when its side runs out of room. -->
  <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel>
      <Image DockPanel.Dock="Left" Source="/Assets/wordmark.png" Height="58" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Character Tracker" FontSize="26" FontWeight="Bold" Foreground="White"/>
        <!-- Docked so the status (last, it fills) gives way first; left aligned so the version
             and update button sit right after it while there's room. -->
        <DockPanel Margin="0,2,0,0" HorizontalAlignment="Left">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE823;" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,6,0"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{Binding Updates.VersionText}" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <!-- A new version: a filled button that can't be missed, one click installs it. -->
            <Button Style="{StaticResource IndigoButton}" Padding="10,3" Margin="8,0,0,0" FontSize="12" Command="{Binding Updates.InstallUpdateCommand}"
                    ToolTip="Download and install the new version now. The app restarts by itself in a few seconds; your settings stay."
                    VerticalAlignment="Center" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Foreground="White" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Updates.UpdateButtonText}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding SelectedFlavor.StatusText}" Foreground="{StaticResource Muted}" FontSize="13"
                     MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFlavor.StatusText}"/>
        </DockPanel>
      </StackPanel>
    </DockPanel>

    <Border x:Name="GameTabs" Grid.Column="1" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
      <Grid>
        <ListBox x:Name="Tabs" ItemsSource="{Binding FlavorTabs}" SelectedItem="{Binding SelectedFlavor}" ItemContainerStyle="{StaticResource FlavorTab}"
                 Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <!-- The switch animation flies over the tabs (Ui/TabOrb). -->
        <Canvas x:Name="OrbLayer" IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <!-- The icons keep their room; the search box takes what's left, up to its full width. -->
    <DockPanel Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">

      <!-- Sync now: read the game's saved data again. The icon spins while a sync runs. -->
      <Button Style="{StaticResource HeaderIcon}" Command="{Binding SyncCommand}" AutomationProperties.Name="Sync now"
              ToolTip="Sync now: read the game's saved data again and post anything new. It also happens by itself.">
        <TextBlock Text="&#xE72C;" FontSize="16" RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <RotateTransform/>
          </TextBlock.RenderTransform>
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.8"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin"/>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Button>

      <!-- Help: the tour, what's new, the in game commands, feedback and the update check, in one menu.
           The button can't be clicked while the menu is open, so a click outside (on it too) just closes it. -->
      <ToggleButton x:Name="HelpButton" Style="{StaticResource HeaderIcon}" IsChecked="{Binding ShowHelp}" AutomationProperties.Name="Help"
                    ToolTip="Help, what's new and feedback" IsHitTestVisible="{Binding IsOpen, ElementName=HelpMenu, Converter={StaticResource Not}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE9CE;" FontSize="18"/>
      </ToggleButton>
      <Popup x:Name="HelpMenu" IsOpen="{Binding ShowHelp}" StaysOpen="False" PlacementTarget="{Binding ElementName=HelpButton}"
             Placement="Bottom" HorizontalOffset="-220" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Width="260" Padding="6" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <Button Style="{StaticResource MenuLine}" Command="{Binding Intro.OpenCommand}" ToolTip="A short walk through the app">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="13" Width="22" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Show me around" FontSize="13" Foreground="{StaticResource Text}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuLine}" Command="{Binding OpenChangelogCommand}" ToolTip="What changed in the last three versions">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="13" Width="22" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="What's new" FontSize="13" Foreground="{StaticResource Text}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuLine}" Cursor="Help" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="13" Width="22" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="In game commands" FontSize="13" Foreground="{StaticResource Text}"/>
              </StackPanel>
              <Button.ToolTip>
                <StackPanel>
                  <TextBlock Text="In game commands" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <!-- Two columns with the same line height, so each command lines up with what it does
                       (the addon's /wct help, Commands.lua, has the same list). -->
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="20" Margin="0,0,16,0">
                      /wct<LineBreak/>/wct times<LineBreak/>/wct test<LineBreak/>/wct live<LineBreak/>/wct popup<LineBreak/>
                      /wct note<LineBreak/>/wct note lock<LineBreak/>/wct friends<LineBreak/>/wct friends help<LineBreak/>
                      /wct options<LineBreak/>/wct debug<LineBreak/>/wct help
                    </TextBlock>
                    <TextBlock FontSize="12" LineHeight="20">
                      the addon window, with every option<LineBreak/>
                      your last 10 level times<LineBreak/>
                      check that instant posting works<LineBreak/>
                      instant posting on or off<LineBreak/>
                      reload popup after a ding on or off<LineBreak/>
                      this character's note box, on or off<LineBreak/>
                      pin it (unlock moves it, reset centers it)<LineBreak/>
                      the Battle.net friends you share with<LineBreak/>
                      asking, sharing, what friends get<LineBreak/>
                      the addon's page in the game's options<LineBreak/>
                      save details for tracking down problems<LineBreak/>
                      this list, in game
                    </TextBlock>
                  </StackPanel>
                  <!-- What reaches the app right away, and what waits for the game to write its saved file. -->
                  <TextBlock Text="What updates when" FontWeight="SemiBold" Margin="0,14,0,6"/>
                  <TextBlock FontSize="12" LineHeight="19" MaxWidth="440" TextWrapping="Wrap">
                    <Run Text="Right away (live):" FontWeight="SemiBold"/>
                    <Run Text="level-ups, boss kills, posted loot, mounts, hardcore deaths, duels, Mak'gora and rating steps, and a check-in about 15 seconds after you log in (level, gear level, zone, gold, talents, the Forever portrait)."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="On /reload or logout:" FontWeight="SemiBold"/>
                    <Run Text="gear, bags and bank, stats, talent picks, and loot that isn't posted. The game only writes its saved file then (or when you exit). Loading screens like dungeons, portals and boats don't count, and a crash doesn't save. The bank updates when you open it."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="Settings from Sharing reach the game on your next /reload or login."/>
                  </TextBlock>
                </StackPanel>
              </Button.ToolTip>
            </Button>
            <Button Style="{StaticResource MenuLine}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/JDybeck/wow-character-tracker/discussions"
                    ToolTip="Ideas, questions or something not working? Tell us on the Discussions page (opens GitHub)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xED15;" FontSize="13" Width="22" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Feedback" FontSize="13" Foreground="{StaticResource Text}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuLine}" Command="{Binding Updates.CheckUpdatesCommand}" ToolTip="Look for a new version on GitHub"
                    Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Hidden}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Width="22" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Updates.UpdateButtonText}" FontSize="13" Foreground="{StaticResource Text}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Popup>
      <!-- What's new: the last versions, opened from the ? menu. -->
      <Popup x:Name="ChangelogPopup" IsOpen="{Binding Updates.ShowChangelog}" StaysOpen="False" PlacementTarget="{Binding ElementName=HelpButton}"
             Placement="Bottom" HorizontalOffset="-300" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
        <views:ChangelogPanel/>
      </Popup>

      <Button x:Name="SettingsButton" Style="{StaticResource HeaderIcon}" Command="{Binding ShowPageCommand}" CommandParameter="settings"
              Tag="{Binding Page, Converter={StaticResource ActiveIf}, ConverterParameter=settings}" AutomationProperties.Name="Settings" ToolTip="Settings">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="18"/>
      </Button>
      </StackPanel>

      <!-- Search: finds items on every character (opens Characters, Items). -->
      <Grid MaxWidth="230" MinWidth="120" HorizontalAlignment="Right">
        <TextBox x:Name="SearchBox" ToolTip="Search items on all your characters" Padding="30,7,10,7"
                 Text="{Binding SelectedFlavor.Items.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" TextChanged="Search_TextChanged"/>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Dim}" FontSize="13" Margin="11,0,0,0" IsHitTestVisible="False"/>
        <TextBlock Text="Search items" Foreground="{StaticResource Faint}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   TextTrimming="CharacterEllipsis" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource HiddenIfSet}}"/>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
