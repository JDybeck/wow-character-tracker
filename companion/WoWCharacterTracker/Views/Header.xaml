<!-- Top bar: logo, title, update check, game tabs, commands, settings and Sync now. -->
<UserControl x:Class="WoWCharacterTracker.Views.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">
  <!-- The tabs stay in the middle of the window: both sides get the same share of what's left (*),
       whatever they hold, so a longer status line never moves them. The status line shortens
       ("...") when its side runs out of room. -->
  <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel>
      <Image DockPanel.Dock="Left" Source="/Assets/logo.png" Width="56" Height="56" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Character Tracker" FontSize="26" FontWeight="Bold" Foreground="White"/>
        <!-- Docked so the status (last, it fills) gives way first; left aligned so the version
             and update button sit right after it while there's room. -->
        <DockPanel Margin="0,2,0,0" HorizontalAlignment="Left">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE823;" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,6,0"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{Binding Updates.VersionText}" Foreground="{StaticResource Faint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <!-- A new version: a filled button that can't be missed, one click installs it. -->
            <Button Style="{StaticResource IndigoButton}" Padding="10,3" Margin="8,0,0,0" FontSize="12" Command="{Binding Updates.InstallUpdateCommand}"
                    ToolTip="Download and install the new version now. The app restarts by itself in a few seconds; your settings stay."
                    VerticalAlignment="Center" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Foreground="White" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Updates.UpdateButtonText}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Padding="6,0" Margin="4,0,0,0" Command="{Binding Updates.CheckUpdatesCommand}"
                    ToolTip="Look for a new version on GitHub" VerticalAlignment="Center"
                    Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Hidden}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Foreground="{DynamicResource BlueText}" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Updates.UpdateButtonText}" FontSize="12" Foreground="{DynamicResource BlueText}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding SelectedFlavor.StatusText}" Foreground="{StaticResource Muted}" FontSize="13"
                     MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFlavor.StatusText}"/>
        </DockPanel>
      </StackPanel>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
      <Grid>
        <ListBox x:Name="Tabs" ItemsSource="{Binding FlavorTabs}" SelectedItem="{Binding SelectedFlavor}" ItemContainerStyle="{StaticResource FlavorTab}"
                 Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <!-- The switch animation flies over the tabs (Ui/TabOrb). -->
        <Canvas x:Name="OrbLayer" IsHitTestVisible="False"/>
      </Grid>
    </Border>

    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <!-- Feedback: the repo's Discussions page. -->
      <Button Style="{StaticResource GhostButton}" Padding="6,4" Margin="0,0,6,0" Command="{Binding OpenUrlCommand}"
              CommandParameter="https://github.com/JDybeck/wow-character-tracker/discussions"
              ToolTip="Ideas, questions or something not working? Tell us on the Discussions page (opens GitHub)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xED15;" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
          <TextBlock Text="Feedback" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Border Width="26" Height="26" Background="Transparent" Margin="0,0,10,0" Cursor="Help"
              ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="60000">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border.ToolTip>
          <StackPanel>
            <TextBlock Text="In-game commands" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="20">
              /wct          your last 10 level times<LineBreak/>
              /wct test     check that instant posting works<LineBreak/>
              /wct live     instant posting on or off<LineBreak/>
              /wct popup    reload popup after a ding on or off<LineBreak/>
              /wct debug    save details for tracking down problems<LineBreak/>
              /wct help     this list, in game
            </TextBlock>

            <!-- What reaches the app right away, and what waits for the game to write its saved file. -->
            <TextBlock Text="What updates when" FontWeight="SemiBold" Margin="0,14,0,6"/>
            <TextBlock FontSize="12" LineHeight="19" MaxWidth="440" TextWrapping="Wrap">
              <Run Text="Right away (live):" FontWeight="SemiBold"/>
              <Run Text="level-ups, boss kills, posted loot, mounts, hardcore deaths, duels, Mak'gora and rating steps, and a check-in about 15 seconds after you log in (level, gear level, zone, gold, talents, the Forever portrait)."/>
              <LineBreak/><LineBreak/>
              <Run Text="On /reload or logout:" FontWeight="SemiBold"/>
              <Run Text="gear, bags and bank, stats, talent picks, and loot that isn't posted. The game only writes its saved file then (or when you exit). Loading screens like dungeons, portals and boats don't count, and a crash doesn't save. The bank updates when you open it."/>
              <LineBreak/><LineBreak/>
              <Run Text="Settings from What gets posted reach the game on your next /reload or login."/>
            </TextBlock>
          </StackPanel>
        </Border.ToolTip>
      </Border>

      <!-- App settings. The button can't be clicked while the menu is open, so a click outside
           (on the button too) just closes it. -->
      <ToggleButton x:Name="SettingsButton" IsChecked="{Binding ShowSettings}" Cursor="Hand" Margin="0,0,12,0" ToolTip="Open the app settings"
                    IsHitTestVisible="{Binding IsOpen, ElementName=SettingsMenu, Converter={StaticResource Not}}">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Width="34" Height="34" CornerRadius="8" Background="Transparent">
              <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE713;" FontSize="18" Foreground="{StaticResource Muted}"
                         HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="SettingsMenu" IsOpen="{Binding ShowSettings}" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsButton}"
             Placement="Bottom" HorizontalOffset="-250" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Width="300" Padding="16,14" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock Text="Settings" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
            <CheckBox IsChecked="{Binding OpenWithWow}"
                      ToolTip="Waits in the tray and opens when you start World of Warcraft. Closing the window keeps it tracking in the tray.">
              <TextBlock Text="Open with World of Warcraft" FontSize="13" Foreground="{StaticResource TextSoft}"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding HideWhenGameCloses}" Margin="24,10,0,0" IsEnabled="{Binding OpenWithWow}"
                      ToolTip="Off: the window stays open when the game closes, so you can look things over after playing.">
              <TextBlock Text="Hide the window when the game closes" FontSize="13" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"/>
            </CheckBox>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,14"/>
            <!-- Which games the app looks at (a game that's off keeps its tab, with a way back on). -->
            <ItemsControl ItemsSource="{Binding FlavorTabs}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FlavorViewModel}">
                  <CheckBox IsChecked="{Binding TrackThis}" IsEnabled="{Binding CanToggle}" Margin="0,0,0,8"
                            ToolTip="Off: the app doesn't look for this game, read its data or install the addon there. At least one game stays on.">
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSoft}"><Run Text="Track "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,6,0,14"/>
            <CheckBox IsChecked="{Binding Animations}" Margin="0,0,0,12"
                      ToolTip="Slides between pages and games, characters that unfold when opened, and the orb between the game tabs. Off: everything switches instantly.">
              <TextBlock Text="Animations" FontSize="13" Foreground="{StaticResource TextSoft}"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding ShowTestCharacters}"
                      ToolTip="Show made-up Forever characters (Zeb, Fågelmannen, Goggo) to try the app without playing. They're never posted on their own.">
              <TextBlock Text="Test characters" FontSize="13" Foreground="{StaticResource TextSoft}"/>
            </CheckBox>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,14"/>
            <!-- Color themes for the open game tab (AppearanceViewModel). -->
            <TextBlock Text="{Binding Appearance.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Appearance.Choices}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ThemeChoice}">
                  <Button Command="{Binding DataContext.Appearance.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Key}" Cursor="Hand" ToolTip="{Binding Description}" Margin="0,0,0,4">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="6,5" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                          <DockPanel>
                            <!-- Swatches: the card color with the accents on it. -->
                            <Border DockPanel.Dock="Left" Width="44" Height="22" CornerRadius="5" Background="{Binding Bg}" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding Accent}" Margin="1,0"/>
                                <Ellipse Width="9" Height="9" Fill="{Binding Second}" Margin="1,0"/>
                                <Ellipse Width="9" Height="9" Fill="{Binding AccentText}" Margin="1,0"/>
                              </StackPanel>
                            </Border>
                            <TextBlock x:Name="Check" DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                                       Foreground="{DynamicResource BlueText}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"/>
                          </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueLine}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,14"/>
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-12,0,0,0" Padding="12,4"
                    Command="{Binding ShowUninstallCommand}" ToolTip="Pick what to remove: the app, the addon, your data, settings">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,7,0"/>
                <TextBlock Text="Uninstall..." FontSize="13" Foreground="{StaticResource TextSoft}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Popup>

      <Button Style="{StaticResource PrimaryButton}" Command="{Binding SyncCommand}"
              ToolTip="Read the game's saved data again and post anything new">
        <StackPanel Orientation="Horizontal">
          <!-- The icon spins while a sync runs. -->
          <TextBlock Text="&#xE72C;" Foreground="White" FontSize="15" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <RotateTransform/>
            </TextBlock.RenderTransform>
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                    <DataTrigger.EnterActions>
                      <BeginStoryboard x:Name="Spin">
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.8"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <StopStoryboard BeginStoryboardName="Spin"/>
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Foreground="White">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Sync now"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                    <Setter Property="Text" Value="Syncing..."/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
