<!-- The Professions page: every profession your characters on this game tab have, by server and
     faction (Views/ProfessionsView). DataContext: the game tab (FlavorViewModel). -->
<UserControl x:Class="WoWCharacterTracker.Views.ProfessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WoWCharacterTracker.Views">
  <Border Style="{StaticResource CardBorder}" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="24,12">
        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Who has which profession, and how far along. Skill updates on /reload, logout and when a character checks in. Open a profession once in game, then click the character for its recipes."/>
      </Border>
      <views:ProfessionsView Grid.Row="1" DataContext="{Binding Professions}"/>
    </Grid>
  </Border>
</UserControl>
