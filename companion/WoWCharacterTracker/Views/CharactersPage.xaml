<!-- The character list with details for the selected character. -->
<UserControl x:Class="WoWCharacterTracker.Views.CharactersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure"
             xmlns:views="clr-namespace:WoWCharacterTracker.Views">
  <UserControl.Resources>
    <!-- The open character's details: the tab strip, then only the open tab's view. -->
    <DataTemplate x:Key="CharacterDetails" DataType="{x:Type vm:CharacterRow}">
      <Border Margin="24,0,24,16" Padding="18,2,18,16" CornerRadius="10" Background="#660F172A" BorderBrush="{DynamicResource Line}" BorderThickness="1" ui:Motion.Reveal="True">
        <StackPanel>
          <Border Margin="0,2,0,2">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource DetailTab}" Content="Overview" ToolTip="Who the character is, tags, posting and highlights" IsChecked="{Binding IsOverviewTab}" GroupName="{Binding Guid}"/>
              <RadioButton Style="{StaticResource DetailTab}" Content="Gear and bags" ToolTip="Equipped gear, bags and bank" IsChecked="{Binding IsGearTab}" GroupName="{Binding Guid}"/>
              <RadioButton Style="{StaticResource DetailTab}" Content="Leveling" ToolTip="Level times, the chart and the level history" IsChecked="{Binding IsLevelingTab}" GroupName="{Binding Guid}"/>
              <RadioButton Style="{StaticResource DetailTab}" Content="Notes" ToolTip="Your own notes for this character" IsChecked="{Binding IsNotesTab}" GroupName="{Binding Guid}"/>
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding}" Focusable="False">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate">
                  <Setter.Value>
                    <DataTemplate><views:CharacterOverview ui:Motion.FadeIn="True"/></DataTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DetailTab}" Value="gear">
                    <Setter Property="ContentTemplate">
                      <Setter.Value>
                        <DataTemplate><views:CharacterGear ui:Motion.FadeIn="True"/></DataTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DetailTab}" Value="notes">
                    <Setter Property="ContentTemplate">
                      <Setter.Value>
                        <DataTemplate><views:CharacterNotes ui:Motion.FadeIn="True"/></DataTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DetailTab}" Value="leveling">
                    <Setter Property="ContentTemplate">
                      <Setter.Value>
                        <DataTemplate><views:CharacterLeveling ui:Motion.FadeIn="True"/></DataTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- DataContext: the game tab (FlavorViewModel); MainWindow has one of these per tab. -->
  <Border Style="{StaticResource CardBorder}" ClipToBounds="True" ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="0"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=characters}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="2" Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12"
              Padding="24,10" Visibility="{Binding HasCharacters, Converter={StaticResource Visible}}">
        <StackPanel Orientation="Horizontal">
          <Image Source="{StaticResource GoldBag}" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding TotalGoldText}" Foreground="{StaticResource TextSoft}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <ItemsControl ItemsSource="{Binding TotalCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Row}" VerticalAlignment="Center"/>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Foreground="{StaticResource Dim}" FontSize="13" Margin="18,0,8,0"
                     Visibility="{Binding TotalPlayedText, Converter={StaticResource VisibleIfSet}}"/>
          <TextBlock Text="{Binding TotalPlayedText}" Foreground="{StaticResource TextSoft}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource CardHeader}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
        <StackPanel>
        <!-- Filter by realm (Retail) or ruleset (Forever). -->
        <views:ChipBar DataContext="{Binding Groups}" Margin="35,12,35,0"/>
        <Grid Margin="35,14,43,14"> <!-- lines up with the rows: their frame margin (10) + border (1) + 24, and the list's 8 px scrollbar lane on the right -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource ColClass}"/>
            <ColumnDefinition Width="{StaticResource ColLevel}"/>
            <ColumnDefinition Width="{StaticResource ColIlvl}"/>
            <ColumnDefinition Width="{StaticResource ColGold}"/>
            <ColumnDefinition Width="{StaticResource ColSeen}"/>
          </Grid.ColumnDefinitions>
          <!-- Click to sort, again to flip. Race, played time and rating have no column: they sit next to CHARACTER. -->
          <!-- Wraps on narrow windows instead of cutting off RACE and PLAYED. -->
          <WrapPanel Margin="0,0,8,0">
            <Button Style="{StaticResource SortHeader}" Content="CHARACTER" Tag="{Binding Sort[name]}" Command="{Binding SortCommand}" CommandParameter="name"/>
            <TextBlock Text="sort by" Style="{StaticResource ColumnHeader}" Foreground="{StaticResource Faint}" FontWeight="Normal" Margin="18,0,8,0"/>
            <Button Style="{StaticResource SortHeader}" Content="RACE" Tag="{Binding Sort[race]}" Command="{Binding SortCommand}" CommandParameter="race" Margin="0,0,10,0"/>
            <Button Style="{StaticResource SortHeader}" Content="PLAYED" Tag="{Binding Sort[played]}" Command="{Binding SortCommand}" CommandParameter="played" Margin="0,0,10,0"/>
            <Button Style="{StaticResource SortHeader}" Content="RATING" Tag="{Binding Sort[rating]}" Command="{Binding SortCommand}" CommandParameter="rating"
                    Visibility="{Binding IsRetail, Converter={StaticResource Visible}}"/>
          </WrapPanel>
          <Button Grid.Column="1" Style="{StaticResource SortHeader}" Content="CLASS" Tag="{Binding Sort[class]}" Command="{Binding SortCommand}" CommandParameter="class"/>
          <Button Grid.Column="2" Style="{StaticResource SortHeader}" Content="LEVEL" Tag="{Binding Sort[level]}" Command="{Binding SortCommand}" CommandParameter="level"/>
          <Button Grid.Column="3" Style="{StaticResource SortHeader}" Content="ITEM LEVEL" Tag="{Binding Sort[ilvl]}" Command="{Binding SortCommand}" CommandParameter="ilvl"/>
          <Button Grid.Column="4" Style="{StaticResource SortHeader}" Content="GOLD" Tag="{Binding Sort[gold]}" Command="{Binding SortCommand}" CommandParameter="gold"/>
          <Button Grid.Column="5" Style="{StaticResource SortHeader}" Content="LAST SEEN" Tag="{Binding Sort[seen]}" Command="{Binding SortCommand}" CommandParameter="seen"/>
        </Grid>
        </StackPanel>
      </Border>

      <ListBox Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
               Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CharacterItem}" Padding="0,6"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"> <!-- only the rows on screen are built -->
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:CharacterRow}">
            <StackPanel>
              <Grid Margin="24,12" Background="Transparent" PreviewMouseLeftButtonDown="CharacterHeader_MouseDown">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="{StaticResource ColClass}"/>
                  <ColumnDefinition Width="{StaticResource ColLevel}"/>
                  <ColumnDefinition Width="{StaticResource ColIlvl}"/>
                  <ColumnDefinition Width="{StaticResource ColGold}"/>
                  <ColumnDefinition Width="{StaticResource ColSeen}"/>
                </Grid.ColumnDefinitions>

                <!-- Portrait, then the name (trimmed when long) over realm and tag. -->
                <DockPanel>
                  <Grid DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,12,0">
                    <Ellipse Fill="{Binding ClassSoftBrush}" Stroke="#1AFFFFFF"/>
                    <TextBlock Text="{Binding Initial}" Foreground="{Binding ClassBrush}" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding PictureUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21"/>
                      </Image.Clip>
                    </Image>
                    <Ellipse Stroke="{Binding ClassBrush}" StrokeThickness="1.5" Opacity="0.7"/>
                  </Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource TrimmedText}" Text="{Binding FullName}" Foreground="{Binding ClassBrush}" FontSize="15" FontWeight="SemiBold"/>
                    <!-- On a narrow window the tag wraps under the realm, and the realm trims when even alone it doesn't fit. -->
                    <WrapPanel Margin="0,2,0,0">
                      <DockPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Style="{StaticResource TrimmedText}" Text="{Binding RealmText}" Foreground="{StaticResource Dim}" FontSize="12"/>
                      </DockPanel>
                      <Border x:Name="TagBox" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                              Background="#33F87171" Visibility="{Binding Tag, Converter={StaticResource VisibleIfSet}}">
                        <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Red}"/>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="22" Height="22" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding SpecIconTip}"
                          Visibility="{Binding SpecIconUrl, Converter={StaticResource VisibleIfSet}}">
                    <Image Source="{Binding SpecIconUrl, Converter={StaticResource WebImage}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding ClassName}" Foreground="{Binding ClassBrush}" FontWeight="Medium" FontSize="13"/>
                    <TextBlock Text="{Binding Spec}" Foreground="{StaticResource Dim}" FontSize="11"
                               Visibility="{Binding Spec, Converter={StaticResource VisibleIfSet}}"/>
                  </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Pill}">
                  <TextBlock Text="{Binding Level}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource TextSoft}"/>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Pill}" Background="#4D1E3A8A" BorderBrush="#801D4ED8">
                  <TextBlock Text="{Binding ItemLevelText}" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{DynamicResource BlueText}"/>
                </Border>

                <Grid Grid.Column="4" VerticalAlignment="Center" ToolTip="{Binding MoneyText}">
                  <ItemsControl ItemsSource="{Binding ShortCoins}" ItemTemplate="{StaticResource CoinTemplate}" ItemsPanel="{StaticResource Row}"
                                Visibility="{Binding HasMoney, Converter={StaticResource Visible}}"/>
                  <TextBlock Text="-" Foreground="{StaticResource Dim}" Visibility="{Binding HasMoney, Converter={StaticResource Hidden}}"/>
                </Grid>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding LastSeenText}" Foreground="{StaticResource Muted}" FontSize="13"/>
                  <TextBlock Text="{Binding PlayedLine}" Foreground="{StaticResource Faint}" FontSize="10" Margin="0,2,0,0"
                             Visibility="{Binding PlayedLine, Converter={StaticResource VisibleIfSet}}"/>
                </StackPanel>
              </Grid>

              <!-- Details for the selected character, in tabs so it stays readable. They're only built
                   for the open character and the open tab: the gear and bags alone are hundreds of icons. -->
              <!-- No content at all while closed (an empty template would show the row's type name). -->
              <ContentControl Focusable="False">
                <ContentControl.Style>
                  <Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{x:Null}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Content" Value="{Binding}"/>
                        <Setter Property="ContentTemplate" Value="{StaticResource CharacterDetails}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ContentControl.Style>
              </ContentControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty state -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                  Visibility="{Binding HasCharacters, Converter={StaticResource Hidden}}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="34" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
        <TextBlock Text="No characters yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Log in to a character in this game version and type /reload (or log out). Your characters show up here after that."/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
