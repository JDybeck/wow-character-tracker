<!-- Uninstall: everything the app and the addon created, picked part by part (with presets), every path
     shown, and afterwards what was removed. Opened from the settings gear. -->
<UserControl x:Class="WoWCharacterTracker.Views.UninstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <Border Style="{StaticResource CardBorder}" ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="4" DataContext="{Binding Uninstall}"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=uninstall}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22">
        <TextBlock Text="Uninstall Character Tracker" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

        <!-- Picking what goes -->
        <StackPanel Visibility="{Binding NotDone, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                     Text="Pick what to remove. Every file and folder is listed, and nothing is removed until you click Uninstall."/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource ButtonBase}" Padding="12,5" Command="{Binding KeepDataCommand}" Margin="0,0,6,0"
                    ToolTip="Remove the app and the addon, keep your character data and settings for later">
              <TextBlock Text="Keep my data"/>
            </Button>
            <Button Style="{StaticResource ButtonBase}" Padding="12,5" Command="{Binding EverythingCommand}" Margin="0,0,6,0" ToolTip="Remove everything the app and the addon created">
              <TextBlock Text="Remove everything"/>
            </Button>
            <Button Style="{StaticResource ButtonBase}" Padding="12,5" Command="{Binding OnlyAppCommand}" ToolTip="Remove only the app; the addon, your data and settings stay">
              <TextBlock Text="Only the app"/>
            </Button>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:UninstallRow}">
                <Border x:Name="Box" Padding="16,12" Margin="0,0,0,10" CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="12,2,0,0"/>
                    <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Top">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}"/>
                        <TextBlock Text="{Binding PathsText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                      </StackPanel>
                    </CheckBox>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="#80F87171"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- What stays either way -->
          <Border Padding="16,12" Margin="0,4,0,16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Line}">
            <StackPanel>
              <TextBlock Text="Stays on your PC either way" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" LineHeight="18"
                         Text="Your screenshots in the game's Screenshots folders (the app can't tell yours from the addon's). Your Discord webhooks keep existing in Discord: delete them under the channel's Integrations if you like. If you turned on Advanced combat logging, the game keeps that setting (System, Network)."/>
            </StackPanel>
          </Border>

          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource ButtonBase}" Padding="16,7" Background="#7F1D1D" BorderBrush="#B91C1C" Command="{Binding UninstallCommand}">
                <TextBlock Text="Uninstall" Foreground="White" FontWeight="SemiBold"/>
              </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalText}" FontSize="12" Foreground="{StaticResource TextSoft}"/>
              <TextBlock Text="{Binding Blocked}" FontSize="12" Foreground="{StaticResource Red}" TextWrapping="Wrap"
                         Visibility="{Binding Blocked, Converter={StaticResource VisibleIfSet}}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>

        <!-- Afterwards -->
        <StackPanel Visibility="{Binding Done, Converter={StaticResource Visible}}" Margin="0,10,0,0">
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:UninstallRow}">
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Green}" FontSize="12" Width="22"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{StaticResource Red}" TextWrapping="Wrap"
                               Visibility="{Binding Failed, Converter={StaticResource Visible}}"/>
                  </StackPanel>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="Mark" Property="Text" Value="&#xE711;"/>
                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Red}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,12" TextWrapping="Wrap"
                     Text="Done. The app closes now, and if you picked it, removes itself a moment later. Anything that couldn't be removed is listed above with the reason."/>
          <Button Style="{StaticResource ButtonBase}" HorizontalAlignment="Left" Padding="16,7" Command="{Binding CloseCommand}">
            <TextBlock Text="Close the app"/>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
