<!-- The Stream overlay panel (between Discord and the console), collapsible: on/off, the overlay's
     addresses (everything, or the card, highlights and alert as separate sources), the buttons,
     how it looks, what it shows and what it counts (all, today, since now). DataContext: StreamViewModel. -->
<UserControl x:Class="WoWCharacterTracker.Views.StreamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <UserControl.Resources>
    <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:ToggleOption}">
      <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" ToolTip="{Binding Tip}" Margin="0,0,6,6"/>
    </DataTemplate>
  </UserControl.Resources>
  <Border Style="{StaticResource CardBorder}" Padding="18,12">
    <StackPanel>
      <!-- Header: click to fold; the switch turns the overlay on or off. -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding TogglePanelCommand}"
                ToolTip="Show or hide the stream options" VerticalAlignment="Center">
          <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Text" Value="&#xE70D;"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PanelOpen}" Value="True">
                    <Setter Property="Text" Value="&#xE70E;"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Button>
        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                  ToolTip="On: a page only your PC can open, for OBS or Streamlabs, plus text files. Off: nothing runs.">
          <TextBlock Text="On" FontSize="12" Foreground="{StaticResource TextSoft}"/>
        </CheckBox>
        <Button Style="{StaticResource GhostButton}" Padding="0" Command="{Binding TogglePanelCommand}" HorizontalAlignment="Left" Background="Transparent">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Foreground="{DynamicResource Indigo}" FontSize="16" Margin="0,0,10,0"/>
            <TextBlock Text="Stream overlay" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </DockPanel>

      <StackPanel Visibility="{Binding PanelOpen, Converter={StaticResource Visible}}" Margin="0,8,0,2">
        <!-- Off -->
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Enabled, Converter={StaticResource Hidden}}"
                   Text="Optional: show your character, level times, duel record, highlights and big alerts (DING!, VICTORY!, EPIC LOOT!...) on stream (OBS or Streamlabs). Tick On to get the address."/>

        <!-- On -->
        <StackPanel Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding Url}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource BlueText}"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"
                     Text="Add as a Browser source. Copy one address for everything, or each part on its own to place them separately:"/>
          <WrapPanel Margin="0,0,0,2">
            <Button Style="{StaticResource SmallButton}" Content="Copy all" Command="{Binding CopyCommand}" CommandParameter=""
                    ToolTip="Copy the address of the whole overlay: card, highlights and alerts in one Browser source"/>
            <Button Style="{StaticResource SmallButton}" Content="Card" Command="{Binding CopyCommand}" CommandParameter="?only=card"
                    ToolTip="Copy the address of just the character card: stats and records, next to the level times"/>
            <Button Style="{StaticResource SmallButton}" Content="Highlights" Command="{Binding CopyCommand}" CommandParameter="?only=highlights"
                    ToolTip="Copy the address of just the highlights box: the latest loot, boss kills, duel wins..."/>
            <Button Style="{StaticResource SmallButton}" Content="Alert" Command="{Binding CopyCommand}" CommandParameter="?only=alert"
                    ToolTip="Copy the address of just the alert (DING!, VICTORY!, EPIC LOOT!...). Make its Browser source roomy, the glow fades out at the edges."/>
          </WrapPanel>
          <WrapPanel Margin="0,0,0,8">
            <Button Style="{StaticResource SmallButton}" Content="Preview" Command="{Binding OpenOverlayCommand}"
                    ToolTip="Open the overlay in your browser, on a dark backdrop, to see how it looks"/>
            <Button Style="{StaticResource SmallButton}" Content="Test alert" Command="{Binding TestAlertCommand}"
                    ToolTip="Shows an alert on the overlay now (in OBS too), without posting anything. Click again for the next kind: DING!, MAX LEVEL!, VICTORY!, EPIC LOOT!..."/>
            <Button Style="{StaticResource SmallButton}" Content="Text files" Command="{Binding OpenFolderCommand}"
                    ToolTip="One value per file (level, last level time, duels...), for OBS Text sources with Read from file"/>
          </WrapPanel>

          <!-- Look -->
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Card bg" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CardOpacity, StringFormat={}{0}%}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding CardOpacity, Delay=150}" VerticalAlignment="Center"
                    ToolTip="How solid the card's background is: 0 is see-through (just the text), 100 is solid"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Highlights bg" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding HighlightsOpacity, StringFormat={}{0}%}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding HighlightsOpacity, Delay=150}" VerticalAlignment="Center"
                    ToolTip="How solid the highlights box's background is: 0 is see-through (just the text), 100 is solid"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Size" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Scale, StringFormat={}{0}%}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="50" Maximum="250" SmallChange="10" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Scale, Delay=150}" VerticalAlignment="Center"
                    ToolTip="How big the whole overlay is when it's one Browser source (Copy all). A part on its own (Card, Highlights, Alert) fills its source instead: resize the source in OBS."/>
          </DockPanel>
          <!-- Size of each box: the card and the highlights separately (Auto = fits its text). -->
          <TextBlock Text="Card" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
          <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="Width" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78" Margin="10,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CardWidthText}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="1000" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding CardWidth, Delay=150}" VerticalAlignment="Center"
                    ToolTip="The card's width in pixels (Auto fits its text). Make it wide and tall to cover your chat."/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="Height" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78" Margin="10,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CardHeightText}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="1000" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding CardHeight, Delay=150}" VerticalAlignment="Center"
                    ToolTip="The card's smallest height in pixels (Auto fits its text); the background fills the rest"/>
          </DockPanel>
          <TextBlock Text="Highlights" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="0,2,0,4"/>
          <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="Width" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78" Margin="10,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding HighlightsWidthText}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="1000" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding HighlightsWidth, Delay=150}" VerticalAlignment="Center"
                    ToolTip="The highlights box's width in pixels (Auto: 340). Long lines end in ..."/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" Text="Height" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78" Margin="10,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding HighlightsHeightText}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="1000" SmallChange="20" LargeChange="100" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding HighlightsHeight, Delay=150}" VerticalAlignment="Center"
                    ToolTip="The highlights box's height in pixels. Set, the box keeps that size and shows the newest lines that fit, so its Browser source never rescales. Auto: it grows with its lines (up to 3)."/>
          </DockPanel>

          <!-- Colors: a preset, or any hex color typed in. -->
          <TextBlock Text="COLORS" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,4"
                     ToolTip="The boxes' edge and titles (accent) and their background. Pick a preset or type a hex color like #3c8cff."/>
          <ItemsControl ItemsSource="{Binding Presets}" ItemsPanel="{StaticResource Wrap}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SmallButton}" Padding="8,3" Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Dot}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="Accent" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding AccentBrush}" BorderBrush="#475569" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Accent}" Width="76" Padding="6,3" FontSize="12" Margin="0,0,14,0" FontFamily="{StaticResource Mono}"
                     ToolTip="The edge and title color as a hex code, like #ffd100. Empty: the character's class color."/>
            <TextBlock Text="Background" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding BackgroundBrush}" BorderBrush="#475569" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Background}" Width="76" Padding="6,3" FontSize="12" FontFamily="{StaticResource Mono}"
                     ToolTip="The background color as a hex code, like #0a0806 (how solid it is: Card bg and Highlights bg above). Empty: dark."/>
          </WrapPanel>
          <WrapPanel Margin="0,0,0,6">
            <CheckBox Style="{StaticResource OptionChip}" Content="Border" IsChecked="{Binding ShowBorder}" Margin="0,0,6,6"
                      ToolTip="The thin colored edge around the card and the highlights"/>
          </WrapPanel>

          <TextBlock Text="CARD" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,4"
                     ToolTip="The card is the character as it is now: its stats on the left, its leveling on the right"/>
          <WrapPanel Margin="0,0,0,6">
            <CheckBox Style="{StaticResource OptionChip}" Content="Stats" IsChecked="{Binding ShowStats}" Margin="0,0,6,6"
                      ToolTip="Item level, played, gold and (Retail) your keystone"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Level times" IsChecked="{Binding ShowLevels}" Margin="0,0,6,6"
                      ToolTip="The last level's time and the ones before, beside the stats. Without level times the stats get the card."/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Today" IsChecked="{Binding ShowToday}" Margin="0,0,6,6"
                      ToolTip="Levels today and their average time, under the level times"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Duel record" IsChecked="{Binding ShowDuels}" Margin="0,0,6,6"
                      ToolTip="Duels won and lost"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Battleground record" IsChecked="{Binding ShowBattlegrounds}" Margin="0,0,6,6"
                      ToolTip="Battlegrounds won and lost (shown once there is one)"/>
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding CardFields}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChipTemplate}" Margin="0,0,0,6"
                        Visibility="{Binding ShowStats, Converter={StaticResource Visible}}" ToolTip="Which stats the card shows"/>

          <DockPanel Margin="0,0,0,4">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource OptionChip}" Content="Show" IsChecked="{Binding ShowHighlights}"
                      ToolTip="The highlights box: what happened lately, as a short list"/>
            <TextBlock Text="HIGHLIGHTS" Style="{StaticResource SectionTitle}" FontSize="11" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding HighlightKinds}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChipTemplate}" Margin="0,0,0,6"
                        Visibility="{Binding ShowHighlights, Converter={StaticResource Visible}}"/>

          <TextBlock Text="ALERTS" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,4"
                     ToolTip="Which moments pop up big in the middle, like Discord posts them"/>
          <ItemsControl ItemsSource="{Binding AlertKinds}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChipTemplate}" Margin="0,0,0,6"/>

          <!-- What it counts: one of three, the one in use highlighted. -->
          <TextBlock Text="COUNT" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,4"
                     ToolTip="What the overlay counts (records, highlights, level times). The app keeps tracking everything."/>
          <WrapPanel>
            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="StreamRange" Margin="0,0,6,6"
                         Content="{Binding NowText}" IsChecked="{Binding RangeNow, Mode=OneWay}" Command="{Binding StartFromNowCommand}"
                         ToolTip="Only count what happens from now on, like a fresh session. Click again to restart the count."/>
            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="StreamRange" Margin="0,0,6,6"
                         Content="Today" IsChecked="{Binding RangeToday, Mode=OneWay}" Command="{Binding TodayCommand}"
                         ToolTip="Count what happened today (since midnight); it starts over by itself every day"/>
            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="StreamRange" Margin="0,0,6,6"
                         Content="All" IsChecked="{Binding RangeAll, Mode=OneWay}" Command="{Binding AllTimeCommand}"
                         ToolTip="Count everything the character has done (all time)"/>
          </WrapPanel>

          <!-- What only one game has, one box per game (StreamViewModel.GameSections). -->
          <ItemsControl ItemsSource="{Binding GameSections}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource PanelBorder}" Padding="12,10,6,4" Margin="0,0,0,8" ToolTip="{Binding Tip}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Groups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Chips}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChipTemplate}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
