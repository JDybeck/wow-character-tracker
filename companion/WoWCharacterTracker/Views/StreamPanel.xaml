<!-- The Stream overlay panel (between Discord and the console), collapsible: on/off, the overlay's
     addresses (everything, or the card, highlights and ding alert as separate sources), the buttons,
     and how it looks and what it shows. DataContext: StreamViewModel. -->
<UserControl x:Class="WoWCharacterTracker.Views.StreamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels">
  <Border Style="{StaticResource CardBorder}" Padding="18,12">
    <StackPanel>
      <!-- Header: click to fold; the switch turns the overlay on or off. -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding TogglePanelCommand}"
                ToolTip="Show or hide the stream options" VerticalAlignment="Center">
          <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Text" Value="&#xE70D;"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PanelOpen}" Value="True">
                    <Setter Property="Text" Value="&#xE70E;"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Button>
        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                  ToolTip="On: a page only your PC can open, for OBS or Streamlabs, plus text files. Off: nothing runs.">
          <TextBlock Text="On" FontSize="12" Foreground="{StaticResource TextSoft}"/>
        </CheckBox>
        <Button Style="{StaticResource GhostButton}" Padding="0" Command="{Binding TogglePanelCommand}" HorizontalAlignment="Left" Background="Transparent">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Foreground="{DynamicResource Indigo}" FontSize="16" Margin="0,0,10,0"/>
            <TextBlock Text="Stream overlay" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </DockPanel>

      <StackPanel Visibility="{Binding PanelOpen, Converter={StaticResource Visible}}" Margin="0,8,0,2">
        <!-- Off -->
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Enabled, Converter={StaticResource Hidden}}"
                   Text="Optional: show your character, level times, duel record, highlights and a big DING! on stream (OBS or Streamlabs). Tick On to get the address."/>

        <!-- On -->
        <StackPanel Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding Url}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource BlueText}"/>
          <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,4" TextWrapping="Wrap"
                     Text="Add as a Browser source. Copy one address for everything, or each part on its own to place them separately:"/>
          <WrapPanel Margin="-8,0,0,4">
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Copy all" Command="{Binding CopyCommand}" CommandParameter=""/>
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Card" Command="{Binding CopyCommand}" CommandParameter="?only=card"
                    ToolTip="Copy the address of just the character card (level times, today, records)"/>
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Highlights" Command="{Binding CopyCommand}" CommandParameter="?only=highlights"
                    ToolTip="Copy the address of just the highlights box"/>
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Ding alert" Command="{Binding CopyCommand}" CommandParameter="?only=ding"
                    ToolTip="Copy the address of just the DING! alert"/>
          </WrapPanel>
          <WrapPanel Margin="-8,0,0,8">
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Preview" Command="{Binding OpenOverlayCommand}"/>
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Test ding" Command="{Binding TestDingCommand}"
                    ToolTip="Shows the DING! alert on the overlay now (in OBS too), without posting anything"/>
            <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Text files" Command="{Binding OpenFolderCommand}"
                    ToolTip="One value per file (level, last level time, duels...), for OBS Text sources with Read from file"/>
          </WrapPanel>

          <!-- Look -->
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Background" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Width="78"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CardOpacity, StringFormat={}{0}%}" FontSize="12" Foreground="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding CardOpacity, Delay=150}" VerticalAlignment="Center"
                    ToolTip="How solid the boxes' background is: 0 is see-through (just the text), 100 is solid"/>
          </DockPanel>

          <TextBlock Text="SHOW" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,4"/>
          <WrapPanel Margin="0,0,0,6">
            <CheckBox Style="{StaticResource OptionChip}" Content="Level times" IsChecked="{Binding ShowLevels}" Margin="0,0,6,6"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Today" IsChecked="{Binding ShowToday}" Margin="0,0,6,6"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Duel record" IsChecked="{Binding ShowDuels}" Margin="0,0,6,6"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Mak'gora record" IsChecked="{Binding ShowMakgora}" Margin="0,0,6,6"/>
            <CheckBox Style="{StaticResource OptionChip}" Content="Highlights" IsChecked="{Binding ShowHighlights}" Margin="0,0,6,6"/>
          </WrapPanel>

          <StackPanel Visibility="{Binding ShowHighlights, Converter={StaticResource Visible}}">
            <TextBlock Text="HIGHLIGHTS" Style="{StaticResource SectionTitle}" FontSize="11" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding HighlightKinds}" ItemsPanel="{StaticResource Wrap}" Margin="0,0,0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToggleOption}">
                  <CheckBox Style="{StaticResource OptionChip}" Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,0,6,6"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Start from now -->
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="Start from now" Command="{Binding StartFromNowCommand}"
                      ToolTip="The overlay only counts what happens from now on (records, highlights, level times). The app keeps tracking everything."/>
              <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="12" Content="All time" Command="{Binding AllTimeCommand}"
                      Visibility="{Binding CountingFromNow, Converter={StaticResource Visible}}"/>
            </StackPanel>
            <TextBlock Text="{Binding SinceText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
