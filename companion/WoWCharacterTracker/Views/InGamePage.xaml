<!-- In game: what the addon does in game besides posting. Reminders to /reload (so the app's items
     stay up to date) and game settings the app can switch. -->
<UserControl x:Class="WoWCharacterTracker.Views.InGamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui">
  <Border Style="{StaticResource CardBorder}" ui:Motion.SlideGroup="page" ui:Motion.SlideIndex="3" DataContext="{Binding SelectedFlavor}"
          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageIs}, ConverterParameter=ingame}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22">
        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White">
          <Run Text="In game for"/>
          <Run Text="{Binding Name, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                   Text="What the addon does in game besides posting. Changes reach the game on your next /reload or login."/>

        <!-- Reloads: the game only writes the addon's saved file on /reload or logout. -->
        <Border Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Keeping the app up to date" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                       Text="Gear, bags and bank only reach the app when you /reload or log out (loading screens don't count). These remind you when they changed."/>
            <CheckBox ToolTip="On a flight path, offer a /reload when your bags or gear changed" IsChecked="{Binding FlightReloadPrompt}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Offer a reload on flight paths" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                <TextBlock Style="{StaticResource Hint}" Text="When you take a flight and your bags or gear changed since the last save, a small box offers a /reload. You keep flying through it."/>
              </StackPanel>
            </CheckBox>
            <CheckBox ToolTip="Put a line in chat reminding you to /reload when your bags or gear changed" IsChecked="{Binding ChatReloadReminder}">
              <StackPanel>
                <TextBlock Text="Remind me in chat to /reload" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                <TextBlock Style="{StaticResource Hint}" Text="One line in chat when your bags or gear changed since the last save: after the bank, mailbox, a vendor or the auction house, when you leave a dungeon (at most every 10 minutes), and every 30 minutes."/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- The data grid: the small black and white pattern the addon flashes for one frame per event. -->
        <Border Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Instant posting" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="For each event the addon shows a small black and white pattern (about 320 x 30 pixels) in a corner for a single frame and takes a screenshot of it, which is how the app hears about it right away. Pick the corner that bothers you least."/>
            <WrapPanel Margin="0,0,0,12">
              <RadioButton Style="{StaticResource DetailTab}" Content="Top left" ToolTip="Show the instant-post pattern in the top left corner" IsChecked="{Binding GridTopLeft}" GroupName="{Binding Name, StringFormat=corner-{0}}" Margin="0,0,6,0"/>
              <RadioButton Style="{StaticResource DetailTab}" Content="Top right" ToolTip="Show the instant-post pattern in the top right corner" IsChecked="{Binding GridTopRight}" GroupName="{Binding Name, StringFormat=corner-{0}}" Margin="0,0,6,0"/>
              <RadioButton Style="{StaticResource DetailTab}" Content="Bottom left" ToolTip="Show the instant-post pattern in the bottom left corner" IsChecked="{Binding GridBottomLeft}" GroupName="{Binding Name, StringFormat=corner-{0}}" Margin="0,0,6,0"/>
              <RadioButton Style="{StaticResource DetailTab}" Content="Bottom right" ToolTip="Show the instant-post pattern in the bottom right corner" IsChecked="{Binding GridBottomRight}" GroupName="{Binding Name, StringFormat=corner-{0}}"/>
            </WrapPanel>
            <CheckBox ToolTip="Show a small &quot;Character Tracker /wct&quot; label next to the pattern" IsChecked="{Binding GridLabel}">
              <StackPanel>
                <TextBlock Text="Show a small label next to it" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                <TextBlock Style="{StaticResource Hint}" Text="&quot;Character Tracker /wct&quot;, so anyone watching (or you) knows what the flicker is."/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- Game settings the addon sets for you. -->
        <Border Padding="18,16" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Game settings" Margin="0,0,0,14"/>
            <CheckBox ToolTip="Turn on the game's Advanced Combat Logging setting" IsChecked="{Binding AdvancedCombatLog}">
              <StackPanel>
                <TextBlock Text="Advanced combat logging" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Turns on the game's own Advanced Combat Logging setting (System, Network): more detail in the combat log file, for log tools and for features here later. The addon sets it at your next /reload or login, out of combat. Unticking turns it off again."/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
