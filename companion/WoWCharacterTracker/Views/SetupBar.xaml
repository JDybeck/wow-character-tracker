<!-- Update banner and the three setup checks (game folder, addon, Discord) for the selected game. -->
<UserControl x:Class="WoWCharacterTracker.Views.SetupBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WoWCharacterTracker"
             xmlns:ui="clr-namespace:WoWCharacterTracker.Ui"
             xmlns:vm="clr-namespace:WoWCharacterTracker.ViewModels"
             xmlns:infra="clr-namespace:WoWCharacterTracker.Infrastructure">
  <StackPanel>
  <Border Visibility="{Binding Updates.ShowBanner, Converter={StaticResource Visible}}" Margin="0,0,0,14" Padding="16,12" CornerRadius="10"
          Background="{DynamicResource IndigoPanel}" BorderBrush="{DynamicResource Indigo}" BorderThickness="2">
    <StackPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Updates.IsInstalling, Converter={StaticResource Hidden}}">
          <Button Style="{StaticResource GhostButton}" Content="What's new" Command="{Binding Updates.ToggleNotesCommand}" Margin="0,0,6,0" Padding="10,4"
                  Visibility="{Binding Updates.BannerNotes, Converter={StaticResource VisibleIfSet}}"/>
          <Button Style="{StaticResource IndigoButton}" Command="{Binding Updates.InstallUpdateCommand}" Margin="0,0,6,0" Padding="16,7"
                  ToolTip="Downloads the new version, swaps it in and restarts the app (a few seconds)"
                  Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
              <TextBlock Text="Update now" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding Updates.CloseBannerCommand}" ToolTip="Close">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{StaticResource Muted}"/>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Indigo}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="{Binding Updates.BannerTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock Text="One click: it downloads, swaps itself and restarts in a few seconds. Your settings, characters and webhooks stay."
                       FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Visible}}"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="25,8,0,0"
                    Visibility="{Binding Updates.ShowNotes, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding Updates.BannerNotes}" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" LineHeight="19"/>
      </ScrollViewer>

      <!-- Updating: each step as it happens, the download with its progress. -->
      <StackPanel Margin="25,10,0,2" Visibility="{Binding Updates.IsInstalling, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding Updates.InstallSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:UpdateStepRow}">
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="&#xE9AE;" FontSize="11" Width="20" Foreground="{StaticResource Faint}"/>
                <TextBlock x:Name="Label" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="700"/>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="active">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE72C;"/>
                  <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Indigo}"/>
                  <Setter TargetName="Label" Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE73E;"/>
                  <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Green}"/>
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE711;"/>
                  <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Red}"/>
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Red}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="note">
                  <Setter TargetName="Mark" Property="Text" Value=""/>
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Muted}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
          <ProgressBar Width="260" Height="6" Minimum="0" Maximum="100" Value="{Binding Updates.DownloadPercent}"
                       Foreground="{DynamicResource Indigo}" Background="#33FFFFFF" BorderThickness="0"/>
          <TextBlock Text="{Binding Updates.DownloadText}" FontSize="11" Foreground="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="After the restart, the new version updates the addon in your game folders and shows what's new here."
                   FontSize="11" Foreground="{StaticResource Dim}" Margin="20,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
  </Border>
  <!-- Settings changed while the game runs: the addon only reads them on /reload or login. -->
  <Border Visibility="{Binding SelectedFlavor.ReloadNeeded, Converter={StaticResource Visible}}" Margin="0,0,0,14" Padding="16,10" CornerRadius="10"
          Background="{StaticResource AmberSoft}" BorderBrush="{StaticResource Amber}" BorderThickness="1">
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding SelectedFlavor.DismissReloadCommand}" ToolTip="Hide">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{StaticResource Muted}"/>
      </Button>
      <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Foreground="{StaticResource Amber}" FontSize="15" Margin="0,0,10,0"/>
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="White">
        <Run Text="Type" /> <Run Text="/reload" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" Foreground="{StaticResource Amber}"/> <Run Text="in game to use your new settings."/>
        <Run Text="Until then the game keeps the old ones for screenshots and instant posts." Foreground="{StaticResource TextSoft}" FontSize="12"/>
      </TextBlock>
    </DockPanel>
  </Border>
  <ItemsControl ItemsSource="{Binding SelectedFlavor.Steps}" Margin="0,0,0,18">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type vm:SetupItem}">
        <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,12,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Dot" Width="30" Height="30" CornerRadius="15" Background="{StaticResource GreenSoft}" Margin="0,0,12,0">
              <TextBlock x:Name="DotIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Green}"
                         FontSize="14" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
              <!-- Up to two lines, so narrow windows still show most of it; the rest is in the tooltip. -->
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32"
                         ToolTip="{Binding Detail}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource ButtonBase}" Content="{Binding ActionText}" Command="{Binding ActionCommand}" ToolTip="{Binding ActionTooltip}"
                    Visibility="{Binding ActionText, Converter={StaticResource VisibleIfSet}}" Margin="10,0,0,0" Padding="10,4"/>
          </Grid>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Ok}" Value="False">
            <Setter TargetName="Dot" Property="Background" Value="{StaticResource AmberSoft}"/>
            <Setter TargetName="DotIcon" Property="Text" Value="&#xE7BA;"/>
            <Setter TargetName="DotIcon" Property="Foreground" Value="{StaticResource Amber}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  </StackPanel>
</UserControl>
