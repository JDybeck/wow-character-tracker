<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the app's logic (parsing, formatting, links): dotnet test companion/WoWCharacterTracker.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The app is a self-contained exe; the tests only need its types. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WoWCharacterTracker\WoWCharacterTracker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="WoWCharacterTracker.Models" />
    <Using Include="WoWCharacterTracker.Services" />
    <Using Include="WoWCharacterTracker.ViewModels" />
  </ItemGroup>

</Project>
